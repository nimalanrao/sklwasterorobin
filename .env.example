# ==============================================================================
# SKL WASTE SDN BHD (Reg No: 200801038953) - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or set these environment variables in your hosting
# provider dashboard (e.g. Cloudflare Pages, Netlify, Vercel, or cPanel/Node).
# All variables below are optional and use safe fallbacks when unconfigured.
# ==============================================================================

# Canonical Production URL (used for sitemap, canonical links, and Open Graph)
PUBLIC_SITE_URL=https://www.sklwaste.com.my

# Google Search Console Verification Token
# Obtain from Google Search Console > Settings > Ownership verification > HTML tag
# Example: PUBLIC_GSC_VERIFICATION=abc123xyz_token_here
PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 (GA4) Measurement ID
# Obtain from Google Analytics Admin > Data Streams > Web Stream > Measurement ID
# Example: PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=

# Google Tag Manager (GTM) Container ID
# If using GTM, enter your container ID. GTM takes precedence over direct GA4 script loading.
# Example: PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_GTM_ID=

# Google Ads Conversion Tracking ID
# Obtain from Google Ads > Tools & Settings > Conversions
# Example: PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
PUBLIC_GOOGLE_ADS_ID=

# Google Ads Conversion Action Label
# Associated conversion label for lead generation events
# Example: PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=AbCdEfGhIjKlMnOpQrS
PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Webhook Endpoint for Quotation Enquiries
# Serverless endpoint / Zapier / Make / Cloudflare Worker / CRM webhook URL for automated lead ingestion.
# When left empty, customer enquiries dispatch via mailto client, clipboard copy, or direct phone call.
# Example: PUBLIC_QUOTATION_WEBHOOK_URL=https://api.yourdomain.com/webhooks/quotations
PUBLIC_QUOTATION_WEBHOOK_URL=

# Webhook Endpoint for Contact Enquiries
# Serverless endpoint / webhook URL for general contact inquiries.
# When left empty, customer enquiries dispatch via mailto client, clipboard copy, or direct phone call.
# Example: PUBLIC_CONTACT_WEBHOOK_URL=https://api.yourdomain.com/webhooks/contact
PUBLIC_CONTACT_WEBHOOK_URL=

# ==============================================================================
# System RORO — AI Image Auto Key-In Vision Keys (Optional — pick any ONE free tier)
# You can also paste any of these directly inside the System RORO "AI Scan" UI.
# ==============================================================================
# Option 1: Google Gemini 2.5 Flash Vision (Free key: https://aistudio.google.com/apikey)
PUBLIC_GEMINI_API_KEY=

# Option 2: Groq Llama-4-Scout Vision (Free key: https://console.groq.com/keys)
PUBLIC_GROQ_API_KEY=

# Option 3: OpenRouter Qwen2.5-VL Free Tier (Free key: https://openrouter.ai/keys)
PUBLIC_OPENROUTER_API_KEY=
