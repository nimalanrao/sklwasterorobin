---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import IndustryGrid from '../components/IndustryGrid.astro';
import VerificationNotice from '../components/VerificationNotice.astro';
import { companyData } from '../data/company';
import { contactData } from '../data/contact';
import { industriesData, industriesDisclaimer } from '../data/industries';
import { getPageSEO } from '../data/seo';

const currentPath = '/industries-we-serve';
const seo = getPageSEO(currentPath);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  currentPath={currentPath}
>
  <!-- Executive Page Hero -->
  <section class="page-hero section-surface">
    <div class="container">
      <Breadcrumb items={seo.breadcrumbs} />

      <div class="hero-split">
        <div class="hero-content">
          <div class="eyebrow">SEKTOR &amp; INDUSTRI KOMERSIAL</div>
          <h1 class="page-title">Industries We Serve <span class="title-sub">(Sektor Industri Yang Dilayani)</span></h1>
          
          <!-- Standalone BLUF Summary for AEO / GEO Extraction -->
          <p class="bluf-text">
            <strong>Ringkasan Eksekutif:</strong> {companyData.name} membekalkan perkhidmatan sewaan Tong Roro 2 Kaki dan 4 Kaki untuk 10 sektor komersial, industri, institusi, dan tapak binaan di sekitar Selangor. Setiap sewaan beroperasi pada tempoh standard 10 hari (10 days) berasaskan penilaian tapak langsung tanpa tuntutan portfolio pelanggan lepas.
          </p>

          <p class="lead-text">
            <strong>{companyData.name}</strong> (No. Pendaftaran: {companyData.registrationNumber}) beroperasi dari pangkalan {companyData.headquarters.city}, menyediakan kontena keluli tahan lasak dan pengangkutan lori berjadual mengikut profil sisa pepejal setiap premis perniagaan.
          </p>

          <div class="hero-trust-strip">
            <div class="trust-item">
              <span class="trust-metric">10</span>
              <span class="trust-label">Sektor Industri</span>
            </div>
            <div class="trust-item">
              <span class="trust-metric">10 days</span>
              <span class="trust-label">Tempoh Sewaan Standard</span>
            </div>
            <div class="trust-item">
              <span class="trust-metric">2 &amp; 4 Ft</span>
              <span class="trust-label">Saiz Tong Roro</span>
            </div>
            <div class="trust-item">
              <span class="trust-metric">Mr Hari</span>
              <span class="trust-label">Penyelarasan Terus</span>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="visual-card">
            <picture>
              <source srcset="/images/sewa-tong-roro-sungai-buloh-skl-waste.webp" type="image/webp" />
              <img
                src="/images/skl-hero-roro.jpg"
                alt="Lori Roro dan kontena sisa pepejal SKL Waste Sdn Bhd sedia untuk sektor industri dan pembinaan di Selangor"
                class="fleet-img"
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="visual-caption">
              <span class="caption-tag">Armada Logistik SKL Waste</span>
              <span class="caption-desc">Lori Roro hidraulik &amp; kontena sisa pepejal industri</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Strict Compliance Notice -->
  <section class="section" style="padding-top: 2rem; padding-bottom: 2rem;">
    <div class="container">
      <VerificationNotice
        type="pending"
        title="Pernyataan Pematuhan: Tiada Hubungan Pelanggan Sedia Ada Dituntut (Compliance Notice: No Fabricated Client Relationships)"
        message="SKL Waste Sdn Bhd menegaskan secara telus bahawa tiada sebarang hubungan pelanggan sedia ada, logo korporat pihak ketiga, testimoni pelanggan, atau rekod portfolio pelanggan lepas yang dituntut atau direka di laman web ini. Semua sektor industri yang disenaraikan adalah profil operasi di mana lori dan Tong Roro kami sesuai digunakan. Penyediaan perkhidmatan adalah berasaskan kapasiti operasi dan tertakluk kepada pengesahan ketersediaan perkhidmatan secara langsung."
      />
    </div>
  </section>

  <!-- Main Industry Grid Component -->
  <section class="section" id="industry-sectors">
    <div class="container">
      <div class="section-header reveal-on-scroll">
        <div class="eyebrow">KAPASITI OPERASI</div>
        <h2>10 Sektor Industri Pilihan (10 Key Industry Sectors)</h2>
        <p class="section-desc">
          Setiap sektor komersial memerlukan konfigurasi pengurusan sisa yang berbeza. Teliti profil operasi Tong Roro 2 Kaki dan 4 Kaki berikut:
        </p>
      </div>

      <div class="reveal-on-scroll">
        <IndustryGrid industries={industriesData} />
      </div>
    </div>
  </section>

  <!-- Detailed Sector Guidance with Natural Internal Links -->
  <section class="section section-surface" id="sector-guidance">
    <div class="container">
      <div class="section-header reveal-on-scroll">
        <div class="eyebrow">PANDUAN OPERASI SEKTOR</div>
        <h2>Panduan Pengendalian Sisa Mengikut Sektor (Sector Guidance)</h2>
        <p class="section-desc">
          Panduan praktikal penentuan jenis sisa dan cadangan saiz Tong Roro bagi mematuhi garis panduan PBT dan keselamatan persekitaran:
        </p>
      </div>

      <div class="guidance-grid reveal-on-scroll">
        <div class="card guidance-card">
          <div class="card-header">
            <span class="sector-num">01</span>
            <h3>Resorts and hotels</h3>
          </div>
          <div class="card-body">
            <p><strong>Ciri-ciri sisa:</strong> Perabot lama bilik penginapan, sisa cantasan landskap pokok renek, tilam terpakai, dan karton pembungkusan pukal.</p>
            <p><strong>Cadangan Tong:</strong> <a href="/tong-roro-rental#tong-roro-4-feet" class="sector-link">Tong Roro 4 Kaki</a> amat sesuai untuk sisa volumetrik perabot dan dahan pokok. Rujuk perkhidmatan <a href="/waste-management-services" class="sector-link">kutipan sampah pukal</a> kami.</p>
          </div>
        </div>

        <div class="card guidance-card">
          <div class="card-header">
            <span class="sector-num">02</span>
            <h3>Factories and warehouses</h3>
          </div>
          <div class="card-body">
            <p><strong>Ciri-ciri sisa:</strong> Palet kayu terpakai, plastik pembalut kargo industri (shrink wrap), kotak kadbod bervolum tinggi, dan sisa mekanikal kering bukan berjadual.</p>
            <p><strong>Cadangan Tong:</strong> <a href="/tong-roro-rental#tong-roro-4-feet" class="sector-link">Tong Roro 4 Kaki</a> untuk sisa pembungkusan gudang. Untuk maklumat klasifikasi, layari panduan <a href="/waste-management-services" class="sector-link">sisa perindustrian</a>.</p>
          </div>
        </div>

        <div class="card guidance-card">
          <div class="card-header">
            <span class="sector-num">03</span>
            <h3>Colleges and universities</h3>
          </div>
          <div class="card-body">
            <p><strong>Ciri-ciri sisa:</strong> Pembersihan kolej kediaman / asrama semester, pelupusan kerusi kuliah rosak, kertas arkib lapuk, dan pemangkasan pokok kampus.</p>
            <p><strong>Cadangan Tong:</strong> <a href="/tong-roro-rental#tong-roro-4-feet" class="sector-link">Tong Roro 4 Kaki</a> bagi pelupusan sisa pukal berkala waktu cuti. Selaraskan melalui <a href="/waste-management-services" class="sector-link">kutipan sampah institusi</a>.</p>
          </div>
        </div>

        <div class="card guidance-card">
          <div class="card-header">
            <span class="sector-num">04</span>
            <h3>Shopping centres</h3>
          </div>
          <div class="card-body">
            <p><strong>Ciri-ciri sisa:</strong> Debris kerja penukaran penyewa unit kedai (retail fit-out/de-fit), papan dinding plaster (drywall), rak pameran kayu, dan kotak stok peruncitan.</p>
            <p><strong>Cadangan Tong:</strong> <a href="/tong-roro-rental#tong-roro-4-feet" class="sector-link">Tong Roro 4 Kaki</a> dengan penempatan di loading bay. Lihat perkhidmatan <a href="/waste-management-services" class="sector-link">sisa pengubahsuaian komersial</a>.</p>
          </div>
        </div>

        <div class="card guidance-card">
          <div class="card-header">
            <span class="sector-num">05</span>
            <h3>Building construction</h3>
          </div>
          <div class="card-body">
            <p><strong>Ciri-ciri sisa:</strong> Konkrit pecah, bata simen, runtuhan dinding, lebihan acuan kayu (formwork), dan besi pengukuh bukan berjadual.</p>
            <p><strong>Cadangan Tong:</strong> <a href="/tong-roro-rental#tong-roro-2-feet" class="sector-link">Tong Roro 2 Kaki (berat muatan tinggi)</a> disyorkan khas untuk konkrit berat bagi mengelakkan lebihan muatan. Maklumat lanjut di <a href="/waste-management-services" class="sector-link">sisa pembinaan</a>.</p>
          </div>
        </div>

        <div class="card guidance-card">
          <div class="card-header">
            <span class="sector-num">06</span>
            <h3>House construction</h3>
          </div>
          <div class="card-body">
            <p><strong>Ciri-ciri sisa:</strong> Pengubahsuaian rumah teres / banglo, sambungan dapur, gantian jubin bilik air, genting bumbung lama, dan plaster siling.</p>
            <p><strong>Cadangan Tong:</strong> <a href="/tong-roro-rental#tong-roro-2-feet" class="sector-link">Tong Roro 2 Kaki</a> untuk batu dan jubin; 4 Kaki untuk sisa bumbung. Lihat perkhidmatan <a href="/waste-management-services" class="sector-link">sisa pengubahsuaian kediaman</a>.</p>
          </div>
        </div>

        <div class="card guidance-card">
          <div class="card-header">
            <span class="sector-num">07</span>
            <h3>Hospitals</h3>
          </div>
          <div class="card-body">
            <p><strong>Ciri-ciri sisa:</strong> Sisa am bukan klinikal (non-clinical dry waste), pengubahsuaian ruang pejabat pentadbiran, perabot pentadbiran usang, dan sisa taman landskap hospital.</p>
            <p><strong>Cadangan Tong:</strong> <a href="/tong-roro-rental#tong-roro-4-feet" class="sector-link">Tong Roro 4 Kaki</a> untuk sisa pentadbiran bukan bio-bahaya. Sisa klinikal dan picagari dilarang sama sekali.</p>
          </div>
        </div>

        <div class="card guidance-card">
          <div class="card-header">
            <span class="sector-num">08</span>
            <h3>Offices</h3>
          </div>
          <div class="card-body">
            <p><strong>Ciri-ciri sisa:</strong> Pelupusan perpindahan pejabat (office relocation), permaidani lapuk, panel sekatan pejabat (partition panels), kabinet fail, dan kerusi rosak.</p>
            <p><strong>Cadangan Tong:</strong> <a href="/tong-roro-rental#tong-roro-4-feet" class="sector-link">Tong Roro 4 Kaki</a> untuk perabot pejabat. Dapatkan bantuan melalui perkhidmatan <a href="/waste-management-services" class="sector-link">pelupusan sampah pukal</a>.</p>
          </div>
        </div>

        <div class="card guidance-card">
          <div class="card-header">
            <span class="sector-num">09</span>
            <h3>Food and beverage industries</h3>
          </div>
          <div class="card-body">
            <p><strong>Ciri-ciri sisa:</strong> Karton pembungkusan kering, peti kayu, sisa pengubahsuaian ruang makan / dapur komersial, dan peralatan dapur logam terpakai.</p>
            <p><strong>Cadangan Tong:</strong> <a href="/tong-roro-rental#tong-roro-4-feet" class="sector-link">Tong Roro 4 Kaki</a> untuk karton kering. Sisa makanan basah berbau (wet putrescible food waste) tidak dibenarkan di dalam Tong Roro terbuka.</p>
          </div>
        </div>

        <div class="card guidance-card">
          <div class="card-header">
            <span class="sector-num">10</span>
            <h3>Condominiums and apartments</h3>
          </div>
          <div class="card-body">
            <p><strong>Ciri-ciri sisa:</strong> Pelupusan sisa pukal penduduk (sofa, tilam terbuang), kerja pengubahsuaian petak strata, dan pembersihan landskap kawasan bersama (JMB/MC).</p>
            <p><strong>Cadangan Tong:</strong> <a href="/tong-roro-rental#tong-roro-4-feet" class="sector-link">Tong Roro 4 Kaki</a> sangat praktikal untuk pembersihan berkala JMB/MC. Semak syarat di <a href="/waste-management-services" class="sector-link">pengangkutan dan kutipan sampah</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Operational Terms & Sizing Matrix -->
  <section class="section" id="operational-terms">
    <div class="container">
      <div class="card terms-card reveal-on-scroll">
        <div class="terms-header">
          <span class="eyebrow" style="margin-bottom: 0.25rem;">SYARAT OPERASI</span>
          <h2>Ketetapan Perkhidmatan Sewaan Tong Roro</h2>
        </div>
        <div class="terms-grid">
          <div class="terms-item">
            <div class="terms-badge">Tempoh Sewaan</div>
            <p>Semua sewaan Tong Roro disediakan untuk tempoh standard <strong>10 days</strong> (Tempoh sewaan 10 hari).</p>
          </div>
          <div class="terms-item">
            <div class="terms-badge">Anggaran Kadar Provisianal</div>
            <p>Kadar provisianal adalah <strong>RM2XX</strong> untuk Tong Roro 2 Kaki dan <strong>RM3XX–RM4XX</strong> untuk Tong Roro 4 Kaki.</p>
          </div>
          <div class="terms-item">
            <div class="terms-badge">Caj Penghantaran &amp; Kutipan</div>
            <p>Caj penghantaran dan kutipan belum disahkan dan tidak termasuk dalam anggaran kasar harga tong.</p>
          </div>
          <div class="terms-item">
            <div class="terms-badge">Sisa Dilarang</div>
            <p>Bahan kimia cecair, bahan toksik, sisa klinikal, dan sisa berjadual di bawah JAS dilarang sama sekali.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Executive CTA Section -->
  <section class="section section-dark" id="request-quotation-cta">
    <div class="container">
      <div class="cta-inner reveal-on-scroll">
        <div class="eyebrow" style="background: rgba(255, 255, 255, 0.12); color: #86efac;">HUBUNGI PEGAWAI OPERASI</div>
        <h2 class="cta-title">Dapatkan Sebut Harga Khusus Sektor Anda</h2>
        <p class="cta-subtitle">
          Sila hubungi pegawai utama kami, <strong>{contactData.mainContactPerson}</strong>, untuk menilai keperluan tapak projek anda, mengesahkan jadual armada lori, dan menyediakan sebut harga rasmi tanpa sebarang kos tersembunyi.
        </p>

        <div class="cta-buttons">
          <a href={contactData.telephoneHref} class="btn btn-primary cta-btn">
            Hubungi Mr Hari ({contactData.telephoneDisplay})
          </a>
          <a href="/contact-us#quotation-form" class="btn btn-secondary cta-btn" style="border-color: rgba(255, 255, 255, 0.3); color: #ffffff;">
            Borang Permintaan Sebut Harga
          </a>
          <a href={contactData.emailHref} class="btn btn-secondary cta-btn" style="border-color: rgba(255, 255, 255, 0.3); color: #ffffff;">
            E-mel: {contactData.email}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(2rem, 3vw, 3rem);
    border-bottom: 1px solid var(--border-subtle, #e2e8f0);
  }
  .hero-split {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    margin-top: 1rem;
  }
  .page-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    line-height: 1.15;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary, #0a1628);
  }
  .title-sub {
    display: block;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    color: var(--text-secondary, #475569);
    font-weight: 500;
    margin-top: 0.35rem;
  }
  .bluf-text {
    font-size: 0.95rem;
    color: var(--text-primary, #0a1628);
    background: var(--accent-green-soft, #f0fdf4);
    border-left: 3px solid var(--accent-green, #15803d);
    padding: 0.75rem 1rem;
    border-radius: 0 var(--radius-sm, 6px) var(--radius-sm, 6px) 0;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .lead-text {
    font-size: clamp(1rem, 1.15vw, 1.15rem);
    color: var(--text-secondary, #475569);
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }
  .hero-trust-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    border-top: 1px solid var(--border-subtle, #e2e8f0);
    padding-top: 1.25rem;
  }
  .trust-item {
    display: flex;
    flex-direction: column;
  }
  .trust-metric {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent-green, #15803d);
  }
  .trust-label {
    font-size: 0.75rem;
    color: var(--text-muted, #64748b);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
  }
  .hero-visual {
    width: 100%;
  }
  .visual-card {
    background: #ffffff;
    border-radius: var(--radius-lg, 20px);
    border: 1px solid var(--border-subtle, #e2e8f0);
    box-shadow: var(--shadow-card, 0 4px 20px -2px rgba(10, 22, 40, 0.05));
    overflow: hidden;
  }
  .fleet-img {
    width: 100%;
    height: clamp(220px, 25vw, 300px);
    object-fit: cover;
    display: block;
  }
  .visual-caption {
    padding: 0.85rem 1.25rem;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .caption-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-green, #15803d);
    letter-spacing: 0.05em;
  }
  .caption-desc {
    font-size: 0.875rem;
    color: var(--text-secondary, #475569);
  }
  .section-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 2.5rem;
  }
  .section-header h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.35rem);
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .section-desc {
    font-size: 1.05rem;
    color: var(--text-secondary, #475569);
    line-height: 1.6;
    margin-bottom: 0;
  }
  .guidance-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .guidance-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle, #e2e8f0);
    border-radius: var(--radius-md, 12px);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .guidance-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-hover, #cbd5e1);
    box-shadow: var(--shadow-card-hover, 0 10px 25px -5px rgba(10, 22, 40, 0.08));
  }
  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle, #e2e8f0);
    padding-bottom: 0.75rem;
  }
  .sector-num {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-green, #15803d);
    background: var(--accent-green-soft, #f0fdf4);
    border: 1px solid var(--accent-green-border, #bbf7d0);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full, 9999px);
  }
  .card-header h3 {
    margin: 0;
    font-size: 1.15rem;
    color: var(--text-primary, #0a1628);
  }
  .card-body p {
    font-size: 0.925rem;
    color: var(--text-secondary, #475569);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .card-body p:last-child {
    margin-bottom: 0;
  }
  .sector-link {
    color: var(--accent-green, #15803d);
    font-weight: 600;
    text-decoration: underline;
  }
  .terms-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle, #e2e8f0);
    border-radius: var(--radius-lg, 20px);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: var(--shadow-card, 0 4px 20px -2px rgba(10, 22, 40, 0.05));
  }
  .terms-header h2 {
    font-size: 1.35rem;
    color: var(--text-primary, #0a1628);
    margin-top: 0.25rem;
    margin-bottom: 1.5rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .terms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .terms-item {
    background: var(--bg-surface, #f8fafc);
    border: 1px solid var(--border-subtle, #e2e8f0);
    border-radius: var(--radius-md, 12px);
    padding: 1.25rem;
  }
  .terms-badge {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-primary, #0a1628);
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }
  .terms-item p {
    font-size: 0.925rem;
    color: var(--text-secondary, #475569);
    line-height: 1.55;
    margin: 0;
  }
  .cta-inner {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }
  .cta-title {
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    color: #ffffff;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .cta-subtitle {
    font-size: 1.1rem;
    color: #cbd5e1;
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cta-btn {
    padding: 0.85rem 1.75rem;
    font-size: 1rem;
  }

  /* Responsive Rules */
