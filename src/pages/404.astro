---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyData } from '../data/company';
import { contactData } from '../data/contact';
import { getPageSEO } from '../data/seo';

const seo = getPageSEO('/404');
---

<BaseLayout 
  title={seo.title}
  description={seo.description}
  currentPath="/404"
  noindex={true}
>
  <div class="section-surface" style="min-height: calc(100vh - 200px); display: flex; align-items: center; padding: clamp(3rem, 6vw, 6rem) 0;">
    <div class="container" style="max-width: 780px; margin: 0 auto; text-align: center;">
      
      <!-- Logo Branding Header with Modern WebP Picture Element -->
      <div class="reveal-on-scroll" style="margin-bottom: 2rem; display: inline-flex; flex-direction: column; align-items: center; gap: 0.75rem;">
        <div style="background: #ffffff; padding: 0.75rem 1.25rem; border-radius: var(--radius-md, 12px); box-shadow: var(--shadow-card, 0 4px 20px -2px rgba(10, 22, 40, 0.05)); border: 1px solid var(--border-subtle, #e2e8f0); display: inline-flex; align-items: center; gap: 0.75rem;">
          <picture>
            <source srcset="/images/logo-skl-waste-sdn-bhd.webp" type="image/webp" />
            <img 
              src="/images/skl-logo.png" 
              alt="SKL Waste Sdn Bhd Logo" 
              width="44" 
              height="44" 
              loading="eager"
              decoding="async"
              style="width: 44px; height: 44px; object-fit: contain;"
            />
          </picture>
          <div style="text-align: left;">
            <div style="font-weight: 800; font-size: 0.9375rem; letter-spacing: -0.01em; color: var(--text-primary, #0a1628);">
              SKL WASTE SDN BHD
            </div>
            <div style="font-size: 0.75rem; color: var(--text-muted, #64748b);">
              No. Pendaftaran: 200801038953
            </div>
          </div>
        </div>

        <div class="eyebrow" style="background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.8125rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.4rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span>Ralat 404 &bull; Halaman Tidak Wujud</span>
        </div>
      </div>

      <!-- Main Message Card -->
      <div class="card reveal-on-scroll" style="background: #ffffff; border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-lg, 20px); box-shadow: var(--shadow-card, 0 4px 20px -2px rgba(10, 22, 40, 0.05)); padding: clamp(2rem, 5vw, 3.25rem); margin-bottom: 2rem;">
        
        <div style="font-size: clamp(3.5rem, 8vw, 5.5rem); font-weight: 900; line-height: 1; letter-spacing: -0.04em; color: var(--text-primary, #0a1628); margin-bottom: 0.75rem;">
          404
        </div>

        <h1 style="font-size: clamp(1.4rem, 3vw, 1.85rem); font-weight: 800; color: var(--text-primary, #0a1628); margin-top: 0; margin-bottom: 0.75rem; border: none; padding: 0;">
          {seo.h1}
        </h1>

        <p style="font-size: clamp(0.95rem, 1.8vw, 1.05rem); color: var(--text-secondary, #475569); line-height: 1.6; max-width: 52ch; margin: 0 auto 2rem auto;">
          Halaman yang anda cari mungkin telah dipindahkan, dipadamkan, atau alamat URL yang ditaip tidak lengkap. Sila gunakan navigasi pantas di bawah untuk meneruskan urusan anda.
        </p>

        <!-- Quick Action Nav Cards -->
        <div style="text-align: left; margin-bottom: 2.25rem;">
          <div style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted, #64748b); margin-bottom: 0.75rem; text-align: center;">
            Pautan Pintas Utama (Quick Directory)
          </div>
          
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem;">
            <a href="/" class="card" style="padding: 0.875rem 1rem; border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px); text-decoration: none; display: flex; align-items: center; gap: 0.75rem; background: var(--bg-surface, #f8fafc); transition: all 0.2s ease;">
              <span style="font-size: 1.25rem;">🏠</span>
              <div>
                <strong style="display: block; color: var(--text-primary, #0a1628); font-size: 0.9rem;">Laman Utama</strong>
                <span style="font-size: 0.75rem; color: var(--text-muted, #64748b);">Kembali ke halaman utama</span>
              </div>
            </a>

            <a href="/tong-roro-rental" class="card" style="padding: 0.875rem 1rem; border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px); text-decoration: none; display: flex; align-items: center; gap: 0.75rem; background: var(--bg-surface, #f8fafc); transition: all 0.2s ease;">
              <span style="font-size: 1.25rem;">🗑️</span>
              <div>
                <strong style="display: block; color: var(--text-primary, #0a1628); font-size: 0.9rem;">Sewaan Tong Roro</strong>
                <span style="font-size: 0.75rem; color: var(--text-muted, #64748b);">Saiz 2 Kaki &amp; 4 Kaki</span>
              </div>
            </a>

            <a href="/waste-management-services" class="card" style="padding: 0.875rem 1rem; border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px); text-decoration: none; display: flex; align-items: center; gap: 0.75rem; background: var(--bg-surface, #f8fafc); transition: all 0.2s ease;">
              <span style="font-size: 1.25rem;">🚛</span>
              <div>
                <strong style="display: block; color: var(--text-primary, #0a1628); font-size: 0.9rem;">Pengurusan Sisa</strong>
                <span style="font-size: 0.75rem; color: var(--text-muted, #64748b);">Sisa binaan &amp; pelupusan</span>
              </div>
            </a>

            <a href="/service-areas" class="card" style="padding: 0.875rem 1rem; border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px); text-decoration: none; display: flex; align-items: center; gap: 0.75rem; background: var(--bg-surface, #f8fafc); transition: all 0.2s ease;">
              <span style="font-size: 1.25rem;">📍</span>
              <div>
                <strong style="display: block; color: var(--text-primary, #0a1628); font-size: 0.9rem;">Kawasan Liputan</strong>
                <span style="font-size: 0.75rem; color: var(--text-muted, #64748b);">13 Zon Selangor / KL</span>
              </div>
            </a>

            <a href="/contact-us" class="card" style="padding: 0.875rem 1rem; border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px); text-decoration: none; display: flex; align-items: center; gap: 0.75rem; background: var(--bg-surface, #f8fafc); transition: all 0.2s ease; grid-column: 1 / -1;">
              <span style="font-size: 1.25rem;">📞</span>
              <div>
                <strong style="display: block; color: var(--text-primary, #0a1628); font-size: 0.9rem;">Hubungi Kami (Contact Us)</strong>
                <span style="font-size: 0.75rem; color: var(--text-muted, #64748b);">Borang pertanyaan dan permohonan sebut harga rasmi</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Direct Contact Assistance Box -->
        <div style="background: var(--bg-dark, #0a1628); color: #ffffff; border-radius: var(--radius-md, 12px); padding: 1.5rem; text-align: left;">
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div style="font-size: 0.8125rem; font-weight: 700; color: #86efac; text-transform: uppercase; letter-spacing: 0.04em;">
              Bantuan Langsung / Direct Dispatch
            </div>
            <div style="font-weight: 700; font-size: 1.1rem; color: #ffffff;">
              Perlukan Bantuan Segera? Hubungi Mr Hari
            </div>
            <p style="font-size: 0.875rem; color: #cbd5e1; line-height: 1.5; margin: 0;">
              Wakil operasi <strong>SKL WASTE SDN BHD</strong> sedia membantu urusan semakan saiz tong Roro, tarikh penghantaran dan ketersediaan kawasan tapak anda.
            </p>
            
            <div style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 0.875rem; font-size: 0.8125rem; color: #e2e8f0; line-height: 1.5;">
              <div><strong>Entiti:</strong> SKL WASTE SDN BHD (No. Pendaftaran: 200801038953)</div>
              <div><strong>Pegawai:</strong> Mr Hari</div>
              <div><strong>Alamat:</strong> PT 31127 SETOR JALAN KUALA SELANGOR, 47000 SUNGAI BULOH, SELANGOR DARUL EHSAN, MALAYSIA.</div>
            </div>

            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.25rem;">
              <a href="tel:+60166159365" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1.25rem; text-decoration: none; font-size: 0.875rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span>Telefon: +60 16-615 9365</span>
              </a>
              <a href="mailto:tongroroservissklwaste@gmail.com" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1.25rem; text-decoration: none; font-size: 0.875rem; background: rgba(255, 255, 255, 0.1); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.2);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <span>E-mel: tongroroservissklwaste@gmail.com</span>
              </a>
            </div>
          </div>
        </div>

      </div>

      <div style="font-size: 0.8125rem; color: var(--text-muted, #64748b);">
        &copy; {new Date().getFullYear()} SKL WASTE SDN BHD (200801038953) &bull; PT 31127 SETOR JALAN KUALA SELANGOR, 47000 SUNGAI BULOH, SELANGOR DARUL EHSAN, MALAYSIA.
      </div>

    </div>
  </div>
</BaseLayout>
