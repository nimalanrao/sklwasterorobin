---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyData } from '../data/company';
import { contactData } from '../data/contact';
import { productsData } from '../data/products';
import { secondaryServices } from '../data/services';
import { serviceAreasData } from '../data/serviceAreas';
import { industriesData } from '../data/industries';
import { getPageSEO } from '../data/seo';

const seo = getPageSEO('/');

const suppliedSectors = [
  {
    id: 'resorts-hotels',
    image: '/images/industries/resorts-hotels.jpg',
    labelMs: 'RESORTS & HOTELS',
    labelEn: 'RESORTS & HOTELS',
    subMs: 'Resort & Hotel Peranginan',
    subEn: 'Hospitality & Resort Complexes'
  },
  {
    id: 'kilang-gudang',
    image: '/images/industries/kilang-gudang.jpg',
    labelMs: 'KILANG & GUDANG',
    labelEn: 'FACTORIES & WAREHOUSES',
    subMs: 'Kawasan Perindustrian & Logistik',
    subEn: 'Industrial Manufacturing & Storage'
  },
  {
    id: 'kolej-universiti',
    image: '/images/industries/kolej-universiti.jpg',
    labelMs: 'KOLEJ & UNIVERSITI',
    labelEn: 'COLLEGES & UNIVERSITIES',
    subMs: 'Kampus Pendidikan & Institusi',
    subEn: 'Educational Campuses & Institutions'
  },
  {
    id: 'pusat-beli-belah',
    image: '/images/industries/pusat-beli-belah.jpg',
    labelMs: 'PUSAT BELI BELAH',
    labelEn: 'SHOPPING CENTRES',
    subMs: 'Kompleks Komersial & Runcit',
    subEn: 'Retail Malls & Commercial Hubs'
  },
  {
    id: 'theme-park',
    image: '/images/industries/theme-park.jpg',
    labelMs: 'THEME PARK',
    labelEn: 'THEME PARK',
    subMs: 'Taman Tema & Pusat Rekreasi',
    subEn: 'Theme Parks & Leisure Venues'
  },
  {
    id: 'building-construction',
    image: '/images/industries/building-construction.jpg',
    labelMs: 'BUILDING CONSTRUCTION',
    labelEn: 'BUILDING CONSTRUCTION',
    subMs: 'Tapak Pembinaan Bangunan Komersial',
    subEn: 'High-Rise & Structural Construction'
  },
  {
    id: 'house-construction',
    image: '/images/industries/house-construction.jpg',
    labelMs: 'HOUSE CONSTRUCTION',
    labelEn: 'HOUSE CONSTRUCTION',
    subMs: 'Pembinaan & Ubah Suai Kediaman',
    subEn: 'Residential Building & Renovation'
  },
  {
    id: 'hospital',
    image: '/images/industries/hospital.jpg',
    labelMs: 'HOSPITAL',
    labelEn: 'HOSPITAL',
    subMs: 'Pusat Perubatan & Kesihatan',
    subEn: 'Healthcare Facilities & Medical Centres'
  },
  {
    id: 'office',
    image: '/images/industries/office.jpg',
    labelMs: 'OFFICE',
    labelEn: 'OFFICE',
    subMs: 'Bangunan Pejabat & Korporat',
    subEn: 'Corporate Towers & Office Suites'
  },
  {
    id: 'food-beverage',
    image: '/images/industries/food-beverage.jpg',
    labelMs: 'FOOD & BEVERAGE INDUSTRIES',
    labelEn: 'FOOD & BEVERAGE INDUSTRIES',
    subMs: 'Kilang Pemprosesan Makanan & Restoran',
    subEn: 'F&B Processing & Commercial Kitchens'
  },
  {
    id: 'condominium-apartment',
    image: '/images/industries/condominium-apartment.jpg',
    labelMs: 'CONDOMINIUM & APARTMENT',
    labelEn: 'CONDOMINIUM & APARTMENT',
    subMs: 'Kediaman Bertingkat & Pengurusan JMB',
    subEn: 'High-Rise Residential & Strata Management'
  }
];
---

<BaseLayout title={seo.title} description={seo.description} currentPath="/" hideFooter={true}>
  <!-- 1. Full-Screen Hero Page -->
  <section class="hero-fullscreen" id="hero">
    <!-- Background Hero Image -->
    <picture class="hero-bg-picture">
      <source srcset="/images/sewa-tong-roro-sungai-buloh-skl-waste.webp" type="image/webp" />
      <img
        src="/images/skl-hero-roro.jpg"
        alt="Lori Roro dan Tong Roro SKL Waste Sdn Bhd di Sungai Buloh, Selangor"
        class="hero-bg-img"
        width="1280"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>

    <!-- Blurred Fade Background with White Opacity -->
    <div class="hero-white-blur-fade" aria-hidden="true"></div>
    <div class="hero-bottom-blur-bridge" aria-hidden="true"></div>

    <!-- Left Content Container (Human-Visible Copy) -->
    <div class="hero-main-container">
      <div class="hero-info-block">
        <h1
          class="hero-main-title"
          data-ms="Pengurusan Sisa Lebih Mudah."
          data-en="Waste Management Made Easy."
        >
          Pengurusan Sisa Lebih Mudah.
        </h1>

        <p
          class="hero-sub-info"
          data-ms="Perkhidmatan sewaan Tong Roro, kutipan, pengangkutan dan pelupusan sisa yang dipercayai untuk kediaman, premis perniagaan dan tapak pembinaan di Sungai Buloh serta seluruh Selangor."
          data-en="Reliable RORO bin rental, waste collection, transportation and disposal services for residential, commercial and construction projects across Sungai Buloh and Selangor."
        >
          Perkhidmatan sewaan Tong Roro, kutipan, pengangkutan dan pelupusan sisa yang dipercayai untuk kediaman, premis perniagaan dan tapak pembinaan di Sungai Buloh serta seluruh Selangor.
        </p>

        <p
          class="hero-cta-prompt"
          data-ms="Ingin membuat tempahan? Klik butang di bawah untuk membuat pesanan melalui WhatsApp."
          data-en="Ready to get started? Click below to place your order via WhatsApp."
        >
          Ingin membuat tempahan? Klik butang di bawah untuk membuat pesanan melalui WhatsApp.
        </p>

        <!-- WhatsApp Pill CTA -->
        <div class="hero-cta-wrapper">
          <a
            href="https://wa.me/60166159365?text=Hai%20Mr%20Hari%20(SKL%20Waste%20Sdn%20Bhd)%2C%20saya%20ingin%20menempah%20Tong%20Roro."
            class="hero-whatsapp-btn"
            data-track-cta="hero_whatsapp"
            aria-label="Hubungi melalui WhatsApp"
          >
            <svg
              class="whatsapp-icon"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"/>
            </svg>
            <span data-ms="WHATSAPP" data-en="WHATSAPP">WHATSAPP</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Visually Hidden SEO & Crawler Context (Visible to Robots/Scrapers Only) -->
    <div class="crawler-seo-content">
      <h2>SEWA TONG RORO. PENGURUSAN SISA LEBIH MUDAH. / TONG RORO RENTAL. WASTE MANAGEMENT MADE SIMPLE.</h2>
      <p>
        Perkhidmatan sewaan Tong Roro (2 Kaki &amp; 4 Kaki), kutipan sampah, pengangkutan dan pelupusan sisa untuk kediaman, komersial, pembinaan dan industri di Sungai Buloh &amp; Selangor.
        Tong Roro bin rental (2 Feet &amp; 4 Feet), waste collection, transport, and disposal services for residential, commercial, construction, and industrial sites in Sungai Buloh &amp; Selangor.
      </p>
      <p>
        SKL WASTE SDN BHD (200801038953) • Tempoh Sewaan 10 Hari (10-Day Rental) • RM2XX (2 Kaki / 2 Feet) / RM3XX–RM4XX (4 Kaki / 4 Feet) • Mr Hari: +60 16-615 9365
      </p>
      <h2>{companyData.name} ({companyData.registrationNumber}) - Sewaan Tong Roro Selangor &amp; Sungai Buloh</h2>
      <p>
        Ibu Pejabat: {companyData.headquarters.fullAddress}. Pegawai Dihubungi: {contactData.mainContactPerson} ({contactData.telephoneDisplay}, {contactData.email}).
      </p>
      <ul>
        <li><a href="/tong-roro-rental">Tong Roro Rental (Sewa Tong Roro 2 Feet RM2XX &amp; 4 Feet RM3XX–RM4XX - 10 Days)</a></li>
        <li><a href="/waste-management-services">Waste Management Services (Perkhidmatan Pengurusan &amp; Pelupusan Sisa)</a></li>
        <li><a href="/industries-we-serve">Industries We Serve (Sektor Industri, Pembinaan &amp; Komersial)</a></li>
        <li><a href="/service-areas">Service Areas (Kawasan Liputan Sungai Buloh, Rawang, Puncak Alam &amp; Selangor)</a></li>
        <li><a href="/contact-us">Contact Us (Hubungi Mr Hari +60 16-615 9365)</a></li>
        <li><a href="/about-us">About Us (Tentang SKL Waste Sdn Bhd)</a></li>
        <li><a href="/privacy-policy">Privacy Policy (Dasar Privasi)</a></li>
      </ul>
      <ul>
        {productsData.map((p) => (
          <li>{p.name} ({p.sizeLabel}): {p.priceDisplay} ({p.rentalDuration})</li>
        ))}
      </ul>
      <ul>
        {secondaryServices.map((s) => (
          <li>{s.name} ({s.nameEn})</li>
        ))}
      </ul>
      <ul>
        {serviceAreasData.map((a) => (
          <li>{a.name} - {a.region} ({a.statusLabel})</li>
        ))}
      </ul>
      <ul>
        {industriesData.map((ind) => (
          <li>{ind.name} ({ind.nameMs})</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2. Where We Supply Section (Scraped Industry Visuals with Blur-Fade Animations) -->
  <section class="supply-sectors-section" id="where-we-supply">
    <div class="supply-container">
      <div class="supply-header blur-fade-item">
        <span
          class="supply-eyebrow"
          data-ms="SEKTOR BEKALAN KAMI"
          data-en="WHERE WE SUPPLY"
        >
          SEKTOR BEKALAN KAMI
        </span>
        <h2
          class="supply-title"
          data-ms="Lokasi & Industri Yang Kami Bekalkan"
          data-en="Industries & Sectors We Supply"
        >
          Lokasi &amp; Industri Yang Kami Bekalkan
        </h2>
        <p
          class="supply-subtitle"
          data-ms="Kami membekalkan Tong Roro dan perkhidmatan pengurusan sisa merentasi pelbagai sektor komersial, perindustrian, institusi dan kediaman."
          data-en="We supply RORO bins and reliable waste management solutions across commercial, industrial, institutional and residential sectors."
        >
          Kami membekalkan Tong Roro dan perkhidmatan pengurusan sisa merentasi pelbagai sektor komersial, perindustrian, institusi dan kediaman.
        </p>
      </div>

      <div class="supply-grid">
        {suppliedSectors.map((sector, index) => (
          <article
            class="supply-card blur-fade-item"
            style={`--stagger-delay: ${(index % 4) * 90}ms;`}
          >
            <div class="supply-card-media">
              <img
                src={sector.image}
                alt={`${sector.labelMs} - SKL Waste Sdn Bhd Tong Roro`}
                class="supply-card-img"
                width="640"
                height="420"
                loading="lazy"
                decoding="async"
              />
              <div class="supply-card-blur-fade" aria-hidden="true"></div>
              <div class="supply-card-overlay">
                <h3
                  class="supply-card-title"
                  data-ms={sector.labelMs}
                  data-en={sector.labelEn}
                >
                  {sector.labelMs}
                </h3>
                <p
                  class="supply-card-sub"
                  data-ms={sector.subMs}
                  data-en={sector.subEn}
                >
                  {sector.subMs}
                </p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function() {
    var blurItems = document.querySelectorAll('.blur-fade-item');
    if ('IntersectionObserver' in window) {
      var blurObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in-view');
            blurObserver.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      });

      blurItems.forEach(function(item) {
        blurObserver.observe(item);
      });
    } else {
      blurItems.forEach(function(item) {
        item.classList.add('is-in-view');
      });
    }
  })();
</script>

<style>
  .hero-fullscreen {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #f8fafc;
    padding: 7.5rem 1.5rem 4.5rem;
  }

  .hero-bg-picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    display: block;
  }

  /* Blurred Fade Background with White Opacity (Left-to-Right Fade) */
  .hero-white-blur-fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.96) 0%,
      rgba(255, 255, 255, 0.90) 38%,
      rgba(255, 255, 255, 0.58) 62%,
      rgba(255, 255, 255, 0.08) 100%
    );
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.92) 50%, rgba(0, 0, 0, 0.15) 88%, rgba(0, 0, 0, 0) 100%);
    -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.92) 50%, rgba(0, 0, 0, 0.15) 88%, rgba(0, 0, 0, 0) 100%);
  }

  /* Bottom blur-fade bridge into the Where We Supply section */
  .hero-bottom-blur-bridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 110px;
    z-index: 1;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(248, 250, 252, 0.85) 70%, #f8fafc 100%);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    pointer-events: none;
  }

  /* Soft base white veil to keep left text crisp even without mask-image support */
  .hero-fullscreen::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.92) 0%,
      rgba(255, 255, 255, 0.80) 42%,
      rgba(255, 255, 255, 0.20) 74%,
      rgba(255, 255, 255, 0) 100%
    );
    pointer-events: none;
  }

  .hero-main-container {
    position: relative;
    z-index: 2;
    width: min(1140px, 100%);
    margin: 0 auto;
  }

  .hero-info-block {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .hero-main-title {
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: clamp(2.35rem, 5vw, 3.85rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #0a1628;
    margin: 0;
  }

  .hero-sub-info {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(1.02rem, 1.6vw, 1.22rem);
    font-weight: 600;
    line-height: 1.6;
    color: #1e293b;
    margin: 0;
    max-width: 580px;
  }

  .hero-cta-prompt {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(0.95rem, 1.35vw, 1.08rem);
    font-weight: 700;
    color: #0a1628;
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }

  .hero-cta-wrapper {
    margin-top: 0.65rem;
    display: inline-flex;
    align-items: center;
    width: fit-content;
  }

  .hero-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 2.2rem;
    border-radius: 9999px;
    background: #15803d;
    color: #ffffff;
    border: 2px solid #0a1628;
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(21, 128, 61, 0.28);
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .hero-whatsapp-btn:hover {
    background: #0a1628;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(10, 22, 40, 0.32);
  }

  .whatsapp-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
  }

  /* ==========================================================================
     Where We Supply Section (Scraped Industry Grid + Blur-Fade Animations)
     ========================================================================== */
  .supply-sectors-section {
    position: relative;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 35%, #f1f5f9 100%);
    padding: clamp(3.5rem, 7vw, 6rem) 1.5rem clamp(4.5rem, 8vw, 7rem);
    overflow: hidden;
  }

  .supply-container {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .supply-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(2.5rem, 5vw, 3.75rem);
  }

  .supply-eyebrow {
    display: inline-block;
    padding: 0.38rem 1rem;
    border-radius: 9999px;
    background: rgba(21, 128, 61, 0.1);
    border: 1px solid rgba(21, 128, 61, 0.25);
    color: #15803d;
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  .supply-title {
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: clamp(1.85rem, 3.8vw, 2.85rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #0a1628;
    margin: 0 0 0.85rem;
    line-height: 1.15;
    border: none;
    padding: 0;
  }

  .supply-subtitle {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(0.98rem, 1.4vw, 1.12rem);
    color: #475569;
    line-height: 1.65;
    margin: 0;
  }

  .supply-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
    gap: 1.5rem;
  }

  .supply-card {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    background: #ffffff;
    border: 1.5px solid rgba(10, 22, 40, 0.1);
    box-shadow: 0 14px 32px -8px rgba(10, 22, 40, 0.12);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease, border-color 0.3s ease;
  }

  .supply-card:hover {
    transform: translateY(-6px);
    border-color: rgba(21, 128, 61, 0.45);
    box-shadow: 0 22px 44px -10px rgba(10, 22, 40, 0.22);
  }

  .supply-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .supply-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), filter 0.45s ease;
  }

  .supply-card:hover .supply-card-img {
    transform: scale(1.07);
  }

  /* Frosted White-Opacity Blur-Fade Overlay at the bottom of each card */
  .supply-card-blur-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 58%;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.82) 52%,
      rgba(255, 255, 255, 0.96) 100%
    );
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.85) 45%, rgba(0, 0, 0, 1) 100%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.85) 45%, rgba(0, 0, 0, 1) 100%);
    pointer-events: none;
  }

  .supply-card-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.25rem 1.15rem 1.1rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.78) 45%,
      rgba(255, 255, 255, 0.95) 100%
    );
  }

  .supply-card-title {
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #0a1628;
    margin: 0;
    line-height: 1.25;
  }

  .supply-card-sub {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: #15803d;
