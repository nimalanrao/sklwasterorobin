  }

  /* ==========================================================================
     4. Our Work / Kerja Lapangan Gallery Section
     ========================================================================== */
  .our-work-section {
    position: relative;
    background: #ffffff;
    padding: clamp(3.5rem, 6vw, 5.5rem) 1.5rem clamp(4rem, 6vw, 6rem);
    border-top: 1px solid rgba(10, 22, 40, 0.08);
  }

  .our-work-header-centered {
    text-align: center;
    align-items: center;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
  }

  .our-work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (min-width: 1024px) {
    .our-work-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .work-card {
    background: #ffffff;
    border: 2px solid rgba(10, 22, 40, 0.1);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 24px -8px rgba(10, 22, 40, 0.08);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease, border-color 0.3s ease;
    padding: 0;
    cursor: pointer;
    text-align: left;
    display: block;
    width: 100%;
  }

  /* Desktop styles: strictly hide mobile loop duplicates (placed after .work-card with higher specificity) */
  .work-card.work-card-duplicate,
  .place-pill-card.supply-card-duplicate,
  .place-pill-card.place-card-duplicate {
    display: none;
  }

  .work-card:hover {
    transform: translateY(-6px);
    border-color: #15803d;
    box-shadow: 0 20px 40px -10px rgba(21, 128, 61, 0.22);
  }

  .work-media {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #0a1628;
  }

  .work-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .work-card:hover .work-img {
    transform: scale(1.05);
  }

  .work-tap-hint {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    background: rgba(10, 22, 40, 0.75);
    backdrop-filter: blur(8px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  .work-card:hover .work-tap-hint {
    opacity: 1;
    transform: scale(1.1);
    background: #15803d;
  }

  /* Tap Image Modal / Lightbox with Fade In / Fade Out */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
  }

  .lightbox-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 22, 40, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .lightbox-content {
    position: relative;
    z-index: 2;
    max-width: min(92vw, 600px);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    transform: scale(0.92);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox-overlay.is-active .lightbox-content {
    transform: scale(1);
  }

  .lightbox-close-btn {
    position: absolute;
    top: -46px;
    right: -8px;
    width: 42px;
    height: 42px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .lightbox-close-btn:hover {
    background: #dc2626;
    border-color: #dc2626;
    transform: rotate(90deg);
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 76vh;
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    border: 2px solid rgba(255, 255, 255, 0.25);
    object-fit: contain;
  }

  .lightbox-caption {
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  /* Floating WhatsApp Round FAB Button */
  .floating-wa-fab-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 999;
  }

  .floating-wa-circle-btn {
    position: relative;
    width: 66px;
    height: 66px;
    border-radius: 9999px;
    background: #25d366;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 28px rgba(37, 211, 102, 0.45), 0 4px 12px rgba(10, 22, 40, 0.2);
    text-decoration: none;
    border: 2px solid #ffffff;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease, background-color 0.2s ease;
  }

  .floating-wa-circle-btn:hover {
    background: #1eb855;
    transform: scale(1.08) translateY(-3px);
    box-shadow: 0 16px 36px rgba(37, 211, 102, 0.6);
  }

  .floating-wa-pulse {
    position: absolute;
    inset: -6px;
    border-radius: 9999px;
    border: 2px solid #25d366;
    animation: waPulseRing 2.2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    pointer-events: none;
  }

  @keyframes waPulseRing {
    0% {
      transform: scale(0.9);
      opacity: 0.9;
    }
    70%, 100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }

  .floating-wa-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%);
    background: #0a1628;
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
    padding: 0.38rem 0.85rem;
    border-radius: 9999px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-shadow: 0 6px 16px rgba(10, 22, 40, 0.25);
  }

  .floating-wa-circle-btn:hover .floating-wa-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(-4px);
  }

  @media (max-width: 640px) {
    .floating-wa-fab-container {
      bottom: 1.25rem;
      right: 1.25rem;
    }
    .floating-wa-circle-btn {
      width: 58px;
      height: 58px;
    }
  }

