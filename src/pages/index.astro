  }

  .places-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 1.25rem;
  }

  .place-pill-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #f1f5f9;
    border: 1.5px solid rgba(10, 22, 40, 0.1);
    box-shadow: 0 8px 24px -6px rgba(10, 22, 40, 0.08);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.25s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .place-card-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 1;
    filter: saturate(1.05) contrast(1.02);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 1;
    pointer-events: none;
  }

  /* Bottom sheer shadow in pure white - starts higher up to give comfortable, high-contrast backing for text */
  .place-sheer-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0) 38%,
      rgba(255, 255, 255, 0.45) 54%,
      rgba(255, 255, 255, 0.88) 72%,
      rgba(255, 255, 255, 0.98) 88%,
      #ffffff 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  .place-card-content {
    position: relative;
    z-index: 3;
    padding: 0.85rem 1rem 0.95rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
  }

  .place-pill-card:hover {
    transform: translateY(-6px);
    border-color: #15803d;
    box-shadow: 0 18px 36px -8px rgba(10, 22, 40, 0.16), 0 0 0 1.5px #15803d;
  }

