<BaseLayout title={seo.title} description={seo.description} currentPath="/" hideFooter={true}>
  <!-- 1. Full-Screen Hero Page (Desktop: Blurred Left White Fade; Mobile: Dedicated Top-White/Bottom-Truck Image) -->
  <section class="hero-fullscreen" id="hero">
    <!-- Background Hero Image (Switches to skl-hero-mobile.jpg on <= 768px) -->
    <picture class="hero-bg-picture">
      <source media="(max-width: 768px)" srcset="/images/skl-hero-mobile.jpg" />
      <source srcset="/images/sewa-tong-roro-sungai-buloh-skl-waste.webp" type="image/webp" />
      <img
        src="/images/skl-hero-roro.jpg"
        alt="Lori Roro dan Tong Roro SKL Waste Sdn Bhd di Sungai Buloh, Selangor"
        class="hero-bg-img"
        width="1280"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>

    <!-- Blurred Fade Background with White Opacity (Desktop Only so Mobile Bottom Truck Image is 100% Viewable) -->
    <div class="hero-white-blur-fade" aria-hidden="true"></div>
    <div class="hero-bottom-blur-bridge" aria-hidden="true"></div>

    <!-- Left Content Container (Human-Visible Copy) -->
    <div class="hero-main-container">
      <div class="hero-info-block">
        <!-- Social Proof Live Badge (FOMO & Authority Psychology) -->
        <div class="hero-urgency-badge" data-reveal="badge">
          <span class="live-dot" aria-hidden="true"></span>
          <span data-ms="Lori Beroperasi Hari Ini di Selangor & KL" data-en="Trucks Operating Today in Selangor & KL">Lori Beroperasi Hari Ini di Selangor & KL</span>
        </div>

        <h1
          class="hero-main-title"
          data-reveal="title"
          data-ms="Sewa Tong RoRo Pantas di Selangor & KL"
          data-en="Fast RoRo Bin Rental in Selangor & KL"
        >
          Sewa Tong RoRo Pantas di Selangor & KL
        </h1>

        <!-- High-Conversion Psychological Value Description in Malay & English -->
        <p
          class="hero-psychological-desc"
          data-reveal="desc"
          data-ms="Hantar terus ke tapak hari ini. Sewaan 10 hari & harga terus tanpa caj tersembunyi."
          data-en="Direct site delivery today. 10-day rental & transparent pricing with zero hidden fees."
        >
          Hantar terus ke tapak hari ini. Sewaan 10 hari & harga terus tanpa caj tersembunyi.
        </p>

        <!-- WhatsApp High-Impact Pulse CTA -->
        <div class="hero-cta-wrapper" data-reveal="cta">
          <a
            href="https://wa.me/60166159365?text=Hai%20Mr%20Hari%20(SKL%20Waste%20Sdn%20Bhd)%2C%20saya%20nak%20order%20tong%20roro"
            class="hero-whatsapp-btn"
            data-track-cta="hero_whatsapp"
            aria-label="Hubungi melalui WhatsApp"
          >
            <span class="btn-glow-pulse" aria-hidden="true"></span>
            <svg
              class="whatsapp-icon"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"/>
            </svg>
            <span data-ms="24/7 WHATSAPP SEKARANG" data-en="24/7 WHATSAPP SEKARANG">24/7 WHATSAPP SEKARANG</span>
          </a>
        </div>

        <!-- Micro Social Proof & Security Line (Risk Reversal) -->
        <div class="hero-trust-row" data-reveal="trust">
          <span class="trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span data-ms="Perkhidmatan Yang Berkualiti" data-en="Quality Trusted Service">Perkhidmatan Yang Berkualiti</span>
          </span>
          <span class="trust-dot">•</span>
          <span class="trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span data-ms="Respon < 5 Minit" data-en="Fast <5 Min Reply">Respon &lt; 5 Minit</span>
          </span>
        </div>

        <!-- Social Channels Shortcut -->
        <div class="hero-social-links" data-reveal="socials">
          <span class="hero-social-label" data-ms="Ikuti Kami:" data-en="Follow Us:">Ikuti Kami:</span>
          <a
            href={contactData.socials.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-social-pill"
            aria-label="SKL Waste Sdn Bhd Facebook Page"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Facebook</span>
          </a>
          <a
            href={contactData.socials.instagram}
