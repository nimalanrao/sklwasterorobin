---

<BaseLayout title={seo.title} description={seo.description} currentPath="/" hideFooter={true}>
  <!-- 1. Full-Screen Hero Page (Desktop: Blurred Left White Fade; Mobile: Dedicated Top-White/Bottom-Truck Image) -->
  <section class="hero-fullscreen" id="hero">
    <!-- Background Hero Image (Switches to skl-hero-mobile.jpg on <= 768px) -->
    <picture class="hero-bg-picture">
      <source media="(max-width: 768px)" srcset="/images/skl-hero-mobile.jpg" />
      <source srcset="/images/sewa-tong-roro-sungai-buloh-skl-waste.webp" type="image/webp" />
      <img
        src="/images/skl-hero-roro.jpg"
        alt="Lori Roro dan Tong Roro SKL Waste Sdn Bhd di Sungai Buloh, Selangor"
        class="hero-bg-img"
        width="1280"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>

    <!-- Blurred Fade Background with White Opacity (Desktop Only so Mobile Bottom Truck Image is 100% Viewable) -->
    <div class="hero-white-blur-fade" aria-hidden="true"></div>
    <div class="hero-bottom-blur-bridge" aria-hidden="true"></div>

    <!-- Left Content Container (Human-Visible Copy) -->
    <div class="hero-main-container">
      <div class="hero-info-block">
        <h1
          class="hero-main-title"
          data-ms="SEWA TONG RoRo Selangor/KL!"
          data-en="SEWA TONG RoRo Selangor/KL!"
        >
          SEWA TONG RoRo Selangor/KL!
        </h1>

        <!-- Feature Pill Cards: 10 Hari, 24/7, Cepat, Seluruh Selangor & KL -->
        <div class="hero-feature-cards" aria-label="Kelebihan Servis SKL Waste">
          <div class="hero-feature-pill">
            <span class="feature-pill-icon" aria-hidden="true">
              <!-- Calendar / 10 Hari Icon -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </span>
            <div class="feature-pill-text">
              <strong class="feature-pill-title" data-ms="10 Hari" data-en="10 Days">10 Hari</strong>
              <span class="feature-pill-desc" data-ms="Tempoh Sewaan Fleksibel" data-en="Flexible Rental Period">Tempoh Sewaan Fleksibel</span>
            </div>
          </div>

          <div class="hero-feature-pill">
            <span class="feature-pill-icon" aria-hidden="true">
              <!-- Clock / 24/7 Icon -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </span>
            <div class="feature-pill-text">
              <strong class="feature-pill-title">24/7</strong>
              <span class="feature-pill-desc" data-ms="Khidmat Setiap Hari" data-en="Daily Standby Support">Khidmat Setiap Hari</span>
            </div>
          </div>

          <div class="hero-feature-pill">
            <span class="feature-pill-icon" aria-hidden="true">
              <!-- Bolt / Cepat Icon -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </span>
            <div class="feature-pill-text">
              <strong class="feature-pill-title" data-ms="Cepat" data-en="Fast">Cepat</strong>
              <span class="feature-pill-desc" data-ms="Hantar & Kutip Pantas" data-en="Prompt Drop & Pick-Up">Hantar & Kutip Pantas</span>
            </div>
          </div>

          <div class="hero-feature-pill hero-feature-pill-wide">
            <span class="feature-pill-icon" aria-hidden="true">
              <!-- Map Pin / Seluruh Selangor & KL Icon -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <div class="feature-pill-text">
              <strong class="feature-pill-title" data-ms="Seluruh Selangor & KL" data-en="All Selangor & KL">Seluruh Selangor & KL</strong>
              <span class="feature-pill-desc" data-ms="Liputan Semua Daerah Utama" data-en="Coverage Across All Townships">Liputan Semua Daerah Utama</span>
            </div>
          </div>
        </div>

        <!-- WhatsApp Pill CTA -->
        <div class="hero-cta-wrapper">
          <a
            href="https://wa.me/60166159365?text=Hai%20Mr%20Hari%20(SKL%20Waste%20Sdn%20Bhd)%2C%20saya%20nak%20order%20tong%20roro"
            class="hero-whatsapp-btn"
            data-track-cta="hero_whatsapp"
            aria-label="Hubungi melalui WhatsApp"
          >
            <svg
              class="whatsapp-icon"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"/>
            </svg>
            <span data-ms="24/7 WHATSAPP SEKARANG" data-en="24/7 WHATSAPP SEKARANG">24/7 WHATSAPP SEKARANG</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Visually Hidden SEO & Crawler Context (Visible to Robots/Scrapers Only) -->
    <div class="crawler-seo-content">
      <h2>SEWA TONG RORO. PENGURUSAN SISA LEBIH MUDAH. / TONG RORO RENTAL. WASTE MANAGEMENT MADE SIMPLE.</h2>
      <p>
        Perkhidmatan sewaan Tong Roro (2 Kaki &amp; 4 Kaki), kutipan sampah, pengangkutan dan pelupusan sisa untuk kediaman, komersial, pembinaan dan industri di Sungai Buloh &amp; Selangor.
        Tong Roro bin rental (2 Feet &amp; 4 Feet), waste collection, transport, and disposal services for residential, commercial, construction, and industrial sites in Sungai Buloh &amp; Selangor.
      </p>
      <p>
        SKL WASTE SDN BHD (200801038953) • Tempoh Sewaan 10 Hari (10-Day Rental) • RM2XX (2 Kaki / 2 Feet) / RM3XX–RM4XX (4 Kaki / 4 Feet) • Mr Hari: +60 16-615 9365
      </p>
      <h2>{companyData.name} ({companyData.registrationNumber}) - Sewaan Tong Roro Selangor &amp; Sungai Buloh</h2>
      <p>
        Ibu Pejabat: {companyData.headquarters.fullAddress}. Pegawai Dihubungi: {contactData.mainContactPerson} ({contactData.telephoneDisplay}, {contactData.email}).
      </p>
      <ul>
        <li><a href="/tong-roro-rental">Tong Roro Rental (Sewa Tong Roro 2 Feet RM2XX &amp; 4 Feet RM3XX–RM4XX - 10 Days)</a></li>
        <li><a href="/waste-management-services">Waste Management Services (Perkhidmatan Pengurusan &amp; Pelupusan Sisa)</a></li>
        <li><a href="/industries-we-serve">Industries We Serve (Sektor Industri, Pembinaan &amp; Komersial)</a></li>
        <li><a href="/service-areas">Service Areas (Kawasan Liputan Sungai Buloh, Rawang, Puncak Alam &amp; Selangor)</a></li>
        <li><a href="/contact-us">Contact Us (Hubungi Mr Hari +60 16-615 9365)</a></li>
        <li><a href="/about-us">About Us (Tentang SKL Waste Sdn Bhd)</a></li>
        <li><a href="/privacy-policy">Privacy Policy (Dasar Privasi)</a></li>
      </ul>
      <ul>
        {productsData.map((p) => (
          <li>{p.name} ({p.sizeLabel}): {p.priceDisplay} ({p.rentalDuration})</li>
        ))}
      </ul>
      <ul>
        {secondaryServices.map((s) => (
          <li>{s.name} ({s.nameEn})</li>
        ))}
      </ul>
      <ul>
        {serviceAreasData.map((a) => (
          <li>{a.name} - {a.region} ({a.statusLabel})</li>
        ))}
      </ul>
      <ul>
        {industriesData.map((ind) => (
          <li>{ind.name} ({ind.nameMs})</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2. Where We Supply: 12 Industry Sectors Section -->
  <section class="supply-sectors-section" id="where-we-supply">
    <div class="supply-container">
      <div class="supply-header blur-fade-item">
        <span
          class="supply-eyebrow"
          data-ms="SEKTOR BEKALAN KAMI"
          data-en="WHERE WE SUPPLY"
        >
          SEKTOR BEKALAN KAMI
        </span>
        <h2
          class="supply-title"
          data-ms="Lokasi & Industri Yang Kami Bekalkan"
          data-en="Industries & Sectors We Supply"
        >
          Lokasi &amp; Industri Yang Kami Bekalkan
        </h2>
        <p
          class="supply-subtitle"
          data-ms="Kami membekalkan Tong Roro dan perkhidmatan pengurusan sisa merentasi pelbagai sektor komersial, perindustrian, institusi dan kediaman."
          data-en="We supply RORO bins and reliable waste management solutions across commercial, industrial, institutional and residential sectors."
        >
          Kami membekalkan Tong Roro dan perkhidmatan pengurusan sisa merentasi pelbagai sektor komersial, perindustrian, institusi dan kediaman.
        </p>
      </div>

      <div class="supply-grid">
        {suppliedSectors.map((sector, index) => (
          <article
            class="supply-card blur-fade-item"
            style={`--stagger-delay: ${(index % 4) * 80}ms;`}
          >
            <div class="supply-card-media">
              <img
                src={sector.image}
                alt={`${sector.labelMs} - SKL Waste Sdn Bhd Tong Roro`}
                class="supply-card-img"
                width="640"
                height="420"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="supply-card-body">
              <h3
                class="supply-card-title"
                data-ms={sector.labelMs}
                data-en={sector.labelEn}
              >
                {sector.labelMs}
              </h3>
              <p
                class="supply-card-sub"
                data-ms={sector.subMs}
                data-en={sector.subEn}
              >
                {sector.subMs}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Places We Supply: 13 Selangor Service Areas Section -->
  <section class="places-supply-section" id="places-we-supply">
    <div class="supply-container">
      <div class="supply-header blur-fade-item">
        <span
          class="supply-eyebrow"
          data-ms="KAWASAN LIPUTAN"
          data-en="PLACES WE SUPPLY"
        >
          KAWASAN LIPUTAN
        </span>
        <h2
          class="supply-title"
          data-ms="Kawasan Yang Kami Bekalkan (Selangor & KL)"
          data-en="Places We Supply (Selangor & KL)"
        >
          Kawasan Yang Kami Bekalkan (Selangor & KL)
        </h2>
        <p
          class="supply-subtitle"
          data-ms="Penghantaran dan kutipan Tong Roro meliputi Sungai Buloh, seluruh kawasan utama Selangor dan Kuala Lumpur."
          data-en="Fast RORO bin delivery and waste collection covering Sungai Buloh, Greater Selangor, and Kuala Lumpur."
        >
          Penghantaran dan kutipan Tong Roro meliputi Sungai Buloh, seluruh kawasan utama Selangor dan Kuala Lumpur.
        </p>
      </div>

      <div class="places-grid">
        {suppliedPlaces.map((place, idx) => (
          <div
            class="place-pill-card blur-fade-item"
            style={`--stagger-delay: ${(idx % 6) * 45}ms;`}
          >
            {place.image && (
              <div
                class="place-card-bg"
                style={`background-image: url('${place.image}');`}
                aria-hidden="true"
              ></div>
            )}
            <div class="place-sheer-overlay" aria-hidden="true"></div>
            <div class="place-card-content">
              <div class="place-card-main">
                <span class="place-name">{place.name}</span>
                <span class="place-status-indicator">
                  <span class="status-dot" aria-hidden="true"></span>
                  <span class="status-label">Liputan Aktif 24/7</span>
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Our Work / Kerja Lapangan SKL Waste -->
  <section class="our-work-section" id="our-work">
    <div class="supply-container">
      <div class="supply-header-block our-work-header-centered">
        <span
          class="supply-eyebrow"
          data-ms="KERJA LAPANGAN KAMI"
          data-en="OUR WORK IN ACTION"
        >
          KERJA LAPANGAN KAMI
        </span>
        <h2
          class="supply-title"
          data-ms="Gambar Kerja Sebenar SKL Waste"
          data-en="Real On-Site Project Photos"
        >
          Gambar Kerja Sebenar SKL Waste
        </h2>
      </div>

      <!-- Human-Visible Image Grid: Pure Clean Images with Tap-to-Zoom Lightbox -->
      <div class="our-work-grid">
        {ourWorkGallery.map((item, idx) => (
          <button
