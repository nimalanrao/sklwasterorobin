  }

  .place-name {
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: 1.12rem;
    font-weight: 800;
    color: #0a1628;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .place-status-indicator {
    display: inline-flex;
