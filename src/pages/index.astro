<script is:inline>
  (function() {
    // 1. Scroll-triggered blur-fade reveal for cards and location pills
    function initBlurFade() {
      var blurItems = document.querySelectorAll('.blur-fade-item');
      if (!blurItems.length) return;

      if ('IntersectionObserver' in window) {
        var blurObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in-view');
              blurObserver.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.05,
          rootMargin: '0px 0px -20px 0px'
        });

        blurItems.forEach(function(item) {
          blurObserver.observe(item);
        });
      } else {
        blurItems.forEach(function(item) {
          item.classList.add('is-in-view');
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBlurFade);
    } else {
      initBlurFade();
    }

    // 2. Continuous scroll-driven scale animation ("THE MORE U SCROLL THE BIGGER/SMALLER IT BECOMES")
    var scaleCard = document.getElementById('scroll-scale-card');
    if (scaleCard) {
      var ticking = false;

      function updateCardScale() {
        ticking = false;
        var rect = scaleCard.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var cardCenter = rect.top + rect.height / 2;
        var viewportCenter = vh / 2;

        // Distance from viewport center normalized (0 at center, 1 at edge/outside)
        var distance = Math.abs(cardCenter - viewportCenter);
        var maxDistance = vh * 0.85;
        var ratio = Math.max(0, Math.min(1, 1 - distance / maxDistance));

        // Smoothly scale between 0.82 (smaller when scrolled away) and 1.04 (bigger as you scroll into focus)
        var scaleVal = 0.82 + ratio * 0.22;
        scaleCard.style.transform = 'scale(' + scaleVal.toFixed(4) + ')';
      }

      window.addEventListener('scroll', function() {
        if (!ticking) {
          window.requestAnimationFrame(updateCardScale);
          ticking = true;
        }
      }, { passive: true });

      window.addEventListener('resize', updateCardScale, { passive: true });
      updateCardScale();
    }

    // 3. Tap-to-Zoom Lightbox for Project Images (Fade In / Fade Out)
    var lightbox = document.getElementById('work-lightbox');
    var lightboxImg = document.getElementById('lightbox-img');
    var lightboxCaption = document.getElementById('lightbox-caption');
    var lightboxBackdrop = document.getElementById('lightbox-backdrop');
    var lightboxClose = document.getElementById('lightbox-close');
    var triggerButtons = document.querySelectorAll('.work-card-trigger');

    function openLightbox(imgSrc, captionText) {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = imgSrc;
      lightboxImg.alt = captionText || 'SKL Waste Tong Roro';
      if (lightboxCaption) lightboxCaption.textContent = captionText || '';
      lightbox.classList.add('is-active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('is-active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(function() {
        if (lightboxImg && !lightbox.classList.contains('is-active')) {
          lightboxImg.src = '';
        }
      }, 300);
    }

    triggerButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var fullImg = btn.getAttribute('data-full-img');
        var caption = btn.getAttribute('data-caption');
        if (fullImg) openLightbox(fullImg, caption);
      });
    });

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);

    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && lightbox && lightbox.classList.contains('is-active')) {
        closeLightbox();
      }
    });

    // 4. Interactive Auto-Scrolling + Swipeable Carousel
    function initTouchPausableCarousels() {
      var tracks = [
        { track: document.querySelector('.our-work-carousel-track'), speed: 1.2 },
        { track: document.querySelector('.supply-carousel-track'), speed: 2.2 },
        { track: document.querySelector('.places-carousel-track'), speed: 2.2 }
      ];

      tracks.forEach(function(item) {
        var el = item.track;
        if (!el) return;

        var isUserInteracting = false;
        var resumeTimeout = null;
        var animId = null;

        function startAutoScroll() {
          if (animId) cancelAnimationFrame(animId);

          function step() {
            if (!isUserInteracting && window.innerWidth <= 768) {
              var maxScroll = el.scrollWidth / 2;
              el.scrollLeft += item.speed;
              if (el.scrollLeft >= maxScroll) {
                el.scrollLeft -= maxScroll;
              }
            }
            animId = requestAnimationFrame(step);
          }
          animId = requestAnimationFrame(step);
        }

        function onTouchStart() {
          isUserInteracting = true;
          if (resumeTimeout) clearTimeout(resumeTimeout);
        }

        function onTouchEnd() {
          if (resumeTimeout) clearTimeout(resumeTimeout);
          resumeTimeout = setTimeout(function() {
            isUserInteracting = false;
          }, 2000);
        }

        el.addEventListener('touchstart', onTouchStart, { passive: true });
        el.addEventListener('touchmove', onTouchStart, { passive: true });
        el.addEventListener('touchend', onTouchEnd, { passive: true });
        el.addEventListener('touchcancel', onTouchEnd, { passive: true });

        el.addEventListener('pointerdown', onTouchStart, { passive: true });
        el.addEventListener('pointerup', onTouchEnd, { passive: true });

        // Loop seamlessly if manually swiped past midway
        el.addEventListener('scroll', function() {
          if (window.innerWidth <= 768) {
            var maxScroll = el.scrollWidth / 2;
            if (el.scrollLeft >= maxScroll * 1.8) {
              el.scrollLeft -= maxScroll;
            } else if (el.scrollLeft <= 0 && isUserInteracting) {
              el.scrollLeft += maxScroll;
            }
          }
        }, { passive: true });

        startAutoScroll();
      });
    }
    initTouchPausableCarousels();

    // 5. Thin SEO Strip Click Interceptor (Prevents human navigation to jargon subpages, redirects smoothly to home)
    var thinLinks = document.querySelectorAll('.thin-seo-link');
    thinLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  })();
</script>

