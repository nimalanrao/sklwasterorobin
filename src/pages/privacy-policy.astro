---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { companyData } from '../data/company';
import { contactData } from '../data/contact';
import { getPageSEO } from '../data/seo';

const seo = getPageSEO('/privacy-policy');
---

<BaseLayout 
  title={seo.title}
  description={seo.description}
  currentPath="/privacy-policy"
>
  <div class="section-surface" style="border-bottom: 1px solid var(--border-subtle, #e2e8f0); padding: clamp(2.5rem, 5vw, 4rem) 0;">
    <div class="container">
      <div style="margin-bottom: 1.25rem;">
        <Breadcrumb items={seo.breadcrumbs} />
      </div>

      <div class="eyebrow" style="margin-bottom: 1rem; display: inline-flex; align-items: center; gap: 0.5rem; background: var(--accent-green-soft, #f0fdf4); color: var(--accent-green, #15803d); border: 1px solid var(--accent-green-border, #bbf7d0); padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.8125rem; font-weight: 600;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Pematuhan PDPA Malaysia &bull; Privasi Data</span>
      </div>

      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 1rem; color: var(--text-primary, #0a1628);">
        {seo.h1}
      </h1>
      
      <p style="font-size: clamp(1rem, 1.8vw, 1.15rem); color: var(--text-secondary, #475569); max-width: 65ch; line-height: 1.6; margin-bottom: 1.5rem;">
        Komitmen telus <strong>SKL WASTE SDN BHD</strong> (No. Pendaftaran: <strong>200801038953</strong>) dalam mengendalikan data peribadi dan maklumat permohonan sebut harga anda selaras dengan Akta Perlindungan Data Peribadi 2010 (PDPA) Malaysia.
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.875rem; color: var(--text-muted, #64748b); padding-top: 1rem; border-top: 1px solid var(--border-subtle, #e2e8f0);">
        <div><strong>Entiti Berdaftar:</strong> SKL WASTE SDN BHD</div>
        <div><strong>No. Pendaftaran:</strong> 200801038953</div>
        <div><strong>Lokasi:</strong> Sungai Buloh, Selangor</div>
        <div><strong>Tarikh Kemas Kini:</strong> 18 November 2026</div>
      </div>
    </div>
  </div>

  <div class="section" style="padding: clamp(3rem, 5vw, 5rem) 0;">
    <div class="container" style="max-width: 82ch; margin: 0 auto;">
      
      <!-- Phase 1 Architecture & Transparency Callout -->
      <div class="card reveal-on-scroll" style="margin-bottom: 2.5rem; background: var(--accent-green-soft, #f0fdf4); border: 1px solid var(--accent-green-border, #bbf7d0); border-radius: var(--radius-md, 12px); padding: 1.75rem;">
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <div style="background: var(--accent-green, #15803d); color: #ffffff; border-radius: 8px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 0.15rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
          </div>
          <div>
            <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary, #0a1628); margin: 0 0 0.5rem 0; border-bottom: none; padding-bottom: 0;">
              Ketelusan Pengendalian Data Fasa 1 (Phase 1 Data Architecture)
            </h2>
            <p style="font-size: 0.95rem; color: var(--text-secondary, #475569); line-height: 1.6; margin: 0;">
              Laman web ini beroperasi sebagai platform statik bermaklumat. Sistem kami <strong>tidak menyimpan data peribadi anda ke pangkalan data awam (public database)</strong>. Setiap borang sebut harga atau pertanyaan disalurkan terus melalui pengesahan klien e-mel rasmi ke <a href="mailto:tongroroservissklwaste@gmail.com" style="color: var(--accent-green, #15803d); font-weight: 600;">tongroroservissklwaste@gmail.com</a> atau penyelarasan telefon pantas bersama <strong>Mr Hari</strong> di <a href="tel:+60166159365" style="color: var(--accent-green, #15803d); font-weight: 600;">+60 16-615 9365</a>.
            </p>
          </div>
        </div>
      </div>

      <!-- Section 1: Pengenalan -->
      <section class="reveal-on-scroll" style="margin-bottom: 3rem;">
        <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary, #0a1628); border-bottom: 2px solid var(--border-subtle, #e2e8f0); padding-bottom: 0.75rem; margin-bottom: 1.25rem;">
          1. Pengenalan &amp; Entiti Bertanggungjawab
        </h2>
        <p style="color: var(--text-secondary, #475569); line-height: 1.7; margin-bottom: 1rem;">
          Dasar Privasi ini menggariskan tatacara bagaimana <strong>SKL WASTE SDN BHD</strong> (No. Pendaftaran Syarikat: <strong>200801038953</strong>) beralamat di <strong>PT 31127 SETOR JALAN KUALA SELANGOR, 47000 SUNGAI BULOH, SELANGOR DARUL EHSAN, MALAYSIA</strong> ("Syarikat", "kami", "pihak kami") mengumpul, memproses, menggunakan dan melindungi maklumat peribadi selaras dengan <strong>Akta Perlindungan Data Peribadi 2010 (Akta 709) Malaysia ("PDPA")</strong>. Untuk maklumat latar belakang syarikat, sila layari halaman <a href="/about-us" style="color: var(--accent-green, #15803d); font-weight: 600;">Mengenai Kami (About Us)</a>.
        </p>
        <p style="color: var(--text-secondary, #475569); line-height: 1.7; margin-bottom: 0;">
          Apabila anda melayari laman web ini, menghantar borang sebut harga Tong Roro, atau menghubungi talian perkhidmatan kami, anda memberikan persetujuan kepada pemprosesan data mengikut syarat-syarat yang dinyatakan dalam dokumen ini.
        </p>
      </section>

      <!-- Section 2: Maklumat Yang Dikumpul -->
      <section class="reveal-on-scroll" style="margin-bottom: 3rem;">
        <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary, #0a1628); border-bottom: 2px solid var(--border-subtle, #e2e8f0); padding-bottom: 0.75rem; margin-bottom: 1.25rem;">
          2. Maklumat Enkuiri Yang Dikumpul (Enquiry Information Collected)
        </h2>
        <p style="color: var(--text-secondary, #475569); line-height: 1.7; margin-bottom: 1.5rem;">
          Untuk membolehkan kami menyediakan anggaran sebut harga yang tepat bagi perkhidmatan di <a href="/tong-roro-rental" style="color: var(--accent-green, #15803d); font-weight: 600;">Sewaan Tong Roro</a>, menyemak zon kebolehlaksanaan lori Roro, dan menyelaraskan jadual logistik, maklumat berikut dikumpul melalui borang sebut harga dan borang pertanyaan di halaman <a href="/contact-us" style="color: var(--accent-green, #15803d); font-weight: 600;">Hubungi Kami (Contact Us)</a>:
        </p>

        <div style="display: grid; gap: 1rem;">
          <div class="card" style="padding: 1.25rem; background: var(--bg-surface, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
              <span style="background: var(--accent-green, #15803d); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; margin-top: 0.15rem;">1</span>
              <div>
                <strong style="color: var(--text-primary, #0a1628); font-size: 1rem;">Nama Pelanggan (Customer Name)</strong>
                <p style="color: var(--text-secondary, #475569); margin: 0.25rem 0 0 0; font-size: 0.9375rem; line-height: 1.5;">
                  Mengenal pasti individu atau wakil syarikat yang memohon sewaan tong Roro atau perkhidmatan pelupusan sisa.
                </p>
              </div>
            </div>
          </div>

          <div class="card" style="padding: 1.25rem; background: var(--bg-surface, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
              <span style="background: var(--accent-green, #15803d); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; margin-top: 0.15rem;">2</span>
              <div>
                <strong style="color: var(--text-primary, #0a1628); font-size: 1rem;">Nombor Telefon (Phone Number)</strong>
                <p style="color: var(--text-secondary, #475569); margin: 0.25rem 0 0 0; font-size: 0.9375rem; line-height: 1.5;">
                  Saluran komunikasi utama untuk pengesahan sebut harga pantas, pertanyaan kesesuaian tapak, dan panggilan koordinasi pemandu lori Roro.
                </p>
              </div>
            </div>
          </div>

          <div class="card" style="padding: 1.25rem; background: var(--bg-surface, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
              <span style="background: var(--accent-green, #15803d); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; margin-top: 0.15rem;">3</span>
              <div>
                <strong style="color: var(--text-primary, #0a1628); font-size: 1rem;">Lokasi Penghantaran (Delivery Location)</strong>
                <p style="color: var(--text-secondary, #475569); margin: 0.25rem 0 0 0; font-size: 0.9375rem; line-height: 1.5;">
                  Menentukan kawasan perkhidmatan di sekitar Selangor dan Kuala Lumpur serta mengira caj pengangkutan dan penghantaran.
                </p>
              </div>
            </div>
          </div>

          <div class="card" style="padding: 1.25rem; background: var(--bg-surface, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
              <span style="background: var(--accent-green, #15803d); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; margin-top: 0.15rem;">4</span>
              <div>
                <strong style="color: var(--text-primary, #0a1628); font-size: 1rem;">Tarikh Penghantaran Pilihan (Preferred Delivery Date)</strong>
                <p style="color: var(--text-secondary, #475569); margin: 0.25rem 0 0 0; font-size: 0.9375rem; line-height: 1.5;">
                  Menyemak ketersediaan unit tong Roro saiz 2 Kaki atau 4 Kaki pada slot masa yang anda perlukan.
                </p>
              </div>
            </div>
          </div>

          <div class="card" style="padding: 1.25rem; background: var(--bg-surface, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
              <span style="background: var(--accent-green, #15803d); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; margin-top: 0.15rem;">5</span>
              <div>
                <strong style="color: var(--text-primary, #0a1628); font-size: 1rem;">Tempoh Sewaan (Rental Duration)</strong>
                <p style="color: var(--text-secondary, #475569); margin: 0.25rem 0 0 0; font-size: 0.9375rem; line-height: 1.5;">
                  Tempoh standard sewaan tong Roro adalah 10 days, atau tempoh projek lanjutan mengikut persetujuan perbincangan.
                </p>
              </div>
            </div>
          </div>

          <div class="card" style="padding: 1.25rem; background: var(--bg-surface, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
              <span style="background: var(--accent-green, #15803d); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; margin-top: 0.15rem;">6</span>
              <div>
                <strong style="color: var(--text-primary, #0a1628); font-size: 1rem;">Jenis Sisa (Waste Type)</strong>
                <p style="color: var(--text-secondary, #475569); margin: 0.25rem 0 0 0; font-size: 0.9375rem; line-height: 1.5;">
                  Memastikan sisa yang dilupuskan menepati parameter dibenarkan (sisa binaan, perobohan, sisa pukal, domestik, atau sisa kilang/komersial).
                </p>
              </div>
            </div>
          </div>

          <div class="card" style="padding: 1.25rem; background: var(--bg-surface, #f8fafc); border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
              <span style="background: var(--accent-green, #15803d); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; margin-top: 0.15rem;">7</span>
              <div>
                <strong style="color: var(--text-primary, #0a1628); font-size: 1rem;">Keperluan Tambahan (Additional Requirements)</strong>
                <p style="color: var(--text-secondary, #475569); margin: 0.25rem 0 0 0; font-size: 0.9375rem; line-height: 1.5;">
                  Maklumat sokongan seperti laluan sempit, pintu pagar berpagar, permit majlis perbandaran, atau keperluan pelupusan berperingkat.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Tujuan Penggunaan -->
      <section class="reveal-on-scroll" style="margin-bottom: 3rem;">
        <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary, #0a1628); border-bottom: 2px solid var(--border-subtle, #e2e8f0); padding-bottom: 0.75rem; margin-bottom: 1.25rem;">
          3. Tujuan Pemprosesan Data (Purpose of Use)
        </h2>
        <p style="color: var(--text-secondary, #475569); line-height: 1.7; margin-bottom: 1rem;">
          Semua maklumat yang diserahkan hanya digunakan secara ketat dan eksklusif untuk tujuan operasi berikut:
        </p>
        <ul style="color: var(--text-secondary, #475569); line-height: 1.7; padding-left: 1.25rem; margin-bottom: 1.25rem;">
          <li>Penyediaan sebut harga rasmi bagi sewaan Tong Roro dan perkhidmatan pengurusan sisa.</li>
          <li>Pengesahan ketersediaan perkhidmatan di kawasan penghantaran sebelum tempahan dimuktamadkan.</li>
          <li>Koordinasi logistik penempatan dan pengutipan tong oleh pegawai bertugas, <strong>Mr Hari</strong> (<a href="tel:+60166159365" style="color: var(--accent-green, #15803d); font-weight: 600;">+60 16-615 9365</a> / <a href="mailto:tongroroservissklwaste@gmail.com" style="color: var(--accent-green, #15803d); font-weight: 600;">tongroroservissklwaste@gmail.com</a>).</li>
          <li>Pengurusan dokumentasi invois, resit, dan pematuhan perundangan pelupusan sisa tempatan.</li>
        </ul>
        <div class="card" style="background: var(--bg-surface, #f8fafc); border-left: 4px solid var(--accent-green, #15803d); padding: 1rem 1.25rem; border-radius: var(--radius-sm, 6px);">
          <strong style="color: var(--text-primary, #0a1628);">Dasar Tanpa Perkongsian Pihak Ketiga:</strong>
          <span style="color: var(--text-secondary, #475569); font-size: 0.9375rem;">
            SKL WASTE SDN BHD tidak pernah menjual, menyewakan, atau mendedahkan data peribadi anda kepada mana-mana pihak ketiga bagi tujuan pemasaran pihak luar.
          </span>
        </div>
      </section>

      <!-- Section 4: Hak PDPA Malaysia -->
      <section class="reveal-on-scroll" style="margin-bottom: 3rem;">
        <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary, #0a1628); border-bottom: 2px solid var(--border-subtle, #e2e8f0); padding-bottom: 0.75rem; margin-bottom: 1.25rem;">
          4. Hak Anda di Bawah Akta Perlindungan Data Peribadi (PDPA)
        </h2>
        <p style="color: var(--text-secondary, #475569); line-height: 1.7; margin-bottom: 1.25rem;">
          Di bawah Akta Perlindungan Data Peribadi 2010 (PDPA) Malaysia, anda mempunyai hak yang dilindungi undang-undang mengenai maklumat peribadi anda:
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
          <div class="card" style="padding: 1.25rem; background: #ffffff; border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="color: var(--accent-green, #15803d); font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12h20"/><path d="M20 12l-4-4"/><path d="M20 12l-4 4"/></svg>
              Hak Akses Data
            </div>
            <p style="color: var(--text-secondary, #475569); font-size: 0.9rem; line-height: 1.6; margin: 0;">
              Anda berhak memohon salinan data peribadi yang kami pegang berkaitan permohonan sebut harga anda.
            </p>
          </div>

          <div class="card" style="padding: 1.25rem; background: #ffffff; border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="color: var(--accent-green, #15803d); font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Hak Pembetulan Data
            </div>
            <p style="color: var(--text-secondary, #475569); font-size: 0.9rem; line-height: 1.6; margin: 0;">
              Anda berhak memohon pembetulan maklumat sekiranya nombor telefon, nama, atau alamat tapak tidak tepat atau berubah.
            </p>
          </div>

          <div class="card" style="padding: 1.25rem; background: #ffffff; border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="color: var(--accent-green, #15803d); font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
              Hak Menarik Balik Persetujuan
            </div>
            <p style="color: var(--text-secondary, #475569); font-size: 0.9rem; line-height: 1.6; margin: 0;">
              Anda berhak membatalkan permohonan sebut harga dan meminta pemadaman data sebelum perkhidmatan dimulakan.
            </p>
          </div>

          <div class="card" style="padding: 1.25rem; background: #ffffff; border: 1px solid var(--border-subtle, #e2e8f0); border-radius: var(--radius-md, 12px);">
            <div style="color: var(--accent-green, #15803d); font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
              Had Pemprosesan
            </div>
            <p style="color: var(--text-secondary, #475569); font-size: 0.9rem; line-height: 1.6; margin: 0;">
              Anda berhak mengehadkan penggunaan data hanya untuk urusan transaksi sewaan semasa tanpa sebarang mesej susulan.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Pegawai Perhubungan PDPA -->
      <section class="card reveal-on-scroll" style="background: var(--bg-dark, #0a1628); color: #ffffff; border-radius: var(--radius-lg, 20px); padding: clamp(1.75rem, 4vw, 2.5rem); margin-bottom: 3rem;">
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div class="eyebrow" style="background: rgba(255, 255, 255, 0.1); color: #86efac; border: 1px solid rgba(255, 255, 255, 0.2); width: fit-content; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.8125rem; font-weight: 600;">
            Saluran Rasmi Pertanyaan Privasi
          </div>
          <h2 style="color: #ffffff; font-size: 1.5rem; margin: 0; border: none; padding: 0;">
            Hubungi Pegawai Privasi &amp; Koordinasi
          </h2>
          <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; margin: 0;">
            Sebarang pertanyaan, semakan pembetulan data peribadi, atau permohonan akses di bawah PDPA boleh dikemukakan terus kepada pengurusan syarikat:
          </p>

          <div style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-md, 12px); padding: 1.25rem; display: grid; gap: 0.75rem; font-size: 0.9375rem;">
