  /* Mobile Card-Table Transformation & Native-Style Sticky Modal Sheet */
  @media (max-width: 768px) {
    .table-card {
      background: transparent;
      border: none;
      border-radius: 0;
      overflow: visible;
    }

    .table-scroll {
      overflow: visible;
    }

    .roro-table,
    .roro-table thead,
    .roro-table :global(tbody),
    .roro-table :global(tr),
    .roro-table :global(td) {
      display: block;
      width: 100%;
    }

    .roro-table thead {
      display: none;
    }

    .roro-table :global(tbody) {
      display: flex;
      flex-direction: column;
      gap: 1.05rem;
    }

    .roro-table :global(tbody tr) {
      background: #ffffff;
      border: 1.5px solid #cbd5e1;
      border-radius: 18px;
      padding: 1.35rem 1.25rem;
      box-shadow:
        0 8px 22px -6px rgba(15, 23, 42, 0.1),
        0 2px 6px rgba(15, 23, 42, 0.04);
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.95rem 0.85rem;
      align-items: center;
      transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s ease;
    }

    .roro-table :global(tbody tr:active) {
      transform: scale(0.985);
      background: #f8fafc;
      box-shadow: 0 4px 12px -4px rgba(15, 23, 42, 0.14);
    }

    .roro-table :global(td) {
      padding: 0;
      border-bottom: none;
    }

    /* Location full width top - Big & Ultra Clear */
    .roro-table :global(td[data-col="location"]) {
      grid-column: 1 / -1;
      padding-bottom: 0.9rem;
      border-bottom: 1.5px solid #e2e8f0;
    }

    .roro-table :global(.loc-main) {
      font-size: 1.3rem;
      font-weight: 800;
      letter-spacing: -0.015em;
      line-height: 1.35;
      color: #020617;
    }

    .roro-table :global(.loc-note) {
      font-size: 0.98rem;
      font-weight: 500;
      color: #334155;
      margin-top: 0.3rem;
    }

    /* Size & Owner left, Status right */
    .roro-table :global(td[data-col="size"]) {
      grid-column: 1 / 2;
    }

    .roro-table :global(td[data-col="size"] .owner-stack) {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
    }

    .roro-table :global(.pill-size) {
      font-size: 0.94rem;
      font-weight: 700;
      padding: 0.42rem 0.85rem;
      border-radius: 11px;
    }

    .roro-table :global(.pill-owner) {
      font-size: 0.88rem;
      font-weight: 700;
      padding: 0.38rem 0.75rem;
      border-radius: 10px;
    }

    .roro-table :global(td[data-col="status"]) {
      grid-column: 2 / 3;
      text-align: right;
    }

    .roro-table :global(td[data-col="status"] .status-stack) {
      align-items: flex-end;
      gap: 0.35rem;
    }

    .roro-table :global(.days-pill) {
      font-size: 0.94rem;
      font-weight: 800;
      padding: 0.42rem 0.88rem;
      border-radius: 12px;
    }

    .roro-table :global(.status-end-sub) {
      font-size: 0.88rem;
      font-weight: 600;
    }

    /* Customer left, Price + Chevron right */
    .roro-table :global(td[data-col="customer"]) {
      grid-column: 1 / 2;
    }

    .roro-table :global(.cust-name) {
      font-size: 1.08rem;
      font-weight: 700;
      color: #0f172a;
    }

    .roro-table :global(.cust-phone) {
      font-size: 0.96rem;
      font-weight: 600;
      color: #475569;
    }

    .roro-table :global(td[data-col="price"]) {
      grid-column: 2 / 3;
      text-align: right;
    }

    .roro-table :global(.price-val) {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.015em;
      color: #0f172a;
    }

    .roro-table :global(.row-chevron) {
      width: 22px;
      height: 22px;
    }

    .empty-state {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 20px;
      padding: 3rem 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .workspace {
      padding: 1.15rem 1rem 3.5rem;
      gap: 1.25rem;
    }

    .mobile-menu-btn {
      width: 48px;
      height: 48px;
