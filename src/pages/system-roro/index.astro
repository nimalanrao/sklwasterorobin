            <h2 class="modal-title" id="modal-title" data-i18n="modal_add_title">Add New RORO Bin</h2>
            <p class="modal-sub" data-i18n="modal_add_sub">End date is automatically calculated as 10 days from start date.</p>
          </div>
          <button type="button" id="btn-close-modal" class="icon-close-btn" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
