---
import SystemRoroLayout from '../../layouts/SystemRoroLayout.astro';
---

<SystemRoroLayout
  title="System RORO Dashboard | SKL Waste Sdn Bhd"
  description="RORO Bin Dispatch, Pickup Alerts, 10-Day Tracking & Completed Pulls Dashboard"
  requireAuth={true}
>
  <div class="dashboard-shell">
    <!-- Full-Screen Server Disconnected Red Error Overlay -->
    <div id="server-disconnected-screen" class="server-error-screen" hidden>
      <div class="server-error-card">
        <div class="server-error-icon-box">
          <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
        <h1 class="server-error-title">server not connected, please contact support</h1>
        <p class="server-error-sub">Database connection is offline or unavailable. Operations are halted until server access is restored.</p>
        <button type="button" id="btn-server-retry" class="server-error-retry-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
          <span>Retry Connection</span>
        </button>
      </div>
    </div>

    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebar-backdrop" class="sidebar-backdrop" hidden></div>

    <!-- LEFT SIDEBAR (Pure White, Clean Navigation + Admin & Logout at Bottom) -->
    <aside id="app-sidebar" class="sidebar" aria-label="System RORO Navigation">
      <!-- Brand Block -->
      <div class="sidebar-brand">
        <div class="sidebar-brand-left">
          <div class="sidebar-logo-icon">
            <picture>
              <source srcset="/images/logo-skl-waste-sdn-bhd.webp" type="image/webp" />
              <img
                src="/images/skl-logo.png"
                alt="SKL Waste Sdn Bhd Logo"
                width="34"
                height="34"
                class="sidebar-logo-img"
              />
            </picture>
          </div>
          <div class="sidebar-brand-meta">
            <div class="sidebar-brand-title-row">
              <span class="sidebar-brand-title">SYSTEM RORO</span>
              <button type="button" id="btn-brand-refresh" class="brand-refresh-btn" title="Refresh data from Supabase" aria-label="Refresh data">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 4 23 10 17 10"></polyline>
                  <polyline points="1 20 1 14 7 14"></polyline>
                  <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
              </button>
            </div>
            <span class="sidebar-brand-sub">SKL Waste Sdn Bhd</span>
          </div>
        </div>
        <button type="button" id="btn-close-sidebar" class="mobile-close-btn" aria-label="Close sidebar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Navigation Views -->
      <nav class="sidebar-nav">
        <div class="nav-section-label" data-i18n="section_operations">OPERATIONS</div>
        <button type="button" class="nav-item active" data-nav-view="all">
          <span class="nav-item-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
            <span data-i18n="nav_all">Active Bins</span>
          </span>
          <span class="nav-count" id="nav-count-all">0</span>
        </button>

        <button type="button" class="nav-item" data-nav-view="active">
          <span class="nav-item-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span data-i18n="nav_active">&lt;10 Days</span>
          </span>
          <span class="nav-count green" id="nav-count-active">0</span>
        </button>

        <button type="button" class="nav-item" data-nav-view="overdue">
          <span class="nav-item-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span data-i18n="nav_overdue">Needs Pull</span>
          </span>
          <span class="nav-count red" id="nav-count-overdue">0</span>
        </button>

        <button type="button" class="nav-item" data-nav-view="completed">
          <span class="nav-item-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span data-i18n="nav_completed">Completed</span>
          </span>
          <span class="nav-count slate" id="nav-count-completed">0</span>
        </button>

        <div class="nav-section-label spaced" data-i18n="section_owners">OWNERS</div>
        <button type="button" class="nav-item" data-nav-view="owner_skl">
          <span class="nav-item-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>SKL Waste</span>
          </span>
          <span class="nav-count" id="nav-count-owner-skl">0</span>
        </button>

        <button type="button" class="nav-item" data-nav-view="owner_thirumal">
          <span class="nav-item-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span>Thirumal Vel</span>
          </span>
          <span class="nav-count amber" id="nav-count-owner-thirumal">0</span>
        </button>

        <div class="nav-section-label spaced" data-i18n="section_sizes">BIN SIZES</div>
        <button type="button" class="nav-item" data-nav-view="2ft">
          <span class="nav-item-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="9" width="20" height="11" rx="2"></rect>
              <path d="M7 9V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3"></path>
            </svg>
            <span data-i18n="size_2ft">2 Feet</span>
          </span>
          <span class="nav-count" id="nav-count-2ft">0</span>
        </button>

        <button type="button" class="nav-item" data-nav-view="4ft">
          <span class="nav-item-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="5" width="20" height="15" rx="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
            <span data-i18n="size_4ft">4 Feet</span>
          </span>
          <span class="nav-count" id="nav-count-4ft">0</span>
        </button>

        <div class="nav-section-label spaced" data-i18n="section_system">SYSTEM</div>
        <a href="/system-roro/statement" target="_blank" rel="noopener noreferrer" class="nav-item nav-item-link">
          <span class="nav-item-left">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span data-i18n="nav_statement">Daily Statement</span>
          </span>
          <svg class="nav-lock-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
        <button type="button" class="nav-item" id="btn-open-settings-nav">
          <span class="nav-item-left">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span data-i18n="nav_settings">Settings</span>
          </span>
          <svg class="nav-lock-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </button>

        <div class="nav-section-label spaced" data-i18n="section_language">LANGUAGE / BAHASA</div>
        <div class="lang-toggle-wrap">
          <button type="button" class="lang-btn active" id="btn-lang-en" data-lang="en">
            <span>English</span>
          </button>
          <button type="button" class="lang-btn" id="btn-lang-ms" data-lang="ms">
            <span>B. Melayu</span>
          </button>
        </div>

        <div class="nav-section-label spaced" data-i18n="section_theme">THEME / TEMA</div>
        <div class="lang-toggle-wrap">
          <button type="button" class="lang-btn active" id="btn-theme-light" data-theme-choice="light">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <span data-i18n="theme_light">Light</span>
          </button>
          <button type="button" class="lang-btn" id="btn-theme-dark" data-theme-choice="dark">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <span data-i18n="theme_dark">Dark</span>
          </button>
        </div>
      </nav>

      <!-- Sidebar Bottom Area: Admin Profile Dropdown & Logout -->
      <div class="sidebar-footer">
        <!-- Admin Account Row + Animated Blur Dropdown Menu (Opens Upward) -->
        <div class="dropdown-anchor sidebar-admin-anchor" id="admin-dropdown-wrapper">
          <div class="blur-dropdown-menu upward" id="admin-dropdown-menu" role="menu">
            <div class="dropdown-meta-header">
              <span class="dm-name">SKL Waste Admin</span>
              <span class="dm-sub">Full Administrator Access</span>
            </div>
            <div class="dropdown-sep"></div>
            <button type="button" id="btn-export-json" class="dropdown-action-item" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Export Records (JSON)</span>
            </button>
            <button type="button" id="btn-open-settings-menu" class="dropdown-action-item" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
              <span>Special Settings</span>
            </button>
            <div class="dropdown-sep"></div>
            <button type="button" id="btn-menu-logout" class="dropdown-action-item danger" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span>Sign Out</span>
            </button>
          </div>

          <div class="admin-profile-bar">
            <button type="button" id="btn-admin-dropdown" class="admin-profile-trigger" aria-haspopup="true" aria-expanded="false">
              <span class="admin-avatar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </span>
              <span class="admin-text">
                <span class="admin-name">Admin</span>
                <span class="admin-role">Operations</span>
              </span>
              <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="18 15 12 9 6 15"></polyline>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </aside>

    <!-- MAIN DASHBOARD WORKSPACE (Pure White, No Top Site Navbar) -->
    <main class="workspace">
      <!-- Workspace Title Row -->
      <header class="workspace-header">
        <div class="workspace-header-left">
          <button type="button" id="btn-open-sidebar" class="mobile-menu-btn" aria-label="Open sidebar menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div>
            <h1 class="workspace-title" id="workspace-heading">Active Bins</h1>
            <p class="workspace-sub" id="workspace-subtitle">Live fleet status and pulls</p>
          </div>
        </div>

        <div class="workspace-header-right">
          <!-- Quick Daily Statement (Opens A4 Official Statement in New Tab) -->
          <a
            href="/system-roro/statement"
            target="_blank"
            rel="noopener noreferrer"
            class="notif-bell-btn statement-header-btn"
            title="Daily Statement (A4 PDF)"
            aria-label="Open Daily Statement in new tab"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </a>

          <!-- Pickup Notification Center (Bell with Animated Blur Dropdown) -->
          <div class="dropdown-anchor" id="notif-dropdown-wrapper">
            <button type="button" id="btn-notif-bell" class="notif-bell-btn" aria-haspopup="true" aria-expanded="false" aria-label="Pickup notifications">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
              <span class="notif-badge" id="notif-badge-count" hidden>0</span>
            </button>

            <div class="blur-dropdown-menu downward right-aligned notif-panel" id="notif-dropdown-menu" role="menu">
              <div class="notif-panel-head">
                <div>
                  <span class="notif-panel-title">Pickup Alerts</span>
                  <span class="notif-panel-sub" id="notif-panel-sub">Due today or overdue</span>
                </div>
                <button type="button" id="btn-enable-browser-notif" class="browser-notif-pill" title="Enable browser alerts">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                  </svg>
                  <span id="browser-notif-label">Alerts</span>
                </button>
              </div>
              <div class="dropdown-sep"></div>
              <div class="notif-list" id="notif-list-body">
                <!-- Populated by JS -->
              </div>
            </div>
          </div>

          <button type="button" id="btn-open-modal" class="primary-create-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span data-i18n="btn_add_bin">Add Bin</span>
          </button>
        </div>
      </header>

      <!-- Live Pickup Alert Banner (Visible whenever 1+ bins are due today or overdue) -->
      <section id="pickup-alert-banner" class="pickup-alert-banner" role="alert" hidden>
        <div class="alert-banner-left">
