  /* --- CUSTOM APPLE-STYLE BLUR CALENDAR DATE PICKER --- */
  .date-picker-anchor {
    width: 100%;
  }

  .date-trigger-btn {
    width: 100%;
    height: 48px;
    padding: 0 0.95rem;
    border: 1.5px solid #94a3b8;
    border-radius: 12px;
    background: #ffffff;
    color: #0f172a;
    font-size: 0.88rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    transition: border-color 0.16s ease, box-shadow 0.16s ease, background-color 0.15s ease;
  }

  .date-trigger-btn:hover {
    border-color: #cbd5e1;
    background: #fafbfc;
  }

  .date-picker-anchor.is-open .date-trigger-btn {
    border-color: #0f172a;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
    background: #ffffff;
