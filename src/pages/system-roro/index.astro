  // Inline Extend Period buttons inside Detail Menu
  detailExtendSection?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-detail-extend-days]') as HTMLElement | null;
    if (!btn) return;
    const rec = getActiveDetailRecord();
    if (!rec) return;

    const addDays = Number(btn.getAttribute('data-detail-extend-days')) || 1;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const currentEnd = new Date(rec.date_end + 'T00:00:00');
    const baseDate = !Number.isNaN(currentEnd.getTime()) && currentEnd >= today ? currentEnd : today;
    const nextEnd = new Date(baseDate);
    nextEnd.setDate(nextEnd.getDate() + addDays);
    const nextEndIso = toIsoDate(nextEnd);

    const updated: RoroRecord = {
      ...rec,
      date_end: nextEndIso,
      status: 'Active'
    };

    allRecords = allRecords.map((r) => (r.id === rec.id ? updated : r));
    notifiedIds.delete(rec.id);
    render();
    populateDetailModal(updated);
    const res = await updateRoroRecord(updated);
    const dayLabel = addDays === 1 ? '1 day' : `${addDays} days`;
    showToast(
