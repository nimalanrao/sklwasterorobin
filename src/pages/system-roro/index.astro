  .form-control,
  .form-textarea {
    width: 100%;
    border: 1.5px solid #94a3b8;
    border-radius: 12px;
    background: #ffffff;
    color: #020617;
    font-size: 0.96rem;
    font-weight: 600;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .form-control {
