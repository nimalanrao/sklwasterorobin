  // =========================================================================
  // 1. STRICT MALAYSIA-ONLY AUTOCOMPLETE + INTERACTIVE CLICKABLE MAP PICKER
  // =========================================================================
  const locAnchor = document.getElementById('location-autocomplete-anchor') as HTMLElement;
  const locMenu = document.getElementById('location-suggestions-menu') as HTMLElement;
  const locSpinner = document.getElementById('loc-spinner') as HTMLElement;
  const mapCanvasEl = document.getElementById('roro-map-canvas') as HTMLElement;
  const mapStatusText = document.getElementById('map-status-text') as HTMLElement;
  const btnMapStreet = document.getElementById('btn-map-street') as HTMLButtonElement;
  const btnMapSat = document.getElementById('btn-map-sat') as HTMLButtonElement;

  const DEPOT_LAT = 3.2105;
  const DEPOT_LNG = 101.5608;

  type PlaceSuggestion = {
    label: string;
    title: string;
    sub: string;
    lat?: number;
    lng?: number;
  };

  let acTimer: number | null = null;
  let acAbort: AbortController | null = null;
  let acResults: PlaceSuggestion[] = [];
  let acActiveIdx = -1;

  // Leaflet Interactive Map State
  let roroMap: any = null;
  let roroMarker: any = null;
  let streetLayer: any = null;
  let satLayer: any = null;
  let satLabelsLayer: any = null;

  function setMapStatus(msg: string) {
    const span = mapStatusText?.querySelector('span');
    if (span) span.textContent = msg;
  }

  function ensureMapReady(centerLat = DEPOT_LAT, centerLng = DEPOT_LNG, zoom = 12, dropPin = false) {
    const L = (window as any).L;
    if (!L || !mapCanvasEl) return;

    if (!roroMap) {
      const malaysiaBounds = L.latLngBounds([0.7, 99.4], [7.6, 119.6]);
      roroMap = L.map(mapCanvasEl, {
        center: [centerLat, centerLng],
        zoom,
        minZoom: 6,
        maxZoom: 19,
        maxBounds: malaysiaBounds,
        maxBoundsViscosity: 0.85,
        zoomControl: true
      });

      // Authenticated CARTO Voyager Street Map (5M req/mo free tier, Retina @2x supported)
      const cartoKey = import.meta.env.PUBLIC_CARTO_API_KEY || 'cb1_5ebw_1_9728bee24002c3f5e876702e';
      streetLayer = L.tileLayer(
        `https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=${encodeURIComponent(cartoKey)}`,
        {
          maxZoom: 19,
          attribution: '&copy; OpenStreetMap &copy; CARTO'
        }
      ).addTo(roroMap);

      // Crisp Satellite Imagery + Road Labels (Free Esri World Imagery)
      satLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 19,
        attribution: '&copy; Esri'
      });
      satLabelsLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 19
      });

      // Click anywhere on map -> drop pin + reverse geocode exact Malaysia address
      roroMap.on('click', (e: any) => {
        const { lat, lng } = e.latlng;
        placeMapPin(lat, lng, true);
      });
    } else {
      roroMap.setView([centerLat, centerLng], zoom, { animate: false });
      if (!dropPin && roroMarker) {
        roroMap.removeLayer(roroMarker);
        roroMarker = null;
      }
    }

    if (dropPin) {
      placeMapPin(centerLat, centerLng, false);
    }

    window.setTimeout(() => {
      roroMap?.invalidateSize();
    }, 120);
  }

  function placeMapPin(lat: number, lng: number, shouldReverseGeocode: boolean) {
    const L = (window as any).L;
    if (!L || !roroMap) return;

    if (!roroMarker) {
      roroMarker = L.marker([lat, lng], { draggable: true }).addTo(roroMap);
      roroMarker.on('dragend', () => {
        const pos = roroMarker.getLatLng();
        reverseGeocodeMalaysia(pos.lat, pos.lng);
      });
    } else {
      roroMarker.setLatLng([lat, lng]);
    }

    if (shouldReverseGeocode) {
      reverseGeocodeMalaysia(lat, lng);
    }
  }

  async function reverseGeocodeMalaysia(lat: number, lng: number) {
    setMapStatus('Finding exact Malaysia address...');
    if (locSpinner) locSpinner.hidden = false;
    try {
      const url = `https://nominatim.openstreetmap.org/reverse?lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lng)}&format=json&addressdetails=1&accept-language=en`;
      const res = await fetch(url);
      if (res.ok) {
        const data = await res.json();
        const cc = String(data?.address?.country_code || '').toLowerCase();
        if (cc && cc !== 'my') {
          setMapStatus('Please pick a location inside Malaysia only');
          return;
        }
        const addr = data?.address || {};
        const primary =
          addr.building ||
          addr.amenity ||
          addr.shop ||
          [addr.house_number, addr.road].filter(Boolean).join(' ') ||
          addr.neighbourhood ||
          addr.suburb ||
          '';
        const area = [
          primary !== addr.road ? addr.road : '',
          addr.suburb || addr.neighbourhood || addr.village || '',
          addr.city || addr.town || addr.county || '',
          addr.postcode || '',
          addr.state || ''
        ].filter(Boolean);

        // Deduplicate parts cleanly
        const uniqueParts: string[] = [];
        for (const p of [primary, ...area]) {
          if (p && !uniqueParts.some((u) => u.toLowerCase() === p.toLowerCase())) {
            uniqueParts.push(p);
          }
        }

        const formatted = uniqueParts.join(', ') || String(data.display_name || '').replace(/,\s*Malaysia$/i, '');
        if (formatted) {
          locationInput.value = formatted;
          closeAutocomplete();
          setMapStatus('Pinned exact location (drag pin to adjust)');
        }
      }
    } catch {
      setMapStatus('Could not resolve address — you can type it manually');
    } finally {
      if (locSpinner) locSpinner.hidden = true;
    }
  }

  // Street / Satellite layer switching
  btnMapStreet?.addEventListener('click', () => {
    if (!roroMap) return;
    btnMapStreet.classList.add('active');
    btnMapSat?.classList.remove('active');
    if (roroMap.hasLayer(satLayer)) roroMap.removeLayer(satLayer);
    if (roroMap.hasLayer(satLabelsLayer)) roroMap.removeLayer(satLabelsLayer);
    if (!roroMap.hasLayer(streetLayer)) streetLayer.addTo(roroMap);
  });

  btnMapSat?.addEventListener('click', () => {
    if (!roroMap) return;
    btnMapSat.classList.add('active');
    btnMapStreet?.classList.remove('active');
    if (roroMap.hasLayer(streetLayer)) roroMap.removeLayer(streetLayer);
    if (!roroMap.hasLayer(satLayer)) satLayer.addTo(roroMap);
    if (!roroMap.hasLayer(satLabelsLayer)) satLabelsLayer.addTo(roroMap);
  });

  function closeAutocomplete() {
    locAnchor?.classList.remove('is-open');
    acActiveIdx = -1;
  }

  function renderAutocomplete(items: PlaceSuggestion[]) {
    acResults = items;
    acActiveIdx = -1;
    if (!locMenu) return;

    if (items.length === 0) {
      locMenu.innerHTML = `<div class="ac-empty">No Malaysia places matched — click the map below or type the address directly.</div>`;
      locAnchor?.classList.add('is-open');
      return;
    }

    locMenu.innerHTML = items
      .map(
        (item, idx) => `
          <button type="button" class="ac-item" data-ac-idx="${idx}" role="option">
            <svg class="ac-pin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span class="ac-copy">
              <span class="ac-title">${escapeHtml(item.title)}</span>
              ${item.sub ? `<span class="ac-sub">${escapeHtml(item.sub)}</span>` : ''}
            </span>
          </button>
        `
      )
      .join('');
    locAnchor?.classList.add('is-open');
  }

  function selectAutocompleteItem(item: PlaceSuggestion) {
    locationInput.value = item.label;
    closeAutocomplete();
    if (typeof item.lat === 'number' && typeof item.lng === 'number' && roroMap) {
      roroMap.flyTo([item.lat, item.lng], 17, { duration: 0.65 });
      placeMapPin(item.lat, item.lng, false);
      setMapStatus('Location pinned — drag pin or click map to adjust');
    }
  }

  async function searchMalaysiaPlaces(query: string) {
    if (acAbort) acAbort.abort();
    acAbort = new AbortController();
    const signal = acAbort.signal;

    if (locSpinner) locSpinner.hidden = false;
    try {
      // Run STRICT Malaysia-only queries in parallel:
      // 1) Photon constrained to Malaysia bbox + strict countrycode === 'MY' filter
      // 2) Nominatim hard-locked to countrycodes=my (100% Malaysia only)
      const photonUrl = `https://photon.komoot.io/api/?q=${encodeURIComponent(query)}&bbox=99.5,0.8,119.5,7.5&lat=${DEPOT_LAT}&lon=${DEPOT_LNG}&limit=8&lang=en`;
      const nomUrl = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&countrycodes=my&format=json&addressdetails=1&limit=6&accept-language=en`;

      const [photonRes, nomRes] = await Promise.allSettled([
        fetch(photonUrl, { signal }),
        fetch(nomUrl, { signal })
      ]);

      const suggestions: PlaceSuggestion[] = [];
      const seen = new Set<string>();

      // Parse Photon STRICTLY Malaysia ONLY (never accept SG, PH, CA, IN, GB, etc.)
      if (photonRes.status === 'fulfilled' && photonRes.value.ok) {
        const data = await photonRes.value.json();
        const features = Array.isArray(data?.features) ? data.features : [];
        for (const f of features) {
          const p = f.properties || {};
          const cc = String(p.countrycode || '').toUpperCase();
          const country = String(p.country || '').toLowerCase();
          if (cc !== 'MY' && country !== 'malaysia') continue;

          const title = p.name || p.street || p.locality || p.city || '';
          const subParts = [
            p.street && p.street !== title ? p.street : '',
            p.district,
            p.city && p.city !== title ? p.city : '',
            p.postcode,
            p.state
          ].filter(Boolean);
          const sub = subParts.join(', ');
          const full = [title, sub].filter(Boolean).join(', ');
          const coords = Array.isArray(f?.geometry?.coordinates) ? f.geometry.coordinates : null;

          if (title && !seen.has(full.toLowerCase())) {
            seen.add(full.toLowerCase());
            suggestions.push({
              title,
              sub,
              label: full,
              lng: coords ? Number(coords[0]) : undefined,
              lat: coords ? Number(coords[1]) : undefined
            });
          }
        }
      }

      // Merge Nominatim Malaysia-only results (great for shops, restaurants, roads, tamans)
      if (nomRes.status === 'fulfilled' && nomRes.value.ok) {
        const nomData = await nomRes.value.json();
        if (Array.isArray(nomData)) {
          for (const item of nomData) {
            const cc = String(item?.address?.country_code || '').toLowerCase();
            if (cc && cc !== 'my') continue;

            const parts = String(item.display_name || '')
              .replace(/,\s*Malaysia$/i, '')
              .split(',')
              .map((s) => s.trim())
              .filter(Boolean);
            const title = parts[0] || '';
            const sub = parts.slice(1, 5).join(', ');
            const full = [title, sub].filter(Boolean).join(', ');
            if (title && !seen.has(full.toLowerCase())) {
              seen.add(full.toLowerCase());
              suggestions.push({
                title,
                sub,
                label: full,
                lat: item.lat ? Number(item.lat) : undefined,
                lng: item.lon ? Number(item.lon) : undefined
              });
            }
          }
        }
      }

      if (!signal.aborted) {
        renderAutocomplete(suggestions.slice(0, 6));
      }
    } catch (err: any) {
      if (err?.name !== 'AbortError') {
        closeAutocomplete();
      }
    } finally {
      if (!signal.aborted && locSpinner) {
        locSpinner.hidden = true;
      }
    }
  }

  locationInput?.addEventListener('input', () => {
    if (!specialSettings.enableAddressAutocomplete) {
      closeAutocomplete();
      if (locSpinner) locSpinner.hidden = true;
      return;
    }
    const q = locationInput.value.trim();
    if (acTimer) window.clearTimeout(acTimer);
    if (q.length < 2) {
      closeAutocomplete();
      if (locSpinner) locSpinner.hidden = true;
      return;
    }
    acTimer = window.setTimeout(() => searchMalaysiaPlaces(q), 240);
  });

  locationInput?.addEventListener('keydown', (e) => {
    if (!locAnchor?.classList.contains('is-open') || acResults.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      acActiveIdx = (acActiveIdx + 1) % acResults.length;
      updateAcHighlight();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      acActiveIdx = (acActiveIdx - 1 + acResults.length) % acResults.length;
      updateAcHighlight();
    } else if (e.key === 'Enter' && acActiveIdx >= 0) {
      e.preventDefault();
      selectAutocompleteItem(acResults[acActiveIdx]);
    } else if (e.key === 'Escape') {
      e.stopPropagation();
      closeAutocomplete();
    }
  });

  function updateAcHighlight() {
    locMenu?.querySelectorAll('.ac-item').forEach((el, idx) => {
