  });
  confirmDeleteModal.addEventListener('click', (e) => {
    if (e.target === confirmDeleteModal) closeDeleteModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (!confirmDiscardModal.hidden) {
        closeDiscardConfirm();
        return;
      }
      if (dpStartWrapper?.classList.contains('is-open') || dpEndWrapper?.classList.contains('is-open')) {
