      return {
        enableMapPicker: Boolean(parsed.enableMapPicker),
        enableAddressAutocomplete: parsed.enableAddressAutocomplete !== false,
        enablePickupAlerts: parsed.enablePickupAlerts !== false,
        enableAuto10Days: parsed.enableAuto10Days !== false
