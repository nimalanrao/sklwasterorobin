  function openEditModal(rec: RoroRecord) {
    closeDatePickers();
    closeAutocomplete();
    recordForm.reset();
    modalFormError.hidden = true;
    recordIdInput.value = rec.id;
    modalTitle.textContent = t('modal_edit_title');
    btnSaveText.textContent = t('btn_update');

    locationInput.value = rec.location;
    if (rec.bin_owner === OWNER_THIRUMAL) {
      ownerThirumalRadio.checked = true;
      applyOwnerSelection(OWNER_THIRUMAL, false);
    } else {
      ownerSklRadio.checked = true;
      applyOwnerSelection(OWNER_SKL, false);
      const strippedPhone = (rec.customer_phone || '').replace(/^\+?60/, '');
      phoneInput.value = strippedPhone;
    }
    priceInput.value = String(rec.price);
    dateStartInput.value = rec.date_start;
    dateEndInput.value = rec.date_end;
    syncDatePickerDisplays();
    customerInput.value = rec.customer_name || (rec.bin_owner === OWNER_THIRUMAL ? THIRUMAL_DEFAULT_NAME : '');
    notesInput.value = rec.notes || '';
    invoiceNoInput.value = rec.invoice_no ? rec.invoice_no.slice(0, 4) : '';
    if (rec.size === '4 Feet') size4Radio.checked = true;
    else size2Radio.checked = true;

    if (mapPickerCard) mapPickerCard.hidden = !specialSettings.enableMapPicker;
    modal.hidden = false;
    pushModalHistoryState();
    if (specialSettings.enableMapPicker) {
      setMapStatus('Click anywhere on the map or drag pin to update spot');
      ensureMapReady(DEPOT_LAT, DEPOT_LNG, 12, false);
    }
    window.setTimeout(() => locationInput.focus(), 50);
