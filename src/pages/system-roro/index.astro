    dateStartInput.value = todayStr;
    dateEndInput.value = computeEndDatePlus10(todayStr);
    syncDatePickerDisplays();
    ownerSklRadio.checked = true;
    applyOwnerSelection(OWNER_SKL, false);
    size2Radio.checked = true;

