  // =========================================================================
  // 2. CUSTOM PURE-WHITE BLUR CALENDAR DATE PICKER (Start & End Dates)
  // =========================================================================
  const MONTHS_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const MONTHS_FULL = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

  const dpStartWrapper = document.getElementById('dp-start-wrapper') as HTMLElement;
  const dpEndWrapper = document.getElementById('dp-end-wrapper') as HTMLElement;
  const dateStartDisplay = document.getElementById('date-start-display') as HTMLElement;
  const dateEndDisplay = document.getElementById('date-end-display') as HTMLElement;
  const calMonthStart = document.getElementById('cal-month-start') as HTMLElement;
  const calMonthEnd = document.getElementById('cal-month-end') as HTMLElement;
  const calGridStart = document.getElementById('cal-grid-start') as HTMLElement;
  const calGridEnd = document.getElementById('cal-grid-end') as HTMLElement;

  const calViewState = {
    start: { year: new Date().getFullYear(), month: new Date().getMonth() },
    end: { year: new Date().getFullYear(), month: new Date().getMonth() }
  };

  function toIsoDate(d: Date): string {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function formatPrettyDate(iso: string): string {
    if (!iso) return 'Select date';
    const parts = iso.split('-');
    if (parts.length !== 3) return iso;
    const mIdx = Math.max(0, Math.min(11, Number(parts[1]) - 1));
    return `${Number(parts[2])} ${MONTHS_SHORT[mIdx]} ${parts[0]}`;
  }

  function syncDatePickerDisplays() {
    if (dateStartDisplay) dateStartDisplay.textContent = formatPrettyDate(dateStartInput.value);
    if (dateEndDisplay) dateEndDisplay.textContent = formatPrettyDate(dateEndInput.value);
  }

  function closeDatePickers(except?: HTMLElement) {
    [dpStartWrapper, dpEndWrapper].forEach((w) => {
      if (w && w !== except) {
        w.classList.remove('is-open');
        w.querySelector('button[aria-expanded]')?.setAttribute('aria-expanded', 'false');
      }
    });
  }

  function renderCalendar(which: 'start' | 'end') {
    const state = calViewState[which];
    const monthEl = which === 'start' ? calMonthStart : calMonthEnd;
    const gridEl = which === 'start' ? calGridStart : calGridEnd;
    if (!monthEl || !gridEl) return;

    monthEl.textContent = `${MONTHS_FULL[state.month]} ${state.year}`;

    const firstDay = new Date(state.year, state.month, 1);
    const startOffset = (firstDay.getDay() + 6) % 7; // Monday = 0
    const daysInMonth = new Date(state.year, state.month + 1, 0).getDate();
    const prevMonthDays = new Date(state.year, state.month, 0).getDate();

    const todayIso = toIsoDate(new Date());
    const startVal = dateStartInput.value;
    const endVal = dateEndInput.value;
    const selectedVal = which === 'start' ? startVal : endVal;

    const cells: string[] = [];

    // Leading days from previous month
    for (let i = startOffset - 1; i >= 0; i--) {
      const d = new Date(state.year, state.month - 1, prevMonthDays - i);
      const iso = toIsoDate(d);
      cells.push(`<button type="button" class="cal-day is-outside" data-cal-pick="${which}" data-iso="${iso}">${d.getDate()}</button>`);
    }

    // Current month days
    for (let day = 1; day <= daysInMonth; day++) {
      const d = new Date(state.year, state.month, day);
      const iso = toIsoDate(d);
      const classes = ['cal-day'];
      if (iso === todayIso) classes.push('is-today');
      if (startVal && endVal && iso > startVal && iso < endVal) classes.push('is-in-range');
      if (iso === selectedVal) classes.push('is-selected');
      cells.push(`<button type="button" class="${classes.join(' ')}" data-cal-pick="${which}" data-iso="${iso}">${day}</button>`);
    }

    // Trailing days to complete 42-cell or 35-cell grid cleanly
    const remainder = cells.length % 7;
    if (remainder > 0) {
      const needed = 7 - remainder;
      for (let i = 1; i <= needed; i++) {
        const d = new Date(state.year, state.month + 1, i);
        const iso = toIsoDate(d);
        cells.push(`<button type="button" class="cal-day is-outside" data-cal-pick="${which}" data-iso="${iso}">${i}</button>`);
      }
    }

    gridEl.innerHTML = cells.join('');
  }

  function openCalendarPicker(which: 'start' | 'end') {
    const wrapper = which === 'start' ? dpStartWrapper : dpEndWrapper;
    const currentIso = which === 'start' ? dateStartInput.value : dateEndInput.value;
    const willOpen = !wrapper.classList.contains('is-open');

    closeAutocomplete();
    closeDatePickers(wrapper);

    if (willOpen) {
      const base = currentIso ? new Date(currentIso + 'T00:00:00') : new Date();
      if (!Number.isNaN(base.getTime())) {
        calViewState[which] = { year: base.getFullYear(), month: base.getMonth() };
      }
      renderCalendar(which);
      wrapper.classList.add('is-open');
      wrapper.querySelector('button[aria-expanded]')?.setAttribute('aria-expanded', 'true');
    } else {
      wrapper.classList.remove('is-open');
      wrapper.querySelector('button[aria-expanded]')?.setAttribute('aria-expanded', 'false');
    }
  }

  document.getElementById('btn-date-start')?.addEventListener('click', (e) => {
    e.stopPropagation();
    openCalendarPicker('start');
  });
  document.getElementById('btn-date-end')?.addEventListener('click', (e) => {
    e.stopPropagation();
    openCalendarPicker('end');
  });

  // Prevent popover clicks from bubbling out and closing it prematurely
  document.getElementById('cal-popover-start')?.addEventListener('click', (e) => e.stopPropagation());
  document.getElementById('cal-popover-end')?.addEventListener('click', (e) => e.stopPropagation());

  // Month Navigation
  document.querySelectorAll('[data-cal-prev]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const which = btn.getAttribute('data-cal-prev') as 'start' | 'end';
      calViewState[which].month -= 1;
      if (calViewState[which].month < 0) {
        calViewState[which].month = 11;
        calViewState[which].year -= 1;
      }
      renderCalendar(which);
    });
  });

  document.querySelectorAll('[data-cal-next]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const which = btn.getAttribute('data-cal-next') as 'start' | 'end';
      calViewState[which].month += 1;
      if (calViewState[which].month > 11) {
        calViewState[which].month = 0;
        calViewState[which].year += 1;
      }
      renderCalendar(which);
    });
  });

  // Start Date Quick Presets (Today, Tomorrow, Yesterday)
  document.querySelectorAll('[data-start-preset]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const offset = Number(btn.getAttribute('data-start-preset')) || 0;
      const d = new Date();
      d.setDate(d.getDate() + offset);
      const iso = toIsoDate(d);
      dateStartInput.value = iso;
      if (specialSettings.enableAuto10Days) {
        dateEndInput.value = computeEndDatePlus10(iso);
      }
      syncDatePickerDisplays();
      closeDatePickers();
    });
  });

  // End Date Quick Presets (+10 Days, +7 Days, +14 Days, +30 Days from Start Date)
  document.querySelectorAll('[data-end-days]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const days = Number(btn.getAttribute('data-end-days')) || 10;
      const baseStr = dateStartInput.value || toIsoDate(new Date());
      const d = new Date(baseStr + 'T00:00:00');
      d.setDate(d.getDate() + days);
      dateEndInput.value = toIsoDate(d);
      syncDatePickerDisplays();
      closeDatePickers();
    });
  });

  // Day Selection Delegation for Both Calendars
  [calGridStart, calGridEnd].forEach((grid) => {
    grid?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-cal-pick]') as HTMLElement | null;
      if (!btn) return;
      const which = btn.getAttribute('data-cal-pick') as 'start' | 'end';
      const iso = btn.getAttribute('data-iso') || '';
      if (!iso) return;

      if (which === 'start') {
        dateStartInput.value = iso;
        if (specialSettings.enableAuto10Days) {
          dateEndInput.value = computeEndDatePlus10(iso);
        }
      } else {
        dateEndInput.value = iso;
      }
      syncDatePickerDisplays();
      closeDatePickers();
    });
  });

  // Close date popovers when clicking inside modal background
  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      requestCloseModal();
    } else {
      closeDatePickers();
    }
  });

  // Modal Open / Close + Back / Cancel "Are you sure?" Confirmation
  const mapPickerCard = document.getElementById('map-picker-card') as HTMLElement | null;
  const confirmDiscardModal = document.getElementById('confirm-discard-modal') as HTMLElement;
  let modalHistoryPushed = false;

  function pushModalHistoryState() {
    if (modalHistoryPushed) return;
    try {
      window.history.pushState({ roroModalOpen: true }, '');
      modalHistoryPushed = true;
    } catch {}
  }

  function requestCloseModal() {
    if (modal.hidden) return;
    closeDatePickers();
    closeAutocomplete();
    confirmDiscardModal.hidden = false;
  }

  function closeDiscardConfirm() {
    confirmDiscardModal.hidden = true;
  }

  function applySpecialSettingsUI() {
    if (mapPickerCard) {
      mapPickerCard.hidden = !specialSettings.enableMapPicker;
    }
    if (!specialSettings.enableAddressAutocomplete) {
      closeAutocomplete();
    }
    render();
