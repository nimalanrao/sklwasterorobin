      border-radius: 0;
      border: none;
      box-shadow: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .modal-head {
      padding: 1.15rem 1.25rem 1rem;
      margin-bottom: 0;
      flex-shrink: 0;
      background: #ffffff;
      border-bottom: 1.5px solid #cbd5e1;
      position: sticky;
      top: 0;
      z-index: 25;
    }

    .modal-title {
      font-size: 1.42rem;
      font-weight: 800;
      color: #020617;
    }

    .modal-sub {
      font-size: 0.94rem;
      color: #334155;
      font-weight: 500;
    }

    .modal-form {
      overflow-y: auto;
      padding: 1.25rem 1.25rem 1.5rem;
      gap: 1.2rem;
      flex: 1;
      -webkit-overflow-scrolling: touch;
    }

    .form-label {
      font-size: 1rem;
      font-weight: 800;
      color: #020617;
    }

    .form-control,
    .prefix-field,
    .date-trigger-btn {
      height: 54px;
      font-size: 1.08rem;
      border-radius: 14px;
      border-width: 1.5px;
    }

    .prefix-input,
    .form-textarea {
      font-size: 1.08rem;
    }

    .size-card {
      padding: 0.95rem 1rem;
      border-radius: 14px;
    }

    .size-card-title {
      font-size: 1.05rem;
      font-weight: 800;
    }

    .size-card-meta {
      font-size: 0.84rem;
    }

    .modal-foot {
      position: sticky;
      bottom: 0;
      background: #ffffff;
      margin: 0.75rem -1.25rem -1.5rem;
      padding: 1rem 1.25rem calc(1.15rem + env(safe-area-inset-bottom, 0px));
      border-top: 1.5px solid #cbd5e1;
      z-index: 25;
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 0.7rem;
    }

    .modal-foot .btn-ghost,
    .modal-foot .btn-solid {
      width: 100%;
      justify-content: center;
      height: 52px;
      font-size: 1rem;
      font-weight: 800;
      border-radius: 14px;
    }

    .confirm-dialog {
      width: calc(100% - 2rem);
      max-width: 420px;
      height: auto;
      max-height: 90dvh;
      border-radius: 22px;
      border: 1.5px solid #cbd5e1;
      padding: 1.65rem 1.3rem;
      margin: auto;
      box-shadow: 0 24px 48px -12px rgba(15, 23, 42, 0.28);
    }

    .detail-head {
      padding: 1.2rem 1.25rem 1rem;
      border-bottom: 1.5px solid #cbd5e1;
      flex-shrink: 0;
    }

    .detail-loc-title {
      font-size: 1.42rem;
    }

    .detail-body {
      padding: 1.2rem 1.25rem 1.5rem;
      gap: 1.2rem;
      max-height: none;
      flex: 1;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .detail-info-val {
      font-size: 0.98rem;
    }

    .detail-price-val {
      font-size: 1.15rem;
    }

    .detail-info-sub {
      font-size: 0.84rem;
    }

    .detail-action-tile {
      min-height: 70px;
      padding: 0.9rem 0.5rem;
      font-size: 0.84rem;
      gap: 0.5rem;
    }

    .extend-opt-btn {
      height: 44px;
      font-size: 0.88rem;
    }

    .detail-foot {
      padding: 0.95rem 1.25rem 1.15rem;
    }

    .detail-foot-btn,
    .btn-danger-outline {
      height: 48px;
      font-size: 0.92rem;
    }

    .form-split {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    /* Keep custom blur calendars big, comfortable & thumb-friendly on mobile screen */
    .calendar-popover,
    .calendar-popover.cal-left,
    .calendar-popover.cal-right {
      left: 50%;
      right: auto;
      width: min(350px, calc(100vw - 1.8rem));
      min-width: 0;
      padding: 1rem 1rem 1.15rem;
      border-radius: 20px;
      transform: translateX(-50%) translateY(8px) scale(0.96);
      transform-origin: bottom center;
      box-shadow:
        0 24px 50px -12px rgba(15, 23, 42, 0.25),
        0 0 0 1px rgba(226, 232, 240, 0.95);
    }

    .dropdown-anchor.is-open .calendar-popover {
      transform: translateX(-50%) translateY(0) scale(1);
    }

    .cal-presets {
      gap: 0.45rem;
      margin-bottom: 0.85rem;
      padding-bottom: 0.75rem;
    }

    .cal-preset-pill {
      height: 34px;
      padding: 0 0.85rem;
      font-size: 0.82rem;
      border-radius: 9px;
    }

    .cal-nav-row {
      margin-bottom: 0.75rem;
    }

    .cal-month-label {
      font-size: 1.05rem;
    }

    .cal-nav-btn {
      width: 38px;
      height: 38px;
      border-radius: 11px;
    }

    .cal-nav-btn svg {
      width: 17px;
      height: 17px;
    }

    .cal-weekdays {
      margin-bottom: 0.45rem;
    }

    .cal-weekdays span {
      font-size: 0.82rem;
      font-weight: 800;
      padding: 0.25rem 0;
    }

    .cal-days-grid {
      gap: 4px;
    }

    :global(.cal-day) {
      height: 42px;
      font-size: 0.98rem;
      font-weight: 700;
      border-radius: 11px;
    }

    .toast-bar {
      left: 12px;
      right: 12px;
      bottom: 14px;
      justify-content: center;
    }
  }

  @media (max-width: 400px) {
    .size-toggle-grid {
      gap: 0.4rem;
    }

    .size-card {
      padding: 0.45rem 0.55rem;
    }

    .size-card-title {
      font-size: 0.78rem;
    }
  }

