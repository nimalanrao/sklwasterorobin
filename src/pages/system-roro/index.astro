  /* ==========================================================================
     MODALS (Clean White + Frosted Glass Blur Backdrop)
     ========================================================================== */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(15, 23, 42, 0.32);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    animation: overlayFade 0.2s ease;
  }

  .modal-overlay[hidden] {
    display: none;
  }

  @keyframes overlayFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .modal-dialog {
    width: 100%;
    max-width: 580px;
    max-height: 92vh;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 22px;
    padding: 1.75rem 1.85rem;
    box-shadow: 0 28px 60px -16px rgba(15, 23, 42, 0.24);
    animation: dialogBlurIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes dialogBlurIn {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(12px) scale(0.97);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0) scale(1);
    }
  }

  .modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 1.15rem;
  }

  .modal-title {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #0f172a;
  }

  .modal-sub {
    font-size: 0.8rem;
    color: #64748b;
    margin-top: 0.2rem;
  }

  .icon-close-btn {
    width: 34px;
    height: 34px;
    border: 1px solid #e5e7eb;
    background: #ffffff;
    color: #64748b;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .icon-close-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .modal-error-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    border-radius: 10px;
    padding: 0.6rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .modal-error-bar[hidden] {
    display: none;
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  .form-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  .form-label {
