  // =========================================================================
  // PASSWORD-PROTECTED SPECIAL SETTINGS CONTROLLER (Password: admin1234)
  // =========================================================================
  const settingsModal = document.getElementById('settings-modal') as HTMLElement;
  const settingsHeadIcon = document.getElementById('settings-head-icon') as HTMLElement;
  const settingsModalSub = document.getElementById('settings-modal-sub') as HTMLElement;
  const settingsLockView = document.getElementById('settings-lock-view') as HTMLFormElement;
  const settingsPanelView = document.getElementById('settings-panel-view') as HTMLElement;
  const settingsPasswordInput = document.getElementById('settings-password-input') as HTMLInputElement;
  const settingsErrorBar = document.getElementById('settings-error-bar') as HTMLElement;
  const toggleMapPicker = document.getElementById('toggle-map-picker') as HTMLInputElement;
  const toggleAddressAc = document.getElementById('toggle-address-ac') as HTMLInputElement;
  const togglePickupAlerts = document.getElementById('toggle-pickup-alerts') as HTMLInputElement;
  const toggleAuto10Days = document.getElementById('toggle-auto-10days') as HTMLInputElement;

  function syncSettingsTogglesUI() {
    if (toggleMapPicker) toggleMapPicker.checked = specialSettings.enableMapPicker;
    if (toggleAddressAc) toggleAddressAc.checked = specialSettings.enableAddressAutocomplete;
    if (togglePickupAlerts) togglePickupAlerts.checked = specialSettings.enablePickupAlerts;
    if (toggleAuto10Days) toggleAuto10Days.checked = specialSettings.enableAuto10Days;
  }

  function openSettingsModal() {
    closeMobileSidebar();
    closeAllDropdowns();
    settingsLockView.reset();
    settingsErrorBar.hidden = true;
    settingsLockView.hidden = false;
    settingsPanelView.hidden = true;
    settingsHeadIcon?.classList.remove('unlocked');
    if (settingsModalSub) settingsModalSub.textContent = 'Enter password to unlock controls';
    syncSettingsTogglesUI();
    settingsModal.hidden = false;
    window.setTimeout(() => settingsPasswordInput?.focus(), 60);
  }

  function closeSettingsModal() {
    settingsModal.hidden = true;
    settingsLockView.reset();
    settingsErrorBar.hidden = true;
  }

  document.getElementById('btn-open-settings-nav')?.addEventListener('click', openSettingsModal);
  document.getElementById('btn-open-settings-menu')?.addEventListener('click', openSettingsModal);
  document.getElementById('btn-close-settings')?.addEventListener('click', closeSettingsModal);
  document.getElementById('btn-cancel-settings-lock')?.addEventListener('click', closeSettingsModal);
  document.getElementById('btn-done-settings')?.addEventListener('click', closeSettingsModal);

  settingsModal?.addEventListener('click', (e) => {
    if (e.target === settingsModal) closeSettingsModal();
  });

  settingsPasswordInput?.addEventListener('input', () => {
    settingsErrorBar.hidden = true;
  });

  settingsLockView?.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = settingsPasswordInput.value;
    if (val === SETTINGS_PASSCODE) {
      settingsErrorBar.hidden = true;
      settingsLockView.hidden = true;
      settingsPanelView.hidden = false;
      settingsHeadIcon?.classList.add('unlocked');
      if (settingsModalSub) settingsModalSub.textContent = 'Enable or disable special system features';
      syncSettingsTogglesUI();
    } else {
      settingsErrorBar.hidden = false;
      settingsPasswordInput.select();
    }
  });

  toggleMapPicker?.addEventListener('change', () => {
    specialSettings.enableMapPicker = toggleMapPicker.checked;
    saveSpecialSettings(specialSettings);
    applySpecialSettingsUI();
    showToast(specialSettings.enableMapPicker ? 'Interactive Map Picker enabled' : 'Interactive Map Picker disabled');
  });

  toggleAddressAc?.addEventListener('change', () => {
    specialSettings.enableAddressAutocomplete = toggleAddressAc.checked;
    saveSpecialSettings(specialSettings);
    applySpecialSettingsUI();
    showToast(specialSettings.enableAddressAutocomplete ? 'Malaysia Address Autocomplete enabled' : 'Address Autocomplete disabled');
  });

  togglePickupAlerts?.addEventListener('change', () => {
    specialSettings.enablePickupAlerts = togglePickupAlerts.checked;
    saveSpecialSettings(specialSettings);
    applySpecialSettingsUI();
    showToast(specialSettings.enablePickupAlerts ? 'Pickup alerts enabled' : 'Pickup alerts disabled');
  });

  toggleAuto10Days?.addEventListener('change', () => {
    specialSettings.enableAuto10Days = toggleAuto10Days.checked;
    saveSpecialSettings(specialSettings);
    showToast(specialSettings.enableAuto10Days ? 'Auto +10 Days End Date enabled' : 'Auto +10 Days End Date disabled');
  });

  document.getElementById('btn-reset-settings')?.addEventListener('click', () => {
    specialSettings = { ...DEFAULT_SETTINGS };
    saveSpecialSettings(specialSettings);
    syncSettingsTogglesUI();
    applySpecialSettingsUI();
    showToast('Special settings reset to defaults');
  });

  // Clear validation alert when typing phone
  phoneInput.addEventListener('input', () => {
    modalFormError.hidden = true;
  });

  // Submit Add / Edit Record (Strict Required Phone Validation + Owner Auto-Enforce)
  recordForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    modalFormError.hidden = true;

    const editingId = recordIdInput.value.trim();
    const loc = locationInput.value.trim();
    const ownerVal: BinOwner = ownerThirumalRadio.checked ? OWNER_THIRUMAL : OWNER_SKL;
    const rawPhone = ownerVal === OWNER_THIRUMAL ? THIRUMAL_PHONE_NORMALIZED : phoneInput.value.trim();
    const normalizedPhone = ownerVal === OWNER_THIRUMAL ? THIRUMAL_PHONE_NORMALIZED : normalizeMalaysianPhone(rawPhone);
    const localDigits = normalizedPhone.replace(/^\+60/, '');

    if (!loc) {
      modalFormErrorText.textContent = 'Delivery location is required.';
      modalFormError.hidden = false;
      locationInput.focus();
      return;
    }

    if (!normalizedPhone || localDigits.length < 8 || localDigits.length > 11) {
      modalFormErrorText.textContent = 'Phone number is required. Please enter a valid Malaysian number (e.g., 16-615 9365).';
      modalFormError.hidden = false;
      phoneInput.focus();
      return;
    }

    const priceVal = Number(priceInput.value) || 0;
    const startVal = dateStartInput.value;
    const endVal = dateEndInput.value || computeEndDatePlus10(startVal);
    const rawCust = customerInput.value.trim();
    const custVal = ownerVal === OWNER_THIRUMAL ? (rawCust || THIRUMAL_DEFAULT_NAME) : rawCust;
    const noteVal = notesInput.value.trim();
    const invoiceVal = invoiceNoInput.value.replace(/\D/g, '').slice(0, 4);
    if (invoiceVal && invoiceVal.length !== 4) {
      modalFormErrorText.textContent = currentLang === 'ms'
        ? 'No Invois mesti tepat 4 digit (cth. 1024).'
        : 'Invoice number must be exactly 4 digits (e.g. 1024).';
      modalFormError.hidden = false;
      invoiceNoInput.focus();
      return;
    }
    const sizeVal: '2 Feet' | '4 Feet' = size4Radio.checked ? '4 Feet' : '2 Feet';
    const { isOverdue } = getDaysRemaining(endVal);

    if (editingId) {
      const existing = allRecords.find((r) => r.id === editingId);
      const updated: RoroRecord = {
        id: editingId,
        created_at: existing?.created_at || new Date().toISOString(),
        location: loc,
        bin_owner: ownerVal,
        invoice_no: invoiceVal || undefined,
        customer_phone: normalizedPhone,
        size: sizeVal,
        price: priceVal,
        date_start: startVal,
        date_end: endVal,
        customer_name: custVal || undefined,
        notes: noteVal || undefined,
        status: existing?.status === 'Completed' ? 'Completed' : (isOverdue ? 'Overdue' : 'Active'),
        completed_at: existing?.completed_at || null
      };

      allRecords = allRecords.map((r) => (r.id === editingId ? updated : r));
      closeModal();
      render();
      firePickupDesktopNotifications(false);
      const res = await updateRoroRecord(updated);
      showToast(res.synced ? 'Record updated in Supabase' : 'Record updated successfully');
    } else {
      const created: RoroRecord = {
        id: `roro-${Date.now()}`,
        created_at: new Date().toISOString(),
        location: loc,
        bin_owner: ownerVal,
        invoice_no: invoiceVal || undefined,
        customer_phone: normalizedPhone,
        size: sizeVal,
        price: priceVal,
        date_start: startVal,
        date_end: endVal,
        customer_name: custVal || undefined,
        notes: noteVal || undefined,
        status: isOverdue ? 'Overdue' : 'Active',
        completed_at: null
      };

      allRecords = [created, ...allRecords];
      closeModal();
      if (filterStatus === 'completed') {
        selectNavView('all');
      } else {
        render();
      }
      firePickupDesktopNotifications(false);
      const res = await createRoroRecord(created);
      showToast(res.synced ? 'New bin saved to Supabase' : 'New bin record saved');
    }
  });

  // Confirm Mark Pulled -> Moves to Completed Section
  document.getElementById('btn-cancel-pull')?.addEventListener('click', closePullModal);
  document.getElementById('btn-execute-pull')?.addEventListener('click', async () => {
    if (!pendingPullId) return;
    const rec = allRecords.find((r) => r.id === pendingPullId);
    closePullModal();
    if (!rec) return;

    const completedRecord: RoroRecord = {
      ...rec,
      status: 'Completed',
      completed_at: new Date().toISOString()
    };

    allRecords = allRecords.map((r) => (r.id === rec.id ? completedRecord : r));
    render();
    const res = await updateRoroRecord(completedRecord);
    showToast(res.synced ? 'Moved to Completed (Supabase synced)' : 'Moved to Completed section');
  });

  // Confirm Permanent Delete (from Completed Section)
  document.getElementById('btn-cancel-delete')?.addEventListener('click', closeDeleteModal);
  document.getElementById('btn-execute-delete')?.addEventListener('click', async () => {
    if (!pendingDeleteId) return;
    const idToDelete = pendingDeleteId;
    allRecords = allRecords.filter((r) => r.id !== idToDelete);
    closeDeleteModal();
    render();
    const res = await deleteRoroRecord(idToDelete);
    showToast(res.synced ? 'Deleted permanently from Supabase' : 'Record permanently deleted');
  });

  // Search Input
  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value.trim();
    render();
  });

  // Dropdown System (Animated Blur Effect)
  const dropdownAnchors = [
    document.getElementById('admin-dropdown-wrapper'),
    document.getElementById('notif-dropdown-wrapper'),
    document.getElementById('filter-owner-wrapper'),
    document.getElementById('filter-size-wrapper'),
    document.getElementById('filter-status-wrapper'),
    document.getElementById('filter-sort-wrapper')
  ].filter(Boolean) as HTMLElement[];

  function closeAllDropdowns(except?: HTMLElement) {
    for (const anchor of dropdownAnchors) {
      if (anchor !== except) {
        anchor.classList.remove('is-open');
        const trigger = anchor.querySelector('button[aria-expanded]');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      }
    }
  }

  function wireDropdown(wrapperId: string, triggerId: string) {
    const wrapper = document.getElementById(wrapperId);
    const trigger = document.getElementById(triggerId);
    if (!wrapper || !trigger) return;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = !wrapper.classList.contains('is-open');
      closeAllDropdowns(wrapper);
      wrapper.classList.toggle('is-open', willOpen);
      trigger.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    });
  }

  wireDropdown('admin-dropdown-wrapper', 'btn-admin-dropdown');
  wireDropdown('notif-dropdown-wrapper', 'btn-notif-bell');
  wireDropdown('filter-owner-wrapper', 'btn-filter-owner');
  wireDropdown('filter-size-wrapper', 'btn-filter-size');
  wireDropdown('filter-status-wrapper', 'btn-filter-status');
  wireDropdown('filter-sort-wrapper', 'btn-filter-sort');

  // Keep notification panel open when clicking inside it
  document.getElementById('notif-dropdown-menu')?.addEventListener('click', (e) => e.stopPropagation());
  document.addEventListener('click', () => {
    closeAllDropdowns();
  });

  // Sync Filter Dropdowns + Sidebar Nav
  function syncFilterUI() {
    const ownerLabel = document.getElementById('filter-owner-label');
    if (ownerLabel) {
      if (filterOwner === 'all') ownerLabel.textContent = t('filter_owners');
      else if (filterOwner === OWNER_THIRUMAL) ownerLabel.textContent = 'Thirumal Vel Ent.';
      else ownerLabel.textContent = 'SKL Waste';
    }
    document.querySelectorAll('[data-owner-filter]').forEach((el) => {
      el.classList.toggle('active', el.getAttribute('data-owner-filter') === filterOwner);
    });

    const sizeLabel = document.getElementById('filter-size-label');
    if (sizeLabel) {
      if (filterSize === 'all') sizeLabel.textContent = t('filter_all_sizes');
      else if (filterSize === '2 Feet') sizeLabel.textContent = t('size_2ft');
      else if (filterSize === '4 Feet') sizeLabel.textContent = t('size_4ft');
      else sizeLabel.textContent = filterSize;
    }
    document.querySelectorAll('[data-size-filter]').forEach((el) => {
      el.classList.toggle('active', el.getAttribute('data-size-filter') === filterSize);
    });

    const statusLabel = document.getElementById('filter-status-label');
    if (statusLabel) {
      if (filterStatus === 'all_active') statusLabel.textContent = t('kpi_active');
      else if (filterStatus === 'within_10') statusLabel.textContent = t('nav_active');
      else if (filterStatus === 'overdue') statusLabel.textContent = t('nav_overdue');
      else statusLabel.textContent = t('nav_completed');
    }
    document.querySelectorAll('[data-status-filter]').forEach((el) => {
      el.classList.toggle('active', el.getAttribute('data-status-filter') === filterStatus);
    });
  }

  function triggerTabBlurSlideLeft() {
    const targets = [headerCopyEl, tableCardEl].filter(Boolean) as HTMLElement[];
    for (const el of targets) {
      el.classList.remove('tab-animate-left');
      // Force reflow so rapid tab switches always replay smoothly
      void el.offsetWidth;
      el.classList.add('tab-animate-left');
    }
  }

  let currentNavView = 'all';

  function selectNavView(view: string) {
    currentNavView = view;
    document.querySelectorAll('[data-nav-view]').forEach((b) => {
      b.classList.toggle('active', b.getAttribute('data-nav-view') === view);
    });

    // Show the 3 KPI summary cards ONLY on "All Active Bins"
    if (kpiSummaryStrip) {
      kpiSummaryStrip.hidden = view !== 'all';
    }

    if (view === 'all') {
      filterOwner = 'all';
      filterSize = 'all';
      filterStatus = 'all_active';
      workspaceHeading.textContent = t('heading_all');
      workspaceSubtitle.textContent = t('sub_all');
    } else if (view === 'active') {
      filterOwner = 'all';
      filterSize = 'all';
      filterStatus = 'within_10';
      workspaceHeading.textContent = t('heading_active');
      workspaceSubtitle.textContent = t('sub_active');
    } else if (view === 'overdue') {
      filterOwner = 'all';
      filterSize = 'all';
      filterStatus = 'overdue';
      workspaceHeading.textContent = t('heading_overdue');
      workspaceSubtitle.textContent = t('sub_overdue');
    } else if (view === 'completed') {
      filterOwner = 'all';
      filterSize = 'all';
      filterStatus = 'completed';
      workspaceHeading.textContent = t('heading_completed');
      workspaceSubtitle.textContent = t('sub_completed');
    } else if (view === 'owner_skl') {
      filterOwner = OWNER_SKL;
      filterSize = 'all';
      filterStatus = 'all_active';
      workspaceHeading.textContent = t('heading_skl');
      workspaceSubtitle.textContent = t('sub_skl');
    } else if (view === 'owner_thirumal') {
      filterOwner = OWNER_THIRUMAL;
      filterSize = 'all';
      filterStatus = 'all_active';
      workspaceHeading.textContent = t('heading_thirumal');
      workspaceSubtitle.textContent = t('sub_thirumal');
    } else if (view === '2ft') {
      filterOwner = 'all';
      filterSize = '2 Feet';
      filterStatus = 'all_active';
      workspaceHeading.textContent = t('heading_2ft');
      workspaceSubtitle.textContent = t('sub_2ft');
    } else if (view === '4ft') {
      filterOwner = 'all';
      filterSize = '4 Feet';
      filterStatus = 'all_active';
      workspaceHeading.textContent = t('heading_4ft');
      workspaceSubtitle.textContent = t('sub_4ft');
    }

    syncFilterUI();
    closeMobileSidebar();
    render();
    triggerTabBlurSlideLeft();
  }

  document.querySelectorAll('[data-owner-filter]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      filterOwner = btn.getAttribute('data-owner-filter') || 'all';
      syncFilterUI();
      closeAllDropdowns();
      render();
    });
  });

  document.querySelectorAll('[data-size-filter]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      filterSize = btn.getAttribute('data-size-filter') || 'all';
      syncFilterUI();
      closeAllDropdowns();
      render();
    });
  });

  document.querySelectorAll('[data-status-filter]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const next = (btn.getAttribute('data-status-filter') || 'all_active') as typeof filterStatus;
      if (next === 'completed') selectNavView('completed');
      else if (next === 'within_10') selectNavView('active');
      else if (next === 'overdue') selectNavView('overdue');
      else selectNavView('all');
      closeAllDropdowns();
    });
  });

  document.querySelectorAll('[data-sort-filter]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      sortMode = btn.getAttribute('data-sort-filter') || 'newest';
      const label = document.getElementById('filter-sort-label');
      if (label) {
        if (sortMode === 'due_soon') label.textContent = 'Ending Soonest';
        else if (sortMode === 'price_desc') label.textContent = 'Highest Price';
        else label.textContent = 'Newest';
      }
      document.querySelectorAll('[data-sort-filter]').forEach((el) => {
        el.classList.toggle('active', el.getAttribute('data-sort-filter') === sortMode);
      });
      closeAllDropdowns();
      render();
    });
  });

  document.querySelectorAll('[data-nav-view]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const view = btn.getAttribute('data-nav-view') || 'all';
      selectNavView(view);
    });
  });

  // Mobile Sidebar Controls
  function openMobileSidebar() {
    sidebar?.classList.add('is-open');
    if (sidebarBackdrop) sidebarBackdrop.hidden = false;
  }

  function closeMobileSidebar() {
    sidebar?.classList.remove('is-open');
    if (sidebarBackdrop) sidebarBackdrop.hidden = true;
  }

  btnOpenSidebar?.addEventListener('click', openMobileSidebar);
  btnCloseSidebar?.addEventListener('click', closeMobileSidebar);
  sidebarBackdrop?.addEventListener('click', closeMobileSidebar);

  // Sync Refresh, SQL Copy & JSON Export
  btnRefreshSync?.addEventListener('click', () => loadRecords(false));
  btnBrandRefresh?.addEventListener('click', () => loadRecords(false));

  btnCopySql?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(SUPABASE_SETUP_SQL);
      showToast('SQL copied! Paste into Supabase SQL Editor.');
    } catch {
      showToast('See public/system_roro_schema.sql for table SQL');
    }
  });

  document.getElementById('btn-export-json')?.addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(allRecords, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `system_roro_${new Date().toISOString().split('T')[0]}.json`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    closeAllDropdowns();
    showToast('JSON export downloaded');
  });

  // Logout (Left Sidebar Quick Button & Blur Dropdown)
  function performLogout() {
    try {
      sessionStorage.removeItem('skl_system_roro_auth');
      sessionStorage.removeItem('skl_system_roro_user');
      sessionStorage.removeItem('skl_system_roro_login_at');
    } catch (e) {}
    window.location.replace('/system-roro/login');
  }

  document.getElementById('btn-menu-logout')?.addEventListener('click', performLogout);

  // Periodic background pickup check every 60 seconds
  window.setInterval(() => {
    render();
    firePickupDesktopNotifications(false);
  }, 60000);

  // Theme (Light / Dark) Controller
  const THEME_STORAGE_KEY = 'skl_system_roro_theme_v1';
  type ThemeKey = 'light' | 'dark';
  let currentTheme: ThemeKey = (localStorage.getItem(THEME_STORAGE_KEY) as ThemeKey) === 'dark' ? 'dark' : 'light';

  function applyTheme(theme: ThemeKey) {
    currentTheme = theme;
    try {
      localStorage.setItem(THEME_STORAGE_KEY, theme);
    } catch {}
    if (theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    document.getElementById('btn-theme-light')?.classList.toggle('active', theme === 'light');
    document.getElementById('btn-theme-dark')?.classList.toggle('active', theme === 'dark');
  }

  document.getElementById('btn-theme-light')?.addEventListener('click', () => {
    applyTheme('light');
    showToast(t('toast_theme_light'));
  });
  document.getElementById('btn-theme-dark')?.addEventListener('click', () => {
    applyTheme('dark');
    showToast(t('toast_theme_dark'));
  });

  document.getElementById('btn-lang-en')?.addEventListener('click', () => {
    applyLanguage('en');
    showToast(t('toast_lang_switched'));
  });
  document.getElementById('btn-lang-ms')?.addEventListener('click', () => {
    applyLanguage('ms');
    showToast(t('toast_lang_switched'));
  });

  // Enforce digits-only (exactly 4 digits) on INV NO input
  invoiceNoInput?.addEventListener('input', () => {
    const cleaned = invoiceNoInput.value.replace(/\D/g, '').slice(0, 4);
    if (invoiceNoInput.value !== cleaned) {
      invoiceNoInput.value = cleaned;
    }
  });

  // Initial Load
  applyTheme(currentTheme);
  applyLanguage(currentLang);
  updateNotificationPermissionUI();
  loadRecords(true);
</script>
