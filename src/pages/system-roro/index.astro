  const toastBar = document.getElementById('toast-bar');
  const toastMessage = document.getElementById('toast-message');

  function showToast(msg: string) {
    if (!toastBar || !toastMessage) return;
    toastMessage.textContent = msg;
    toastBar.hidden = false;
    if (toastTimer) window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toastBar.hidden = true;
    }, 3200);
  }

  function escapeHtml(str: string): string {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatDateDisplay(iso: string): string {
    if (!iso) return '-';
    const datePart = iso.split('T')[0];
    const parts = datePart.split('-');
    if (parts.length !== 3) return iso;
    return `${parts[2]}/${parts[1]}/${parts[0]}`;
  }

  function getDaysRemaining(endDateStr: string): { daysLeft: number; needsPickup: boolean; isOverdue: boolean } {
    const end = new Date(endDateStr + 'T00:00:00');
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const diffMs = end.getTime() - today.getTime();
    const daysLeft = Math.ceil(diffMs / 86400000);
    return {
      daysLeft,
      isOverdue: daysLeft < 0,
      needsPickup: daysLeft <= 0
    };
  }

  function computeEndDatePlus10(startStr: string): string {
    if (!startStr) return '';
    const d = new Date(startStr + 'T00:00:00');
    if (Number.isNaN(d.getTime())) return '';
    d.setDate(d.getDate() + 10);
    return d.toISOString().split('T')[0];
  }

  // --- BROWSER DESKTOP NOTIFICATIONS (Web Notifications API) ---
  function updateNotificationPermissionUI() {
    if (typeof window === 'undefined' || !('Notification' in window)) {
      if (btnEnableBrowserNotif) btnEnableBrowserNotif.style.display = 'none';
      if (btnBannerEnableNotif) btnBannerEnableNotif.style.display = 'none';
      return;
    }

    const perm = Notification.permission;
    if (perm === 'granted') {
      btnEnableBrowserNotif?.classList.add('granted');
      if (browserNotifLabel) browserNotifLabel.textContent = 'Alerts On';
      if (bannerNotifLabel) bannerNotifLabel.textContent = 'Desktop Alerts On';
    } else if (perm === 'denied') {
      if (browserNotifLabel) browserNotifLabel.textContent = 'Blocked';
      if (bannerNotifLabel) bannerNotifLabel.textContent = 'Alerts Blocked';
    } else {
      btnEnableBrowserNotif?.classList.remove('granted');
      if (browserNotifLabel) browserNotifLabel.textContent = 'Enable Alerts';
      if (bannerNotifLabel) bannerNotifLabel.textContent = 'Notify Desktop';
    }
  }

  async function requestDesktopNotifications() {
    if (typeof window === 'undefined' || !('Notification' in window)) {
      showToast('Browser notifications are not supported on this device');
      return;
    }
    if (Notification.permission === 'granted') {
      firePickupDesktopNotifications(true);
      showToast('Desktop pickup notifications are active');
      return;
    }
    if (Notification.permission === 'denied') {
      showToast('Notifications blocked in browser settings. Please allow them.');
      return;
    }
    const perm = await Notification.requestPermission();
    updateNotificationPermissionUI();
    if (perm === 'granted') {
      showToast('Desktop pickup notifications enabled');
      firePickupDesktopNotifications(true);
    }
  }

  function firePickupDesktopNotifications(force = false) {
    if (!specialSettings.enablePickupAlerts) return;
    if (typeof window === 'undefined' || !('Notification' in window)) return;
    if (Notification.permission !== 'granted') return;

    const dueBins = allRecords.filter((r) => r.status !== 'Completed' && getDaysRemaining(r.date_end).needsPickup);
    if (dueBins.length === 0) return;

    const toAlert = force ? dueBins : dueBins.filter((r) => !notifiedIds.has(r.id));
    if (toAlert.length === 0) return;

    toAlert.forEach((r) => notifiedIds.add(r.id));

    if (toAlert.length === 1) {
      const bin = toAlert[0];
      const { daysLeft } = getDaysRemaining(bin.date_end);
      const timing = daysLeft < 0 ? `Overdue by ${Math.abs(daysLeft)} day(s)` : 'Due for pickup today';
      new Notification(`RORO Pickup Needed: ${bin.location}`, {
        body: `${timing} • ${bin.size} • ${formatPhoneDisplay(bin.customer_phone)}`,
        icon: '/images/skl-logo.png',
        tag: `roro-pickup-${bin.id}`
      });
    } else {
      new Notification(`${toAlert.length} RORO Bins Need Pickup Now`, {
        body: toAlert.slice(0, 3).map((b) => `• ${b.location} (${b.size})`).join('\n'),
        icon: '/images/skl-logo.png',
        tag: 'roro-pickup-batch'
      });
    }
  }

  btnEnableBrowserNotif?.addEventListener('click', (e) => {
    e.stopPropagation();
    requestDesktopNotifications();
  });
  btnBannerEnableNotif?.addEventListener('click', () => requestDesktopNotifications());
  document.getElementById('btn-banner-view-due')?.addEventListener('click', () => selectNavView('overdue'));

  // Update Notification Bell & Banner UI
  function renderPickupNotifications(dueBins: RoroRecord[]) {
    const count = dueBins.length;

    // Tab title cue so admin sees alert even in another browser tab
    document.title = count > 0
      ? `(${count} Pickup Needed) System RORO | SKL Waste`
      : 'System RORO Dashboard | SKL Waste Sdn Bhd';

    // Bell Badge
    if (notifBadgeCount && btnNotifBell) {
      if (count > 0) {
        notifBadgeCount.textContent = String(count);
        notifBadgeCount.hidden = false;
        btnNotifBell.classList.add('has-alerts');
      } else {
        notifBadgeCount.hidden = true;
        btnNotifBell.classList.remove('has-alerts');
      }
    }

    // Banner
    if (pickupAlertBanner && alertBannerTitle && alertBannerDesc) {
      if (count > 0 && specialSettings.enablePickupAlerts) {
        pickupAlertBanner.hidden = false;
        alertBannerTitle.textContent = count === 1
          ? '1 Bin Needs Pull'
          : `${count} Bins Need Pull`;
        const preview = dueBins.slice(0, 2).map((b) => b.location).join(' • ');
        alertBannerDesc.textContent = count > 2
          ? `${preview} +${count - 2} more`
          : preview;
      } else {
        pickupAlertBanner.hidden = true;
      }
    }

    // Notification Dropdown List
    if (notifPanelSub) {
      notifPanelSub.textContent = count > 0
        ? `${count} bin${count > 1 ? 's' : ''} ready for pull`
        : 'All bins on schedule';
    }

    if (!notifListBody) return;
    if (count === 0) {
      notifListBody.innerHTML = `<div class="notif-empty">No pulls needed.</div>`;
      return;
    }

    notifListBody.innerHTML = dueBins
      .map((item) => {
        const { daysLeft } = getDaysRemaining(item.date_end);
        const tagText = daysLeft < 0 ? `Overdue ${Math.abs(daysLeft)}d` : 'Due Today';
        const waUrl = buildWhatsAppUrl(item);
        const phoneStr = formatPhoneDisplay(item.customer_phone);

        return `
          <div class="notif-item-card">
            <div class="notif-item-top">
              <span class="notif-item-loc">${escapeHtml(item.location)}</span>
              <span class="notif-item-tag">${tagText}</span>
            </div>
            <div class="notif-item-meta">
              ${escapeHtml(item.bin_owner)} &bull; ${escapeHtml(item.size)} &bull; ${item.customer_name ? `${escapeHtml(item.customer_name)} &bull; ` : ''}${escapeHtml(phoneStr)}
            </div>
            <div class="notif-item-actions">
              ${waUrl ? `
                <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="notif-wa-link">
                  ${WA_SVG_ICON}
                  <span>WhatsApp</span>
                </a>
              ` : ''}
              <button type="button" class="notif-pull-btn" data-notif-copy-id="${escapeHtml(item.id)}" title="Copy driver dispatch + Waze">
                Copy Driver
              </button>
              <button type="button" class="notif-pull-btn" data-notif-pull-id="${escapeHtml(item.id)}" data-notif-pull-loc="${escapeHtml(item.location)}">
                Mark Pulled
              </button>
            </div>
          </div>
        `;
      })
      .join('');
  }

  // Handle Copy Driver & Mark Pulled clicks inside Notification Dropdown
  notifListBody?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const copyBtn = target.closest('[data-notif-copy-id]') as HTMLElement | null;
    if (copyBtn) {
      e.stopPropagation();
      const id = copyBtn.getAttribute('data-notif-copy-id');
      const rec = allRecords.find((r) => r.id === id);
      if (rec) {
        await copyDriverInfo(rec, copyBtn);
      }
      return;
    }

    const pullBtn = target.closest('[data-notif-pull-id]') as HTMLElement | null;
    if (pullBtn) {
      e.stopPropagation();
      const id = pullBtn.getAttribute('data-notif-pull-id');
      const loc = pullBtn.getAttribute('data-notif-pull-loc') || 'this location';
      if (id) {
        closeAllDropdowns();
        pendingPullId = id;
        confirmPullLocation.textContent = loc;
        confirmPullModal.hidden = false;
      }
    }
  });

  async function copyTextToClipboard(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
        return true;
      } catch {
        return false;
      }
    }
  }

  async function copyDriverInfo(rec: RoroRecord, btnEl?: HTMLElement | null) {
    const text = buildDriverDispatchText(rec);
    const ok = await copyTextToClipboard(text);
    if (ok) {
      showToast('Driver info + Waze link copied! Ready to paste in WhatsApp.');
      if (btnEl) {
        btnEl.classList.add('copied');
        const span = btnEl.querySelector('span');
        const originalText = span ? span.textContent : btnEl.textContent;
        if (span) span.textContent = 'Copied';
        else btnEl.textContent = 'Copied';
        window.setTimeout(() => {
          btnEl.classList.remove('copied');
          if (span && originalText) span.textContent = originalText;
          else if (originalText) btnEl.textContent = originalText;
        }, 1600);
      }
    } else {
      showToast('Unable to copy automatically');
    }
  }

  // Full-Screen Server Disconnected Red Error Overlay
  const serverDisconnectedScreen = document.getElementById('server-disconnected-screen');
  const btnServerRetry = document.getElementById('btn-server-retry');

  btnServerRetry?.addEventListener('click', async () => {
    btnServerRetry.classList.add('spinning');
    await loadRecords(false);
    btnServerRetry.classList.remove('spinning');
  });

  // Load Data from Supabase (with seamless Local Cache fallback)
  async function loadRecords(silent = true) {
    if (btnRefreshSync) btnRefreshSync.classList.add('spinning');
    if (btnBrandRefresh) btnBrandRefresh.classList.add('spinning');
    const result = await fetchAllRecords();
    allRecords = result.records;

    const isConnected = result.source === 'supabase';

    if (serverDisconnectedScreen) {
      if (isConnected) {
        // Connected: Keep red screen hidden
        serverDisconnectedScreen.hidden = true;
      } else {
        // NOT connected: Show full-screen red error overlay
        serverDisconnectedScreen.hidden = false;
      }
    }

    if (btnRefreshSync) {
      window.setTimeout(() => btnRefreshSync.classList.remove('spinning'), 350);
    }
    if (btnBrandRefresh) {
      window.setTimeout(() => btnBrandRefresh.classList.remove('spinning'), 350);
    }
    render();
    firePickupDesktopNotifications(false);
    if (!silent && isConnected) {
      showToast('Synced with Supabase Cloud');
    }
  }

  // Render Dashboard Table, KPIs, Notifications & Sidebar Counters
  function render() {
    let activeTotal = 0;
    let within10Count = 0;
    let needsPickupCount = 0;
    let completedCount = 0;
    let countOwnerSkl = 0;
    let countOwnerThirumal = 0;
    let count2ft = 0;
    let count4ft = 0;
    let activeRevenue = 0;
    const dueBins: RoroRecord[] = [];

    for (const r of allRecords) {
      if (r.status === 'Completed') {
        completedCount++;
        continue;
      }
      activeTotal++;
      const { needsPickup } = getDaysRemaining(r.date_end);
      if (needsPickup) {
        needsPickupCount++;
        dueBins.push(r);
      } else {
        within10Count++;
      }
      if (r.bin_owner === OWNER_THIRUMAL) countOwnerThirumal++;
      else countOwnerSkl++;
      if (r.size === '2 Feet') count2ft++;
      else count4ft++;
      activeRevenue += Number(r.price) || 0;
    }

    // Sort dueBins with most overdue first
    dueBins.sort((a, b) => new Date(a.date_end).getTime() - new Date(b.date_end).getTime());
    renderPickupNotifications(dueBins);

    if (statTotal) statTotal.textContent = String(activeTotal);
    if (statExpired) statExpired.textContent = String(needsPickupCount);
    if (statCompleted) statCompleted.textContent = String(completedCount);

    if (navCountAll) navCountAll.textContent = String(activeTotal);
    if (navCountActive) navCountActive.textContent = String(within10Count);
    if (navCountOverdue) navCountOverdue.textContent = String(needsPickupCount);
    if (navCountCompleted) navCountCompleted.textContent = String(completedCount);
    if (navCountOwnerSkl) navCountOwnerSkl.textContent = String(countOwnerSkl);
    if (navCountOwnerThirumal) navCountOwnerThirumal.textContent = String(countOwnerThirumal);
    if (navCount2ft) navCount2ft.textContent = String(count2ft);
    if (navCount4ft) navCount4ft.textContent = String(count4ft);

    // Filter
    const isCompletedView = filterStatus === 'completed';

    const filtered = allRecords.filter((item) => {
      const itemCompleted = item.status === 'Completed';

      if (isCompletedView) {
        if (!itemCompleted) return false;
      } else {
        if (itemCompleted) return false;
        const { needsPickup } = getDaysRemaining(item.date_end);
        if (filterStatus === 'within_10' && needsPickup) return false;
        if (filterStatus === 'overdue' && !needsPickup) return false;
      }

      if (filterOwner !== 'all' && item.bin_owner !== filterOwner) return false;
      if (filterSize !== 'all' && item.size !== filterSize) return false;

      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        const hay = `${item.location || ''} ${item.bin_owner || ''} ${item.invoice_no ? 'inv #' + item.invoice_no : ''} ${item.customer_name || ''} ${item.customer_phone || ''} ${item.size || ''} ${item.notes || ''}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });

    // Sort
    filtered.sort((a, b) => {
      if (sortMode === 'due_soon') {
        return new Date(a.date_end).getTime() - new Date(b.date_end).getTime();
      }
      if (sortMode === 'price_desc') {
        return (Number(b.price) || 0) - (Number(a.price) || 0);
      }
      if (isCompletedView) {
        return new Date(b.completed_at || b.created_at || b.date_end).getTime() - new Date(a.completed_at || a.created_at || a.date_end).getTime();
      }
      return new Date(b.created_at || b.date_start).getTime() - new Date(a.created_at || a.date_start).getTime();
    });

    const poolCount = isCompletedView ? completedCount : activeTotal;
    if (listingCounter) {
      listingCounter.textContent = `${filtered.length} / ${poolCount}`;
    }

    tableBody.innerHTML = '';
    if (filtered.length === 0) {
      emptyState.hidden = false;
      if (isCompletedView) {
        emptyStateTitle.textContent = t('no_completed_title');
        emptyStateDesc.textContent = t('no_completed_desc');
        btnEmptyCreate.hidden = true;
      } else {
        emptyStateTitle.textContent = t('no_active_title');
        emptyStateDesc.textContent = t('no_active_desc');
        btnEmptyCreate.hidden = false;
      }
      return;
    }
    emptyState.hidden = true;

    for (const item of filtered) {
      const tr = document.createElement('tr');
      tr.className = 'roro-row';
      tr.tabIndex = 0;
      tr.setAttribute('role', 'button');
      tr.setAttribute('aria-label', `Open actions for ${item.location}`);
      tr.setAttribute('data-open-detail-id', item.id);

      const formattedPhone = formatPhoneDisplay(item.customer_phone);
      const statusPill = buildStatusPillHtml(item);
      const sizeCls = item.size === '2 Feet' ? 's2' : 's4';
      const isThirumal = item.bin_owner === OWNER_THIRUMAL;
      const ownerCls = isThirumal ? 'thirumal' : 'skl';
      const ownerShort = isThirumal ? 'Thirumal Vel Ent.' : 'SKL Waste';

      tr.innerHTML = `
        <td data-col="location">
          <div class="cell-loc">
            <div class="loc-head-row">
              <span class="loc-main">${escapeHtml(item.location)}</span>
              ${item.invoice_no ? `<span class="pill-inv">INV #${escapeHtml(item.invoice_no)}</span>` : ''}
            </div>
            ${item.notes ? `<span class="loc-note">${escapeHtml(item.notes)}</span>` : ''}
          </div>
        </td>
        <td data-col="size">
          <div class="owner-stack">
            <span class="pill-size ${sizeCls}">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="7" width="20" height="14" rx="2"></rect></svg>
              ${escapeHtml(item.size)}
            </span>
            <span class="pill-owner ${ownerCls}">${ownerShort}</span>
          </div>
        </td>
        <td data-col="customer">
          <div class="cust-stack">
            <span class="cust-name">${item.customer_name ? escapeHtml(item.customer_name) : 'Customer'}</span>
            <span class="cust-phone">${escapeHtml(formattedPhone)}</span>
          </div>
        </td>
        <td data-col="status">
          <div class="status-stack">
            ${statusPill}
            <span class="status-end-sub">End: ${formatDateDisplay(item.date_end)}</span>
          </div>
        </td>
        <td data-col="price" class="text-right">
          <span class="price-chevron-cell">
            <span class="price-val">RM ${Number(item.price).toLocaleString()}</span>
            <svg class="row-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        </td>
      `;

      tableBody.appendChild(tr);
    }
  }

  function buildStatusPillHtml(item: RoroRecord): string {
    const isDone = item.status === 'Completed';
    const { daysLeft, isOverdue } = getDaysRemaining(item.date_end);
    if (isDone) {
      const doneDate = item.completed_at ? formatDateDisplay(item.completed_at) : '';
      return `<span class="days-pill done">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        ${t('pulled')}${doneDate ? ` &bull; ${doneDate}` : ''}
      </span>`;
    }
    if (isOverdue) {
      return `<span class="days-pill late">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        ${t('overdue_prefix')} ${Math.abs(daysLeft)}d
      </span>`;
    }
    if (daysLeft === 0) {
      return `<span class="days-pill late">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path></svg>
        ${t('due_today')}
      </span>`;
    }
    if (daysLeft <= 2) {
      return `<span class="days-pill soon">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 15 14"></polyline></svg>
        ${daysLeft}d ${t('left_suffix')}
      </span>`;
    }
    return `<span class="days-pill ok">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="20 6 9 17 4 12"></polyline></svg>
      ${daysLeft}d ${t('left_suffix')}
    </span>`;
  }

  // =========================================================================
  // TAPPED BIN DETAIL & ACTION MENU CONTROLLER
  // =========================================================================
  const detailModal = document.getElementById('record-detail-modal') as HTMLElement;
  const detailBadges = document.getElementById('detail-badges') as HTMLElement;
  const detailLocationTitle = document.getElementById('detail-location-title') as HTMLElement;
  const detailCustomerVal = document.getElementById('detail-customer-val') as HTMLElement;
  const detailPhoneVal = document.getElementById('detail-phone-val') as HTMLElement;
  const detailInvoiceVal = document.getElementById('detail-invoice-val') as HTMLElement;
  const detailPriceVal = document.getElementById('detail-price-val') as HTMLElement;
  const detailOwnerVal = document.getElementById('detail-owner-val') as HTMLElement;
  const detailStartVal = document.getElementById('detail-start-val') as HTMLElement;
  const detailEndVal = document.getElementById('detail-end-val') as HTMLElement;
  const detailNotesBox = document.getElementById('detail-notes-box') as HTMLElement;
  const detailNotesVal = document.getElementById('detail-notes-val') as HTMLElement;
  const detailExtendSection = document.getElementById('detail-extend-section') as HTMLElement;
  const detailActiveFoot = document.getElementById('detail-active-foot') as HTMLElement;
  const detailCompletedFoot = document.getElementById('detail-completed-foot') as HTMLElement;
  const btnDetailCopyDriver = document.getElementById('btn-detail-copy-driver') as HTMLButtonElement;
  const btnDetailCopyWaze = document.getElementById('btn-detail-copy-waze') as HTMLButtonElement;
  const btnDetailWhatsApp = document.getElementById('btn-detail-whatsapp') as HTMLAnchorElement;

  let activeDetailId: string | null = null;

  function populateDetailModal(rec: RoroRecord) {
    const isDone = rec.status === 'Completed';
    const sizeCls = rec.size === '2 Feet' ? 's2' : 's4';
    const isThirumal = rec.bin_owner === OWNER_THIRUMAL;
    const ownerCls = isThirumal ? 'thirumal' : 'skl';
    const ownerShort = isThirumal ? 'Thirumal Vel Ent.' : 'SKL Waste';

    detailBadges.innerHTML = `
      ${buildStatusPillHtml(rec)}
      <span class="pill-size ${sizeCls}">${escapeHtml(rec.size)}</span>
      <span class="pill-owner ${ownerCls}">${ownerShort}</span>
      ${rec.invoice_no ? `<span class="pill-inv">INV #${escapeHtml(rec.invoice_no)}</span>` : ''}
    `;

    detailLocationTitle.textContent = rec.location;
    detailCustomerVal.textContent = rec.customer_name || 'Customer';
    detailPhoneVal.textContent = formatPhoneDisplay(rec.customer_phone) || '-';
    detailInvoiceVal.textContent = rec.invoice_no ? `#${rec.invoice_no}` : '-';
    detailPriceVal.textContent = `RM ${Number(rec.price).toLocaleString()}`;
    detailOwnerVal.textContent = rec.bin_owner;
    detailStartVal.textContent = formatDateDisplay(rec.date_start);
    detailEndVal.textContent = formatDateDisplay(rec.date_end);

    if (rec.notes && rec.notes.trim()) {
      detailNotesVal.textContent = rec.notes;
      detailNotesBox.hidden = false;
    } else {
      detailNotesBox.hidden = true;
    }

    const waUrl = buildWhatsAppUrl(rec);
    if (waUrl) {
      btnDetailWhatsApp.href = waUrl;
      btnDetailWhatsApp.hidden = false;
    } else {
      btnDetailWhatsApp.hidden = true;
    }

    detailExtendSection.hidden = isDone;
    detailActiveFoot.hidden = isDone;
    detailCompletedFoot.hidden = !isDone;
  }

  function openDetailModal(rec: RoroRecord) {
    closeAllDropdowns();
    activeDetailId = rec.id;
    populateDetailModal(rec);
    detailModal.hidden = false;
  }

  function closeDetailModal() {
    detailModal.hidden = true;
    activeDetailId = null;
  }

