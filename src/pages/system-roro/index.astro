    padding: 0.55rem 0.7rem;
    border: none;
    background: transparent;
    border-radius: 10px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #334155;
    text-decoration: none;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.14s ease, color 0.14s ease;
  }

  .dropdown-action-item:hover {
    background: rgba(241, 245, 249, 0.9);
    color: #0f172a;
  }

  .dropdown-action-item.active {
    background: #f0fdf4;
    color: #15803d;
    font-weight: 700;
  }

  .dropdown-action-item.danger {
    color: #dc2626;
  }

  .dropdown-action-item.danger:hover {
    background: #fef2f2;
    color: #b91c1c;
  }

  /* --- NOTIFICATION BELL & BLUR PANEL --- */
  .notif-bell-btn {
    position: relative;
    width: 42px;
    height: 42px;
    border: 1px solid #e5e7eb;
    background: #ffffff;
    color: #334155;
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .notif-bell-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
  }

  .notif-bell-btn.has-alerts {
    border-color: #fecaca;
    background: #fff5f5;
    color: #dc2626;
  }

  .notif-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 9999px;
    background: #dc2626;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 8px rgba(220, 38, 38, 0.38);
  }

  .notif-badge[hidden] {
    display: none;
  }

  .notif-panel {
    width: 360px;
    max-width: calc(100vw - 2rem);
    padding: 0.65rem;
  }

  .notif-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.25rem 0.4rem 0.35rem;
  }

  .notif-panel-title {
    display: block;
    font-size: 0.84rem;
    font-weight: 800;
    color: #0f172a;
  }

  .notif-panel-sub {
    display: block;
    font-size: 0.7rem;
    color: #64748b;
  }

  .browser-notif-pill {
    height: 28px;
    padding: 0 0.6rem;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #334155;
    border-radius: 8px;
    font-size: 0.7rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .browser-notif-pill:hover {
    border-color: #0f172a;
    color: #0f172a;
  }

  .browser-notif-pill.granted {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #15803d;
  }

  .notif-list {
    max-height: 310px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.2rem 0.15rem;
  }

  :global(.notif-empty) {
    padding: 1.5rem 0.75rem;
    text-align: center;
    font-size: 0.8rem;
    color: #64748b;
  }

  :global(.notif-item-card) {
    background: #ffffff;
    border: 1px solid #f1f5f9;
    border-radius: 12px;
    padding: 0.65rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  :global(.notif-item-top) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  :global(.notif-item-loc) {
    font-size: 0.8rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.3;
  }

  :global(.notif-item-tag) {
    font-size: 0.67rem;
    font-weight: 800;
    padding: 0.14rem 0.45rem;
    border-radius: 9999px;
    background: #fef2f2;
    color: #dc2626;
    white-space: nowrap;
  }

  :global(.notif-item-meta) {
    font-size: 0.73rem;
    color: #64748b;
  }

  :global(.notif-item-actions) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.1rem;
  }

  :global(.notif-wa-link) {
    flex: 1;
    height: 30px;
    padding: 0 0.6rem;
    border-radius: 8px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #15803d;
    font-size: 0.73rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.32rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  :global(.notif-wa-link:hover) {
    background: #15803d;
    border-color: #15803d;
    color: #ffffff;
  }

  :global(.notif-pull-btn) {
    height: 30px;
    padding: 0 0.6rem;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #334155;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  :global(.notif-pull-btn:hover) {
    background: #0f172a;
    border-color: #0f172a;
    color: #ffffff;
  }

  /* --- URGENT PICKUP ALERT BANNER --- */
  .pickup-alert-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    background: #fff5f5;
    border: 1px solid #fecaca;
    border-radius: 16px;
    padding: 0.9rem 1.15rem;
  }

  .pickup-alert-banner[hidden] {
    display: none;
  }

  .alert-banner-left {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .alert-banner-icon {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: #fee2e2;
    color: #dc2626;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .alert-banner-copy {
    display: flex;
    flex-direction: column;
  }

  .alert-banner-title {
    font-size: 0.88rem;
    font-weight: 800;
    color: #991b1b;
  }

  .alert-banner-desc {
    font-size: 0.79rem;
    color: #b91c1c;
  }

  .alert-banner-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .alert-btn-outline {
    height: 36px;
    padding: 0 0.85rem;
    border: 1px solid #fca5a5;
    background: #ffffff;
    color: #b91c1c;
    border-radius: 9px;
    font-size: 0.78rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .alert-btn-outline:hover {
    background: #fef2f2;
  }

  .alert-btn-solid {
    height: 36px;
    padding: 0 0.9rem;
    border: none;
    background: #dc2626;
    color: #ffffff;
    border-radius: 9px;
    font-size: 0.78rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .alert-btn-solid:hover {
    background: #b91c1c;
  }

  /* ==========================================================================
     MAIN WORKSPACE (Pure White, Spacious Editorial Rhythm)
     ========================================================================== */
  .workspace {
    flex: 1;
    min-width: 0;
    background: transparent;
    padding: 1.85rem 2.25rem 3.5rem 1.85rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .workspace-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .workspace-header-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .workspace-header-right {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .mobile-menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid #e5e7eb;
    background: #ffffff;
    color: #0f172a;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .workspace-title {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #0f172a;
    line-height: 1.2;
  }

  .workspace-sub {
    font-size: 0.98rem;
    color: #64748b;
    margin-top: 0.25rem;
  }

  .primary-create-btn {
    height: 46px;
    padding: 0 1.35rem;
    border: none;
    border-radius: 13px;
    background: #0f172a;
    color: #ffffff;
    font-size: 0.96rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    cursor: pointer;
    box-shadow: 0 6px 16px -4px rgba(15, 23, 42, 0.28);
    transition: background-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }

  .primary-create-btn:hover {
    background: #15803d;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px -4px rgba(21, 128, 61, 0.35);
  }

  /* --- TAB SWITCH BLUR-FADE GOING LEFT ANIMATION --- */
  .tab-animate-left {
    animation: tabBlurFadeLeft 0.34s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity, filter;
  }

  @keyframes tabBlurFadeLeft {
    0% {
      opacity: 0;
      filter: blur(8px);
      transform: translateX(26px);
    }
    100% {
      opacity: 1;
      filter: blur(0px);
      transform: translateX(0);
    }
  }

  /* --- KPI CARDS --- */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .kpi-grid[hidden] {
    display: none;
  }

  .kpi-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 1.35rem 1.45rem;
    display: flex;
    align-items: center;
    gap: 1.15rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }

  .kpi-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 10px 24px -10px rgba(15, 23, 42, 0.09);
    transform: translateY(-1px);
  }

  .kpi-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .kpi-icon svg {
    width: 26px;
    height: 26px;
  }

  .kpi-icon.slate { background: #f1f5f9; color: #0f172a; }
  .kpi-icon.emerald { background: #f0fdf4; color: #15803d; }
  .kpi-icon.danger { background: #fef2f2; color: #dc2626; }
  .kpi-icon.indigo { background: #eff6ff; color: #1d4ed8; }

  .kpi-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .kpi-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #64748b;
  }

  .kpi-value {
    font-family: var(--font-display);
    font-size: 1.95rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #0f172a;
    line-height: 1.15;
    margin-top: 0.15rem;
  }

  /* --- TOOLBAR --- */
  .toolbar-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.95rem;
    flex-wrap: wrap;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 0.85rem 1.05rem;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    flex: 1;
  }

  .search-field {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 260px;
    flex: 1;
    max-width: 440px;
  }

  .search-field svg {
    position: absolute;
    left: 14px;
    color: #64748b;
    pointer-events: none;
  }

  .search-field input {
    width: 100%;
    height: 44px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0 1rem 0 2.65rem;
    font-size: 0.95rem;
    color: #0f172a;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .search-field input:focus {
    outline: none;
    border-color: #0f172a;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.06);
  }

  .filter-trigger-btn {
    height: 44px;
    padding: 0 1rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .filter-trigger-btn:hover {
    border-color: #cbd5e1;
    background: #ffffff;
  }

  .result-counter {
    font-size: 0.88rem;
    font-weight: 700;
    color: #64748b;
  }

  /* --- TABLE --- */
  .table-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    overflow: hidden;
  }

  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .roro-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.96rem;
  }

  .roro-table thead {
    background: #f8fafc;
    border-bottom: 1px solid #e5e7eb;
  }

  .roro-table th {
    padding: 1rem 1.25rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    color: #64748b;
    white-space: nowrap;
  }

  .roro-table th.price-col-head,
  .roro-table :global(td[data-col="price"]) {
    width: 150px;
    padding-right: 1.65rem;
    text-align: right;
  }

  .roro-table :global(td) {
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid #f1f5f9;
    color: #0f172a;
    vertical-align: middle;
  }

  .roro-table :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .roro-table :global(tbody tr) {
    cursor: pointer;
    transition: background-color 0.14s ease, transform 0.14s ease;
  }

  .roro-table :global(tbody tr:hover) {
    background: #f8fafc;
  }

  .roro-table :global(tbody tr:focus-visible) {
    outline: 2px solid #0f172a;
    outline-offset: -2px;
    background: #f8fafc;
  }

  .roro-table :global(tbody tr:hover .row-chevron) {
    color: #0f172a;
    transform: translateX(4px);
  }

  .text-right,
  .roro-table :global(.text-right),
  .roro-table :global(td[data-col="price"]) {
    text-align: right;
  }

  /* Global styles for dynamically injected minimal rows */
  :global(.cell-loc) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  :global(.loc-head-row) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  :global(.loc-main) {
    font-weight: 800;
    font-size: 1.05rem;
    color: #0f172a;
    line-height: 1.35;
  }

  :global(.loc-note) {
    font-size: 0.86rem;
    color: #64748b;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.status-stack) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  :global(.status-end-sub) {
    font-size: 0.82rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
  }

  :global(.price-chevron-cell) {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.85rem;
    white-space: nowrap;
  }

  :global(.row-chevron) {
    color: #94a3b8;
    flex-shrink: 0;
    transition: transform 0.16s ease, color 0.16s ease;
  }

  /* --- BIN DETAIL & ACTION MENU MODAL (Opens on Row Tap) --- */
  .detail-dialog {
    max-width: 500px;
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .detail-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 1.45rem 1.55rem 1.1rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .detail-head-copy {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
  }

  .detail-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .detail-loc-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.3;
    letter-spacing: -0.02em;
    word-break: break-word;
  }

  .detail-body {
    padding: 1.25rem 1.55rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    overflow-y: auto;
    max-height: 66vh;
  }

  .detail-info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .detail-info-cell {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 13px;
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .detail-info-label {
    font-size: 0.67rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #94a3b8;
  }

  .detail-info-val {
    font-size: 0.9rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.3;
    word-break: break-word;
  }

  .detail-price-val {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .detail-info-sub {
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
  }

  .detail-notes-box {
    background: #fafafa;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 0.72rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .detail-notes-box[hidden] {
    display: none;
  }

  .detail-notes-text {
    font-size: 0.82rem;
    color: #334155;
    line-height: 1.45;
  }

  .detail-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-section[hidden] {
    display: none;
  }

  .detail-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .detail-section-label {
    font-size: 0.69rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #64748b;
  }

  .detail-section-hint {
    font-size: 0.71rem;
    font-weight: 600;
    color: #94a3b8;
  }

  .detail-quick-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .detail-action-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
    padding: 0.82rem 0.5rem;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #0f172a;
    border-radius: 13px;
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.12s ease;
  }

  .detail-action-tile:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    transform: translateY(-1px);
  }

  .detail-action-tile.copied {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #15803d;
  }

  .detail-action-tile.waze-tile {
    background: #f0f9ff;
    border-color: #bae6fd;
    color: #0369a1;
  }

  .detail-action-tile.waze-tile:hover {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
  }

  .detail-action-tile.waze-tile.copied {
