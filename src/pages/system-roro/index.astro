    color: #64748b;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .confirm-foot {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 0.65rem;
  }

  .btn-emerald {
    height: 40px;
    border: none;
    background: #15803d;
    color: #ffffff;
    border-radius: 10px;
    font-size: 0.84rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .btn-emerald:hover { background: #166534; }

  .btn-danger {
    height: 40px;
    border: none;
    background: #dc2626;
    color: #ffffff;
    border-radius: 10px;
    font-size: 0.84rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .btn-danger:hover { background: #b91c1c; }

  /* Toast */
  .toast-bar {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 300;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: #ffffff;
    padding: 0.7rem 1.05rem;
    border-radius: 12px;
    font-size: 0.82rem;
    font-weight: 600;
    box-shadow: 0 16px 32px -8px rgba(15, 23, 42, 0.3);
    animation: toastIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toast-bar[hidden] { display: none; }

  @keyframes toastIn {
    from { opacity: 0; transform: translateY(10px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Responsive Mobile Sidebar Drawer */
  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.32);
    backdrop-filter: blur(6px);
    z-index: 55;
  }

  .sidebar-backdrop[hidden] { display: none; }

  @media (max-width: 1120px) {
    .kpi-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .sidebar {
      position: fixed;
