  /* Unified Flex Prefix Field (+60 / RM) for exact horizontal alignment */
  .prefix-field {
    display: flex;
    align-items: center;
    height: 48px;
    width: 100%;
    border: 1.5px solid #94a3b8;
    border-radius: 12px;
    background: #ffffff;
    overflow: hidden;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .prefix-field:focus-within {
    border-color: #0f172a;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.12);
  }

  .prefix-field:has(.prefix-input[readonly]) {
    background: #f1f5f9;
  }

