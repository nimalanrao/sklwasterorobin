  /* --- LOCATION AUTOCOMPLETE (FREE OPENSTREETMAP PHOTON / NOMINATIM) --- */
  .autocomplete-anchor {
    position: relative;
    width: 100%;
  }

  .loc-input-pad {
    padding-right: 2.4rem;
  }

  .loc-spinner {
    position: absolute;
    right: 11px;
    top: 50%;
    transform: translateY(-50%);
    color: #64748b;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .loc-spinner[hidden] {
    display: none;
  }

