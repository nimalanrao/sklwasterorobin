  .date-trigger-icon {
    color: #64748b;
    flex-shrink: 0;
  }

  .calendar-popover {
    width: 288px;
    min-width: 288px;
    padding: 0.75rem;
    z-index: 270;
    background: rgba(255, 255, 255, 0.96);
  }

  .calendar-popover.cal-left {
    left: 0;
    right: auto;
    transform-origin: bottom left;
  }

  .calendar-popover.cal-right {
    right: 0;
    left: auto;
    transform-origin: bottom right;
  }

  .cal-presets {
    display: flex;
    align-items: center;
    gap: 0.32rem;
    flex-wrap: wrap;
    margin-bottom: 0.65rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .cal-preset-pill {
    height: 26px;
    padding: 0 0.55rem;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #334155;
    border-radius: 7px;
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.14s ease;
  }

  .cal-preset-pill:hover {
    background: #0f172a;
    border-color: #0f172a;
    color: #ffffff;
  }

  .cal-preset-pill.highlight {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #15803d;
  }

  .cal-preset-pill.highlight:hover {
    background: #15803d;
    border-color: #15803d;
    color: #ffffff;
  }

  .cal-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.55rem;
  }

  .cal-month-label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
  }

  .cal-nav-btn {
    width: 28px;
    height: 28px;
    border: 1px solid #e5e7eb;
    background: #ffffff;
    color: #475569;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.14s ease, color 0.14s ease;
  }

  .cal-nav-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .cal-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    margin-bottom: 0.28rem;
  }

  .cal-weekdays span {
    font-size: 0.67rem;
    font-weight: 700;
    color: #94a3b8;
    padding: 0.15rem 0;
  }

  .cal-days-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }

  :global(.cal-day) {
    height: 32px;
    border: none;
    background: transparent;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  :global(.cal-day:hover) {
    background: #f1f5f9;
  }

  :global(.cal-day.is-outside) {
    color: #cbd5e1;
  }

  :global(.cal-day.is-today) {
    box-shadow: inset 0 0 0 1.5px #15803d;
    color: #15803d;
    font-weight: 800;
  }

  :global(.cal-day.is-in-range) {
    background: #f0fdf4;
    color: #166534;
    border-radius: 6px;
  }

  :global(.cal-day.is-selected) {
    background: #0f172a !important;
    color: #ffffff !important;
    font-weight: 800;
    box-shadow: none;
  }

  .modal-foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
    padding-top: 1rem;
    margin-top: 0.4rem;
    border-top: 1px solid #f1f5f9;
  }

  .btn-ghost {
    height: 40px;
    padding: 0 1.05rem;
    border: 1px solid #e5e7eb;
    background: #ffffff;
    color: #475569;
    border-radius: 10px;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .btn-ghost:hover {
    background: #f8fafc;
    color: #0f172a;
  }

  .btn-solid {
    height: 40px;
    padding: 0 1.2rem;
    border: none;
    background: #0f172a;
    color: #ffffff;
    border-radius: 10px;
    font-size: 0.84rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .btn-solid:hover {
    background: #15803d;
  }

  /* Confirm Dialog */
  .confirm-dialog {
    max-width: 420px;
    text-align: center;
    padding: 2rem 1.75rem;
  }

  .confirm-badge {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
  }

  .confirm-badge.emerald { background: #f0fdf4; color: #15803d; }
  .confirm-badge.danger { background: #fef2f2; color: #dc2626; }

  .confirm-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.45rem;
  }

  .confirm-desc {
