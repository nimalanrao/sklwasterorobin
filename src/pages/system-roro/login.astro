---
import SystemRoroLayout from '../../layouts/SystemRoroLayout.astro';
---

<SystemRoroLayout
  title="Admin Login | System RORO - SKL Waste Sdn Bhd"
  description="Admin Sign In Portal for SKL Waste Sdn Bhd System RORO"
  redirectIfAuth={true}
>
  <main class="login-viewport">
    <div class="ambient-mesh" aria-hidden="true"></div>

    <div class="login-shell">
      <div class="login-card">
        <!-- Brand Header -->
        <div class="brand-row">
          <div class="brand-mark">
            <picture>
              <source srcset="/images/logo-skl-waste-sdn-bhd.webp" type="image/webp" />
              <img
                src="/images/skl-logo.png"
                alt="SKL Waste Sdn Bhd Logo"
                width="36"
                height="36"
                class="brand-logo-img"
              />
            </picture>
          </div>
          <div class="brand-copy">
            <h1 class="brand-heading">SYSTEM RORO</h1>
            <span class="brand-meta">SKL WASTE SDN BHD &bull; ADMIN ACCESS</span>
          </div>
        </div>

        <div class="welcome-block">
          <h2 class="welcome-title">System RORO Sign In</h2>
          <p class="welcome-desc">Sign in with your SKL Waste account (Admin, Staff, or Driver).</p>
        </div>

        <!-- Inline Error Feedback -->
        <div id="login-error" class="error-banner" role="alert" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span id="login-error-text">Invalid username or password.</span>
        </div>

        <form id="login-form" class="login-form" autocomplete="off">
          <div class="field-group">
            <label for="username" class="field-label">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span>Username</span>
            </label>
            <input
              type="text"
              id="username"
              name="username"
              class="field-input"
              placeholder="Enter username"
              required
              autofocus
            />
          </div>

          <div class="field-group">
            <label for="password" class="field-label">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Password</span>
            </label>
            <div class="password-box">
              <input
                type="password"
                id="password"
                name="password"
                class="field-input has-toggle"
                placeholder="Enter password"
                required
              />
              <button type="button" id="toggle-password" class="toggle-eye-btn" aria-label="Toggle password visibility">
                <svg id="eye-open" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg id="eye-closed" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                  <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" id="btn-login-submit" class="login-submit-btn">
            <span id="btn-login-label">Sign In to Dashboard</span>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>

        <div class="login-footer">
          <a href="/" class="return-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Main Website</span>
          </a>
        </div>
      </div>
    </div>
  </main>
</SystemRoroLayout>

<style>
  .login-viewport {
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    position: relative;
    padding: 2rem 1.25rem;
    overflow: hidden;
  }

  .ambient-mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 12% 14%, rgba(21, 128, 61, 0.045) 0%, transparent 42%),
      radial-gradient(circle at 88% 86%, rgba(15, 23, 42, 0.04) 0%, transparent 45%);
    pointer-events: none;
  }

  .login-shell {
    width: 100%;
    max-width: 430px;
    position: relative;
    z-index: 2;
    animation: cardReveal 0.38s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes cardReveal {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(10px) scale(0.98);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0) scale(1);
    }
  }

  .login-card {
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    padding: 2.25rem 2rem;
    box-shadow:
      0 20px 44px -16px rgba(15, 23, 42, 0.08),
      0 2px 6px rgba(15, 23, 42, 0.03);
  }

  .brand-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 1.35rem;
  }

  .brand-mark {
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 4px;
    box-shadow: 0 4px 12px -4px rgba(15, 23, 42, 0.1);
  }

  .brand-logo-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    display: block;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .brand-heading {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #0f172a;
    line-height: 1.15;
  }

  .brand-meta {
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #15803d;
  }

  .welcome-block {
    margin-bottom: 1.35rem;
  }

  .welcome-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #0f172a;
    margin-bottom: 0.25rem;
  }

  .welcome-desc {
    font-size: 0.86rem;
    color: #64748b;
  }

  .error-banner {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    border-radius: 12px;
    padding: 0.7rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 1.15rem;
    animation: shakeX 0.28s ease;
  }

  .error-banner[hidden] {
    display: none;
  }

  @keyframes shakeX {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #1e293b;
  }

  .field-label svg {
    color: #64748b;
  }

  .field-input {
    width: 100%;
    height: 46px;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 0 0.95rem;
    font-size: 0.92rem;
    color: #0f172a;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .field-input.has-toggle {
    padding-right: 2.8rem;
  }

  .field-input::placeholder {
    color: #94a3b8;
  }

  .field-input:focus {
    outline: none;
    border-color: #0f172a;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
  }

  .password-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .toggle-eye-btn {
    position: absolute;
    right: 8px;
    width: 34px;
    height: 34px;
    border: none;
    background: transparent;
    color: #64748b;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .toggle-eye-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .login-submit-btn {
    height: 46px;
    margin-top: 0.25rem;
    border: none;
    border-radius: 12px;
    background: #0f172a;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    cursor: pointer;
    box-shadow: 0 8px 18px -6px rgba(15, 23, 42, 0.35);
    transition: transform 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
  }

  .login-submit-btn:hover {
    background: #15803d;
    transform: translateY(-1px);
    box-shadow: 0 10px 22px -6px rgba(21, 128, 61, 0.38);
  }

  .login-submit-btn:active {
    transform: translateY(0);
  }

  .login-footer {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid #f1f5f9;
    text-align: center;
  }

  .return-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .return-link:hover {
    color: #0f172a;
  }
</style>

<script>
  import { RORO_ACCOUNTS, logAuditEvent } from '../../utils/systemRoroClient';

  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const usernameEl = document.getElementById('username') as HTMLInputElement | null;
  const passwordEl = document.getElementById('password') as HTMLInputElement | null;
  const errorBox = document.getElementById('login-error') as HTMLElement | null;
  const errorText = document.getElementById('login-error-text') as HTMLElement | null;
  const toggleBtn = document.getElementById('toggle-password') as HTMLButtonElement | null;
  const eyeOpen = document.getElementById('eye-open') as HTMLElement | null;
  const eyeClosed = document.getElementById('eye-closed') as HTMLElement | null;
  const submitBtn = document.getElementById('btn-login-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('btn-login-label') as HTMLElement | null;

  if (toggleBtn && passwordEl) {
    toggleBtn.addEventListener('click', () => {
      const showing = passwordEl.type === 'text';
      passwordEl.type = showing ? 'password' : 'text';
      if (eyeOpen && eyeClosed) {
        eyeOpen.style.display = showing ? 'block' : 'none';
        eyeClosed.style.display = showing ? 'none' : 'block';
      }
    });
  }

  if (form && usernameEl && passwordEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const user = (usernameEl.value || '').trim().toLowerCase();
      const pass = passwordEl.value || '';

      const matched = RORO_ACCOUNTS.find((a) => a.username === user && a.password === pass);

      if (matched) {
        if (errorBox) errorBox.hidden = true;
        try {
          sessionStorage.setItem('skl_system_roro_auth', 'true');
          sessionStorage.setItem('skl_system_roro_username', matched.username);
          sessionStorage.setItem('skl_system_roro_user', matched.displayName);
          sessionStorage.setItem('skl_system_roro_role', matched.role);
          sessionStorage.setItem('skl_system_roro_login_at', new Date().toISOString());

          localStorage.setItem('skl_system_roro_auth', 'true');
          localStorage.setItem('skl_system_roro_username', matched.username);
          localStorage.setItem('skl_system_roro_user', matched.displayName);
          localStorage.setItem('skl_system_roro_role', matched.role);
          localStorage.setItem('skl_system_roro_login_at', new Date().toISOString());
        } catch {}

        if (submitBtn && submitLabel) {
          submitBtn.disabled = true;
          submitLabel.textContent = 'Signing in...';
        }

        await logAuditEvent({
          action: 'LOGIN',
          details: `${matched.displayName} (${matched.roleLabel}) signed in`,
          actorOverride: {
            username: matched.username,
            displayName: matched.displayName,
            role: matched.role
          }
        });

        window.location.replace('/system-roro');
      } else {
        if (errorBox && errorText) {
          errorText.textContent = 'Invalid username or password. Please try again.';
          errorBox.hidden = false;
        }
        passwordEl.focus();
        passwordEl.select();
      }
    });
  }
</script>
