---
import { faqData, type FAQItem } from '../data/faq';

export interface Props {
  items?: FAQItem[];
  openFirst?: boolean;
}

const { items = faqData, openFirst = false } = Astro.props;
---

<div class="faq-accordion-wrapper">
  <div class="faq-controls reveal-on-scroll">
    <button type="button" class="btn btn-secondary btn-faq-ctrl" id="faq-expand-all">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>
      </svg>
      Kembangkan Semua (Expand All)
    </button>
    <button type="button" class="btn btn-secondary btn-faq-ctrl" id="faq-collapse-all">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m17 9-5-5-5 5"/><path d="m17 15-5 5-5-5"/>
      </svg>
      Tutup Semua (Collapse All)
    </button>
  </div>

  <div class="faq-accordion-list" id="faq-list">
    {items.map((item: FAQItem, idx: number) => (
      <details 
        class="faq-item reveal-on-scroll" 
        id={item.id}
        open={openFirst && idx === 0}
      >
        <summary class="faq-summary">
          <span class="faq-question-text">{item.question}</span>
          <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</div>

<script>
  function setupFaqControls() {
    const expandBtn = document.getElementById('faq-expand-all');
    const collapseBtn = document.getElementById('faq-collapse-all');
    const faqContainer = document.getElementById('faq-list');

    if (expandBtn && collapseBtn && faqContainer) {
      const faqItems = faqContainer.querySelectorAll('details.faq-item');

      expandBtn.addEventListener('click', () => {
        faqItems.forEach((item) => {
          (item as HTMLDetailsElement).open = true;
        });
      });

      collapseBtn.addEventListener('click', () => {
        faqItems.forEach((item) => {
          (item as HTMLDetailsElement).open = false;
        });
      });
    }
  }

  // Support standard page load & Astro client transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFaqControls);
  } else {
    setupFaqControls();
  }
  document.addEventListener('astro:page-load', setupFaqControls);
</script>

<style>
  .faq-accordion-wrapper {
    margin: 1.5rem 0;
  }

  .faq-controls {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-faq-ctrl {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-full, 9999px);
    background: #ffffff;
    border: 1px solid var(--border-subtle, #e2e8f0);
    color: var(--text-primary, #0a1628);
    font-weight: 600;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn-faq-ctrl:hover {
    background: var(--bg-surface-alt, #f1f5f9);
    border-color: var(--border-hover, #cbd5e1);
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid var(--border-subtle, #e2e8f0);
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    box-shadow: var(--shadow-card, 0 4px 20px -2px rgba(10, 22, 40, 0.05));
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item:hover {
    border-color: var(--border-hover, #cbd5e1);
  }

  .faq-item[open] {
    border-color: var(--border-hover, #94a3b8);
    box-shadow: 0 8px 30px -4px rgba(10, 22, 40, 0.08);
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.35rem;
    min-height: 54px;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary, #0a1628);
    background: #ffffff;
    cursor: pointer;
    list-style: none; /* Hide default browser arrow */
    user-select: none;
  }

  /* WebKit specific arrow removal */
  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:hover {
    background: var(--bg-surface, #f8fafc);
  }

  .faq-summary:focus-visible {
    outline: 3px solid var(--accent-blue, #1d4ed8);
    outline-offset: -3px;
  }

  .faq-question-text {
    line-height: 1.4;
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--text-muted, #64748b);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--accent-blue, #1d4ed8);
  }

  .faq-answer {
    padding: 1.25rem 1.35rem 1.35rem;
    background: #ffffff;
    border-top: 1px solid var(--border-subtle, #f1f5f9);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary, #475569);
  }

  .faq-answer p {
    margin-bottom: 0.75rem;
  }

  .faq-answer p:last-child {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none !important;
    }
    .btn-faq-ctrl,
    .faq-item {
      transition: none !important;
    }
  }
</style>
