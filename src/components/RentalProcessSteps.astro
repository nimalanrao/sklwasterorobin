---
import { rentalProcessSteps, type RentalStep } from '../data/rentalProcess';
import { contactData } from '../data/contact';

export interface Props {
  steps?: RentalStep[];
}

const { steps = rentalProcessSteps } = Astro.props;
---

<div class="rental-process-wrapper">
  <ol class="rental-process-grid">
    {steps.map((step, index) => {
      const stepNumStr = String(step.stepNumber).padStart(2, '0');
      return (
        <li class="rental-step-card reveal-on-scroll" style={`--stagger-index: ${index};`}>
          <div class="step-card-header">
            <span class="step-badge">{stepNumStr}</span>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-card-body">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-description">{step.description}</p>
            {step.note && (
              <div class="step-note-box">
                <span class="note-label">Nota:</span>
                <span class="note-text">{step.note}</span>
              </div>
            )}
          </div>
        </li>
      );
    })}
  </ol>

  <div class="rental-process-cta-bar reveal-on-scroll">
    <div class="cta-bar-content">
      <div class="cta-icon-wrapper" aria-hidden="true">
        <svg class="cta-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <div class="cta-text-block">
        <h4 class="cta-heading">Sedia untuk Menyewa Tong Roro? / Ready to Book?</h4>
        <p class="cta-sub">
          Hubungi <strong>{contactData.mainContactPerson}</strong> untuk pengesahan lokasi dan sebut harga akhir mengikut keperluan projek anda.
        </p>
      </div>
    </div>
    <div class="cta-actions">
      <a href={contactData.telephoneHref} class="btn btn-primary cta-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Hubungi Mr Hari ({contactData.telephoneDisplay})</span>
      </a>
      <a href="/#quotation-form" class="btn btn-secondary cta-btn cta-btn-white">
        <span>Dapatkan Sebut Harga Online</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .rental-process-wrapper {
    width: 100%;
    margin: 1.5rem 0;
  }

  .rental-process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
  }

  @media (min-width: 640px) {
    .rental-process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .rental-process-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .rental-step-card {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-primary, #ffffff);
    border: 1px solid var(--border-subtle, #e2e8f0);
    border-radius: var(--radius-lg, 16px);
    padding: clamp(1.25rem, 2vw, 1.5rem);
    box-shadow: var(--shadow-card, 0 4px 20px -2px rgba(10, 22, 40, 0.05));
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
    height: 100%;
  }

  .rental-step-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover, 0 20px 40px -12px rgba(10, 22, 40, 0.12));
    border-color: var(--border-hover, #cbd5e1);
  }

  .step-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .step-badge {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-dark, #0a1628);
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 800;
    font-family: var(--font-display, inherit);
    border-radius: var(--radius-md, 10px);
    flex-shrink: 0;
    letter-spacing: -0.02em;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .step-line {
    flex: 1 1 auto;
    height: 2px;
    background-color: var(--border-subtle, #e2e8f0);
    border-radius: 1px;
  }

  .step-card-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .step-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary, #0a1628);
    margin: 0 0 0.65rem 0;
    line-height: 1.35;
  }

  .step-description {
    font-size: 0.9rem;
    color: var(--text-secondary, #475569);
    line-height: 1.6;
    margin: 0 0 0.85rem 0;
    flex: 1 1 auto;
  }

  .step-note-box {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.8rem;
    background-color: var(--bg-surface, #f8fafc);
    border: 1px solid var(--border-subtle, #e2e8f0);
    border-radius: var(--radius-sm, 6px);
    padding: 0.5rem 0.65rem;
    line-height: 1.4;
    margin-top: auto;
  }

  .note-label {
    font-weight: 700;
    color: var(--text-muted, #64748b);
    text-transform: uppercase;
    font-size: 0.725rem;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .note-text {
    color: var(--text-secondary, #475569);
  }

  .rental-process-cta-bar {
    background-color: var(--bg-dark, #0a1628);
    color: #ffffff;
    border-radius: var(--radius-lg, 16px);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 900px) {
    .rental-process-cta-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .cta-bar-content {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    max-width: 600px;
  }

  .cta-icon-wrapper {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(21, 128, 61, 0.2);
    border: 1px solid var(--accent-green, #15803d);
    border-radius: var(--radius-md, 10px);
    color: #ffffff;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .cta-text-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cta-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .cta-sub {
    font-size: 0.9rem;
    color: #cbd5e1;
    margin: 0;
    line-height: 1.5;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: var(--radius-md, 10px);
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .cta-btn-white {
    background-color: #ffffff;
    color: var(--bg-dark, #0a1628);
    border-color: #ffffff;
  }

  .cta-btn-white:hover {
    background-color: #f1f5f9;
    color: #000000;
  }

  @media (prefers-reduced-motion: reduce) {
    .rental-step-card,
    .cta-btn {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
