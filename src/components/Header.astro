---
import { companyData } from '../data/company';
import { mainNavigation, footerNavigation } from '../data/navigation';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="floating-header-wrapper" id="site-header">
  <div class="floating-pill-nav" role="banner">
    <!-- Top-Left: Logo + Brand Name (Links back to Home) & Language Switcher -->
    <div class="pill-left-group">
      <a href="/" class="pill-brand-link" aria-label="SKL WASTE SDN BHD - Kembali ke Halaman Utama">
        <span class="pill-logo-box">
          <picture>
            <source srcset="/images/logo-skl-waste-sdn-bhd.webp" type="image/webp" />
            <img
              src="/images/skl-logo.png"
              alt="Logo SKL Waste Sdn Bhd"
              width="38"
              height="38"
              class="pill-logo-img"
            />
          </picture>
        </span>
        <span class="pill-brand-name">{companyData.name}</span>
      </a>

      <!-- Language Toggle Button (Default page language: Malay; click to switch to English) -->
      <button
        type="button"
        id="lang-toggle-btn"
        class="pill-lang-btn"
        aria-label="Switch language between Bahasa Melayu and English"
        data-current-lang="ms"
      >
        <svg
          class="lang-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span id="lang-toggle-label">English</span>
      </button>
    </div>

    <!-- Visually Hidden Navigation Links for Search Engine Crawlers & Scrapers -->
    <nav class="crawler-seo-nav" aria-label="Directory Navigation">
      <ul>
        {footerNavigation.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right: Phone + WhatsApp CTA -->
    <div class="pill-right-group">
      <a
        href="tel:+60166159365"
        class="pill-phone-btn"
        aria-label="Telefon Mr Hari"
      >
        <svg class="pill-phone-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span class="pill-phone-text">Mr Hari: +60 16-615 9365</span>
      </a>

      <a
        href="https://wa.me/60166159365?text=Hai%20Mr%20Hari%20(SKL%20Waste%20Sdn%20Bhd)%2C%20saya%20nak%20order%20tong%20roro"
        class="pill-order-btn"
        data-track-cta="navbar_order_tong_roro"
        aria-label="24/7 WhatsApp Mr Hari SKL Waste"
      >
        <svg class="pill-wa-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"/>
        </svg>
        <span class="pill-order-text" data-ms="24/7 WHATSAPP" data-en="24/7 WHATSAPP">24/7 WHATSAPP</span>
      </a>
    </div>
  </div>
</header>

<style>
  .floating-header-wrapper {
    position: fixed;
    top: 1.15rem;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
    pointer-events: none;
  }

  .floating-pill-nav {
    pointer-events: auto;
    width: min(1140px, 100%);
    min-height: 66px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1.5px solid rgba(10, 22, 40, 0.14);
    border-radius: 9999px;
    padding: 0.5rem 0.85rem 0.5rem 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    box-shadow: 0 12px 34px -6px rgba(10, 22, 40, 0.16), 0 2px 8px rgba(10, 22, 40, 0.06);
  }

  .pill-left-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .pill-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: #0a1628;
    min-width: 0;
  }

  .pill-logo-box {
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: #ffffff;
    border: 1px solid rgba(10, 22, 40, 0.12);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    padding: 3px;
  }

  .pill-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .pill-brand-name {
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: clamp(0.92rem, 1.6vw, 1.15rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #0a1628;
    white-space: nowrap;
  }

  .pill-lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.42rem 0.8rem;
    border-radius: 9999px;
    border: 1px solid rgba(10, 22, 40, 0.18);
    background: #f8fafc;
    color: #0a1628;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.15s ease;
  }

  .pill-lang-btn:hover {
    background: #e2e8f0;
    border-color: #0a1628;
    transform: translateY(-1px);
  }

  .lang-icon {
    flex-shrink: 0;
    color: #15803d;
  }

  /* Visually hidden for humans, stays in HTML DOM for crawlers and scrapers */
  .crawler-seo-nav {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pill-right-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .pill-phone-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border-radius: 9999px;
    background: #ffffff;
    border: 1.5px solid rgba(10, 22, 40, 0.14);
    color: #0a1628;
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: clamp(0.76rem, 1.1vw, 0.86rem);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.15s ease;
  }

  .pill-phone-btn:hover {
    background: #f8fafc;
    border-color: #0a1628;
    transform: translateY(-1px);
  }

  .pill-phone-icon {
    flex-shrink: 0;
    color: #15803d;
  }

  .pill-order-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.65rem 1.25rem;
    border-radius: 9999px;
    background: #15803d;
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: clamp(0.78rem, 1.2vw, 0.9rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    text-decoration: none;
    border: 1.5px solid #166534;
    white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 14px rgba(21, 128, 61, 0.28);
  }

  .pill-wa-icon {
    flex-shrink: 0;
  }

  .pill-order-btn:hover {
    background: #166534;
    border-color: #14532d;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(21, 128, 61, 0.38);
  }

  @media (max-width: 768px) {
    .pill-phone-btn {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .floating-header-wrapper {
      top: 0.65rem;
      padding: 0 0.5rem;
    }

    .floating-pill-nav {
      min-height: 56px;
      padding: 0.35rem 0.55rem;
      gap: 0.4rem;
    }

    .pill-logo-box {
      width: 36px;
      height: 36px;
    }

    .pill-brand-name {
      font-size: 0.8rem;
    }

    .pill-lang-btn {
      padding: 0.32rem 0.6rem;
      font-size: 0.72rem;
    }

    .pill-order-btn {
      padding: 0.5rem 0.85rem;
      font-size: 0.72rem;
    }
  }

  @media (max-width: 400px) {
    .pill-brand-name {
      display: none;
    }
  }
</style>
