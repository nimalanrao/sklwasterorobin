---
import { companyData } from '../data/company';
import { contactData } from '../data/contact';
import { mainNavigation } from '../data/navigation';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const normalizePath = (p: string): string => {
  if (!p) return '/';
  return p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p;
};

const normalizedCurrent = normalizePath(currentPath);

const isCurrentPage = (href: string): boolean => {
  const normalizedHref = normalizePath(href);
  return normalizedHref === normalizedCurrent;
};
---

<header class="site-header" id="site-header">
  <div class="container header-container">
    <!-- Brand Identification -->
    <a href="/" class="header-brand">
      <picture>
        <source srcset="/images/logo-skl-waste-sdn-bhd.webp" type="image/webp" />
        <img
          src="/images/skl-logo.png"
          alt="Logo Rasmi SKL Waste Sdn Bhd"
          width="36"
          height="36"
          class="header-logo"
        />
      </picture>
      <div class="header-brand-text">
        <span class="header-brand-name">{companyData.name}</span>
        <span class="header-brand-reg">Reg. No: {companyData.registrationNumber}</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="desktop-nav-list">
        {mainNavigation.map((item) => {
          const active = isCurrentPage(item.href);
          return (
            <li>
              <a
                href={item.href}
                class={`desktop-nav-link ${active ? 'active' : ''}`}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header Actions (Desktop) -->
    <div class="header-actions">
      <a href={contactData.telephoneHref} class="header-phone-pill">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>{contactData.mainContactPerson}: {contactData.telephoneDisplay}</span>
      </a>
      <a href="/#quotation-form" class="btn btn-primary" style="min-height: 38px; padding: 0.42rem 0.85rem; font-size: 0.8rem; white-space: nowrap;">
        Dapatkan Sebut Harga
      </a>
    </div>

    <!-- Mobile Nav Hamburger Button -->
    <button
      type="button"
      class="mobile-nav-toggle"
      id="mobile-nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav-drawer"
      aria-label="Toggle navigation menu"
    >
      <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-nav-drawer" class="mobile-nav-drawer" hidden>
    <nav aria-label="Mobile Navigation">
      <ul class="mobile-nav-list">
        {mainNavigation.map((item) => {
          const active = isCurrentPage(item.href);
          return (
            <li>
              <a
                href={item.href}
                class={`mobile-nav-link ${active ? 'active' : ''}`}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="mobile-nav-actions">
        <a href={contactData.telephoneHref} class="btn btn-secondary" style="width: 100%;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>{contactData.mainContactPerson}: {contactData.telephoneDisplay}</span>
        </a>
        <a href="/#quotation-form" class="btn btn-primary" style="width: 100%;">
          Dapatkan Sebut Harga
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!toggleBtn || !drawer) return;

    const iconMenu = toggleBtn.querySelector('.icon-menu');
    const iconClose = toggleBtn.querySelector('.icon-close');

    function toggleMenu(open) {
      const shouldOpen = open !== undefined ? open : drawer.hasAttribute('hidden');
      document.body.classList.toggle('menu-open', shouldOpen);
      if (shouldOpen) {
        drawer.removeAttribute('hidden');
        drawer.classList.add('is-open');
        toggleBtn.setAttribute('aria-expanded', 'true');
        if (iconMenu) iconMenu.style.display = 'none';
        if (iconClose) iconClose.style.display = 'block';
      } else {
        drawer.setAttribute('hidden', '');
        drawer.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (iconMenu) iconMenu.style.display = 'block';
        if (iconClose) iconClose.style.display = 'none';
      }
    }

    toggleBtn.addEventListener('click', function() {
      toggleMenu();
    });

    // Close on escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !drawer.hasAttribute('hidden')) {
        toggleMenu(false);
        toggleBtn.focus();
      }
    });

    // Close when clicking any nav link in drawer
    drawer.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function() {
        toggleMenu(false);
      });
    });
  })();
</script>
