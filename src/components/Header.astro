---
import { companyData } from '../data/company';
import { mainNavigation, footerNavigation } from '../data/navigation';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="floating-header-wrapper" id="site-header">
  <div class="floating-pill-nav" role="banner">
    <!-- Top-Left: Logo + Brand Name (Links back to Home) & Language Switcher -->
    <div class="pill-left-group">
      <a href="/" class="pill-brand-link" aria-label="SKL WASTE SDN BHD - Kembali ke Halaman Utama">
        <span class="pill-logo-box">
          <picture>
            <source srcset="/images/logo-skl-waste-sdn-bhd.webp" type="image/webp" />
            <img
              src="/images/skl-logo.png"
              alt="Logo SKL Waste Sdn Bhd"
              width="38"
              height="38"
              class="pill-logo-img"
            />
          </picture>
        </span>
        <span class="pill-brand-name">{companyData.name}</span>
      </a>

      <!-- Language Toggle Button (Default page language: Malay; click to switch to English) -->
      <button
        type="button"
        id="lang-toggle-btn"
        class="pill-lang-btn"
        aria-label="Switch language between Bahasa Melayu and English"
        data-current-lang="ms"
      >
        <svg
          class="lang-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span id="lang-toggle-label">English</span>
      </button>
    </div>

    <!-- Visually Hidden Navigation Links for Search Engine Crawlers & Scrapers -->
    <nav class="crawler-seo-nav" aria-label="Directory Navigation">
      <ul>
        {footerNavigation.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right: Order Tong Roro Button -->
    <div class="pill-right-group">
      <a
        href="https://wa.me/60166159365?text=Hai%20Mr%20Hari%20(SKL%20Waste%20Sdn%20Bhd)%2C%20saya%20ingin%20menempah%20Tong%20Roro."
        class="pill-order-btn"
        data-track-cta="navbar_order_tong_roro"
        data-ms="ORDER TONG RORO"
        data-en="ORDER TONG RORO"
      >
        ORDER TONG RORO
      </a>
    </div>
  </div>
</header>

<style>
  .floating-header-wrapper {
    position: fixed;
    top: 1.15rem;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
    pointer-events: none;
  }

  .floating-pill-nav {
    pointer-events: auto;
    width: min(1140px, 100%);
    min-height: 66px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1.5px solid rgba(10, 22, 40, 0.14);
    border-radius: 9999px;
    padding: 0.5rem 0.85rem 0.5rem 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    box-shadow: 0 12px 34px -6px rgba(10, 22, 40, 0.16), 0 2px 8px rgba(10, 22, 40, 0.06);
  }

  .pill-left-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .pill-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: #0a1628;
    min-width: 0;
  }

  .pill-logo-box {
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: #ffffff;
    border: 1px solid rgba(10, 22, 40, 0.12);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    padding: 3px;
  }

  .pill-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .pill-brand-name {
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: clamp(0.92rem, 1.6vw, 1.15rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #0a1628;
    white-space: nowrap;
  }

  .pill-lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.42rem 0.8rem;
    border-radius: 9999px;
    border: 1px solid rgba(10, 22, 40, 0.18);
    background: #f8fafc;
    color: #0a1628;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.15s ease;
  }

  .pill-lang-btn:hover {
    background: #e2e8f0;
    border-color: #0a1628;
    transform: translateY(-1px);
  }

  .lang-icon {
    flex-shrink: 0;
    color: #15803d;
  }

  /* Visually hidden for humans, stays in HTML DOM for crawlers and scrapers */
  .crawler-seo-nav {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pill-right-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .pill-order-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.35rem;
    border-radius: 9999px;
    background: #0a1628;
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    font-size: clamp(0.78rem, 1.2vw, 0.9rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    text-decoration: none;
    border: 1.5px solid #0a1628;
    white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .pill-order-btn:hover {
    background: #15803d;
    border-color: #15803d;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(21, 128, 61, 0.28);
  }

  @media (max-width: 640px) {
    .floating-header-wrapper {
      top: 0.65rem;
      padding: 0 0.5rem;
    }

    .floating-pill-nav {
      min-height: 56px;
      padding: 0.35rem 0.55rem;
      gap: 0.4rem;
    }

    .pill-logo-box {
      width: 36px;
      height: 36px;
    }

    .pill-brand-name {
      font-size: 0.8rem;
    }

    .pill-lang-btn {
      padding: 0.32rem 0.6rem;
      font-size: 0.72rem;
    }

    .pill-order-btn {
      padding: 0.5rem 0.85rem;
      font-size: 0.72rem;
    }
  }

  @media (max-width: 400px) {
    .pill-brand-name {
      display: none;
    }
  }
</style>
