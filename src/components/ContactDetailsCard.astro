---
import { companyData } from '../data/company';
import { contactData } from '../data/contact';

export interface Props {
  title?: string;
}

const { title = 'Maklumat Perhubungan Rasmi (Official Contact Details)' } = Astro.props;
---

<div class="card contact-details-card reveal-on-scroll">
  {title && (
    <div class="card-header-bar">
      <span class="header-pill">SKL Waste Sdn Bhd</span>
      <h3 class="contact-card-title">{title}</h3>
    </div>
  )}
  
  <div class="contact-entity-info">
    <div class="entity-item">
      <div class="icon-bubble company-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="21" width="18" height="2" rx="1"/>
          <path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/>
          <path d="M9 9h1"/><path d="M9 13h1"/><path d="M9 17h1"/>
          <path d="M14 9h1"/><path d="M14 13h1"/><path d="M14 17h1"/>
        </svg>
      </div>
      <div class="entity-text">
        <span class="label">Syarikat:</span>
        <strong class="value company-name">{companyData.name}</strong>
      </div>
    </div>

    <div class="entity-item">
      <div class="icon-bubble reg-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
        </svg>
      </div>
      <div class="entity-text">
        <span class="label">No. Pendaftaran Syarikat:</span>
        <strong class="value reg-number">{companyData.registrationNumber}</strong>
      </div>
    </div>

    <div class="entity-item">
      <div class="icon-bubble person-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
      </div>
      <div class="entity-text">
        <span class="label">Pegawai Dihubungi (Main Contact Person):</span>
        <strong class="value contact-person">{contactData.mainContactPerson}</strong>
      </div>
    </div>
  </div>

  <div class="contact-divider"></div>

  <div class="contact-methods-grid">
    <div class="method-card">
      <div class="method-icon-wrap" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </div>
      <div class="method-details">
        <span class="method-label">Telefon / Hotline:</span>
        <a href={contactData.telephoneHref} class="method-link phone-link">
          {contactData.telephoneDisplay}
        </a>
        <span class="method-subtext">Panggilan terus kepada Mr Hari</span>
      </div>
    </div>

    <div class="method-card">
      <div class="method-icon-wrap" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
      </div>
      <div class="method-details">
        <span class="method-label">E-mel Rasmi:</span>
        <a href={contactData.emailHref} class="method-link email-link">
          {contactData.email}
        </a>
        <span class="method-subtext">Sebut harga bertulis & pertanyaan</span>
      </div>
    </div>
  </div>

  <div class="whatsapp-wrapper">
    {contactData.whatsapp.isConfirmed ? (
      <a href={contactData.whatsapp.url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary whatsapp-active-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        WhatsApp Mr Hari
      </a>
    ) : (
      <div class="whatsapp-pending-banner">
        <svg class="pending-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <p class="whatsapp-pending-text">
          <strong>WhatsApp:</strong> Pending verification ({contactData.whatsapp.verificationNote})
        </p>
      </div>
    )}
  </div>

  <div class="contact-divider"></div>

  <div class="headquarters-address-box">
    <div class="hq-icon-wrap" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
      </svg>
    </div>
    <div class="hq-content">
      <span class="hq-label">Alamat Ibu Pejabat (Headquarters):</span>
      <address class="address-content">
        {companyData.headquarters.line1}<br />
        {companyData.headquarters.postcode} {companyData.headquarters.city},<br />
        {companyData.headquarters.state}, {companyData.headquarters.country}.
      </address>
      <p class="full-address-single-line text-muted">
        <small>{companyData.headquarters.fullAddress}</small>
      </p>
    </div>
  </div>

  <div class="contact-footer-actions">
    <a href="/#quotation-form" class="btn btn-primary contact-cta-btn">
      <span>Dapatkan Sebut Harga Sewaan Tong Roro</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>
  </div>
</div>

<style>
  .contact-details-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle, #e2e8f0);
    border-radius: var(--radius-lg, 18px);
    padding: clamp(1.25rem, 3vw, 2rem);
    margin: 1.5rem 0;
    box-shadow: var(--shadow-card, 0 4px 20px -2px rgba(10, 22, 40, 0.05));
  }

  .card-header-bar {
    margin-bottom: 1.5rem;
  }

  .header-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-blue, #1d4ed8);
    background: var(--accent-blue-soft, #eff6ff);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full, 9999px);
    margin-bottom: 0.5rem;
  }

  .contact-card-title {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 700;
    color: var(--text-primary, #0a1628);
  }

  .contact-entity-info {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .entity-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .icon-bubble {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md, 10px);
    background: var(--bg-surface-alt, #f1f5f9);
    color: var(--text-primary, #0a1628);
    flex-shrink: 0;
  }

  .entity-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .entity-text .label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-muted, #64748b);
  }

  .entity-text .value {
    font-size: 1.05rem;
    color: var(--text-primary, #0a1628);
    line-height: 1.3;
  }

  .contact-divider {
    height: 1px;
    background: var(--border-subtle, #f1f5f9);
    margin: 1.5rem 0;
  }

  .contact-methods-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .contact-methods-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .method-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: var(--bg-surface, #f8fafc);
    border: 1px solid var(--border-subtle, #e2e8f0);
    border-radius: var(--radius-md, 12px);
    padding: 1rem 1.15rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .method-card:hover {
    border-color: var(--border-hover, #cbd5e1);
    transform: translateY(-2px);
  }

  .method-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md, 10px);
    background: #ffffff;
    color: var(--accent-green, #15803d);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    flex-shrink: 0;
  }

  .method-details {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .method-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-muted, #64748b);
  }

  .method-link {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--accent-blue, #1d4ed8);
    text-decoration: none;
    line-height: 1.3;
    margin: 0.15rem 0;
    word-break: break-all;
  }

  .method-link:hover {
    text-decoration: underline;
  }

  .method-subtext {
    font-size: 0.75rem;
    color: var(--text-muted, #64748b);
  }

  .whatsapp-wrapper {
    margin-top: 1.25rem;
  }

  .whatsapp-active-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .whatsapp-pending-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: #fffbeb;
    border: 1px solid #fef3c7;
    border-left: 4px solid #f59e0b;
    border-radius: var(--radius-md, 10px);
    padding: 0.85rem 1rem;
  }

  .pending-icon {
    flex-shrink: 0;
    color: #d97706;
    margin-top: 0.15rem;
  }

  .whatsapp-pending-text {
    margin: 0;
    font-size: 0.875rem;
    color: #92400e;
    line-height: 1.5;
  }

  .headquarters-address-box {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--bg-surface, #f8fafc);
    border: 1px solid var(--border-subtle, #e2e8f0);
    border-radius: var(--radius-md, 12px);
    padding: 1.15rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  .hq-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md, 10px);
    background: #ffffff;
    color: var(--accent-blue, #1d4ed8);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    flex-shrink: 0;
  }

  .hq-content {
    min-width: 0;
    flex-grow: 1;
  }

  .hq-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-muted, #64748b);
    margin-bottom: 0.35rem;
  }

  .address-content {
    font-style: normal;
    line-height: 1.6;
    color: var(--text-primary, #0a1628);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .full-address-single-line {
    margin: 0;
    color: var(--text-muted, #64748b);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .contact-footer-actions {
    margin-top: 1rem;
  }

  .contact-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md, 12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .method-card {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
