---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { companyData } from '../data/company';
import { contactData } from '../data/contact';
import { getPageSEO, getCanonicalUrl, analyticsConfig, SITE_URL } from '../data/seo';
import { footerNavigation } from '../data/navigation';
import { buildPageSchemaGraph } from '../utils/schema';

export interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  noindex?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  currentPath = '/',
  noindex,
  hideFooter = false
} = Astro.props;

const seo = getPageSEO(currentPath);
const pageTitle = title || seo.title;
const pageDescription = description || seo.description;
const canonicalUrl = getCanonicalUrl(currentPath);
const isNoindex = noindex ?? seo.noindex ?? false;

const schemaGraph = buildPageSchemaGraph(
  currentPath,
  pageTitle,
  pageDescription,
  seo.breadcrumbs
);

// Sitelinks Searchbox & SiteNavigationElement schema for Google organic sitelinks takeover
const sitelinksSearchboxSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website-search`,
  url: SITE_URL,
  name: 'SKL Waste Sdn Bhd',
  alternateName: ['SKL Waste', 'Sewa Tong Roro Selangor', 'Sewa Tong Roro KL'],
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE_URL}/tong-roro-rental?q={search_term_string}`
    },
    'query-input': 'required name=search_term_string'
  }
};

const navSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'SKL Waste Sdn Bhd Quick Sitelinks',
  description: 'Semua navigasi rasmi perkhidmatan Sewa Tong Roro SKL Waste Sdn Bhd',
  itemListElement: [
    {
      '@type': 'SiteNavigationElement',
      position: 1,
      name: 'Tong Roro Rental (Harga 2ft & 4ft)',
      description: 'Spesifikasi saiz Tong Roro 2 Kaki & 4 Kaki tempoh 10 hari bermula RM2XX',
      url: `${SITE_URL}/tong-roro-rental`
    },
    {
      '@type': 'SiteNavigationElement',
      position: 2,
      name: 'Waste Management Services',
      description: 'Kutipan sisa pembinaan, pengubahsuaian rumah, perindustrian & sampah pukal',
      url: `${SITE_URL}/waste-management-services`
    },
    {
      '@type': 'SiteNavigationElement',
      position: 3,
      name: 'Service Areas (Selangor & KL)',
      description: 'Kawasan liputan Sungai Buloh, Kepong, Rawang, Petaling Jaya, Subang & KL',
      url: `${SITE_URL}/service-areas`
    },
    {
      '@type': 'SiteNavigationElement',
      position: 4,
      name: 'Industries We Serve',
      description: 'Pembinaan bangunan, perumahan, hotel, kilang, restoran, kediaman berstrata',
      url: `${SITE_URL}/industries-we-serve`
    },
    {
      '@type': 'SiteNavigationElement',
      position: 5,
      name: 'About SKL Waste Sdn Bhd',
      description: 'Profil syarikat berdaftar SSM 200801038953 beribu pejabat di Sungai Buloh',
      url: `${SITE_URL}/about-us`
    },
    {
      '@type': 'SiteNavigationElement',
      position: 6,
      name: 'Contact Mr Hari / WhatsApp',
      description: 'Hubungi pengurusan Mr Hari +60 16-615 9365 untuk sebut harga segera',
      url: `${SITE_URL}/contact-us`
    }
  ]
};

const normalizedPath = currentPath === '' ? '/' : currentPath.replace(/\/+$/, '') || '/';
const gscVerification = analyticsConfig.googleSiteVerification || (analyticsConfig as Record<string, string>)['gscVerification'];
const ga4Id = analyticsConfig.ga4MeasurementId;
const gtmId = analyticsConfig.gtmId;
const googleAdsId = analyticsConfig.googleAdsId;
---

<!DOCTYPE html>
<html lang="ms-MY">
  <head>
    <!-- Google Tag Manager / Google tag (Immediately after <head>) -->
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-WH7RDN24"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Technical SEO & Maximum Crawler Access Metadata -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={[seo.primaryKeyword, ...(seo.secondaryKeywords || []), 'Sewa Tong Roro Selangor', 'Tong Roro Sungai Buloh', 'SKL Waste Sdn Bhd', 'RoRo Bin Rental Malaysia'].join(', ')} />
    <meta name="author" content="SKL WASTE SDN BHD (200801038953)" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Language Alternates (Malay Default + English + Chinese for Regional Authority) -->
    <link rel="alternate" hreflang="ms-MY" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-MY" href={canonicalUrl} />
    <link rel="alternate" hreflang="zh-MY" href={canonicalUrl} />
    <link rel="alternate" hreflang="zh-Hans" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Zero-Restriction Robot & AI Crawler Directives -->
    <meta
      name="robots"
      content={isNoindex ? 'noindex, follow' : 'index, follow, all, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta
      name="googlebot"
      content={isNoindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta
      name="bingbot"
      content={isNoindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <!-- Local SEO Geographic Metadata (Sungai Buloh, Selangor, Malaysia) -->
    <meta name="geo.region" content="MY-10" />
    <meta name="geo.placename" content="Sungai Buloh, Selangor, Malaysia" />
    <meta name="geo.position" content="3.2105;101.5608" />
    <meta name="ICBM" content="3.2105, 101.5608" />

    <!-- Open Graph Protocol -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://www.tongrorosklwaste.my/images/og-embed-skl-waste.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="SKL Waste Sdn Bhd - Sewa Tong Roro Selangor & Kuala Lumpur" />
    <meta property="og:locale" content="ms_MY" />
    <meta property="og:locale:alternate" content="en_MY" />
    <meta property="og:site_name" content="SKL WASTE SDN BHD" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://www.tongrorosklwaste.my/images/og-embed-skl-waste.jpg" />
    <meta name="twitter:image:alt" content="SKL Waste Sdn Bhd - Sewa Tong Roro Selangor & Kuala Lumpur" />

    <!-- Homepage LCP Preload -->
    {normalizedPath === '/' && (
      <link
        rel="preload"
        as="image"
        href="/images/sewa-tong-roro-sungai-buloh-skl-waste.webp"
        type="image/webp"
        fetchpriority="high"
      />
    )}

    <!-- Google Search Console Verification -->
    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}

    <!-- Schema.org JSON-LD Graph + Sitelinks + SiteNavigationElement -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
    <script type="application/ld+json" set:html={JSON.stringify(sitelinksSearchboxSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(navSchema)} />

    <!-- Google Fonts Preconnect & Stylesheets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Authentic Corporate Favicon -->
    <link rel="icon" type="image/png" href="/images/skl-logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Instant Bot / Human Disambiguation & Guard Script -->
    <script is:inline>
      (function() {
        // Add instant JS ready class for blur-fade animation triggering
        document.documentElement.classList.add('js-ready');

        // Allow verified search engine & AI bot crawlers complete unfiltered access
        // Human visitors landing directly on inner pages are smoothly redirected to the main homepage
        var ua = (navigator.userAgent || '').toLowerCase();
        var isCrawler = /bot|googlebot|bingbot|yandex|baiduspider|duckduckbot|slurp|crawler|spider|mediapartners|adsbot|applebot|facebookexternalhit|whatsapp|telegrambot|twitterbot|pinterest|linkedinbot|petalbot|semrushbot|ahrefsbot|mj12bot|dotbot|rogerbot|screaming frog|gptbot|chatgpt|claudebot|anthropic-ai|perplexitybot|cohere|bytespider/i.test(ua);
        var path = window.location.pathname.replace(/\/+$/, '') || '/';

        // Check if user is human on an inner page and not requesting via sitemap/searchbot preview
        // Exclude system-roro routes from redirection so admin portal functions without interruption
        var isSystemRoro = path.startsWith('/system-roro');
        if (!isCrawler && path !== '/' && path !== '' && path !== '/404' && !isSystemRoro) {
          // Check query override (e.g. ?view=direct or internal link bypass)
          if (!window.location.search.includes('nobounce')) {
            window.location.replace('/?from=' + encodeURIComponent(path));
          }
        }
      })();
    </script>
  </head>
  <body class={normalizedPath === '/' ? 'is-home-page' : 'is-inner-page'}>
    <!-- Google Tag Manager (noscript) -->
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    <!-- Ultra-Smooth Split-Curtain Entrance Animation (Fast Slide Out) -->
    {normalizedPath === '/' && (
      <div id="site-preloader" class="preloader-curtain" aria-hidden="true">
        <!-- Doors on the EXACT same Z-index with ZERO drop shadows -->
        <div class="preloader-door door-left"></div>
        <div class="preloader-door door-right"></div>
        <div class="preloader-center-stage">
          <div class="preloader-logo-wrapper">
            <img src="/images/skl-logo.png" alt="" class="preloader-single-logo" width="130" height="130" />
          </div>
          <div class="preloader-brand-title">SKL WASTE SDN BHD</div>
        </div>
      </div>
    )}

    <!-- Skip Navigation Link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Floating Pill Header -->
    <Header currentPath={currentPath} />

    <!-- Main Content Area -->
    <main id="main-content" class={normalizedPath === '/' ? 'main-home' : 'main-inner'}>
      <slot />
    </main>

    <!-- Footer (Hidden visually on Homepage per clean hero design; kept on inner pages) -->
    {!hideFooter && normalizedPath !== '/' && <Footer />}

    <!-- Client-Side Runtime Script: Language Switcher (MS Default / EN Toggle), Scroll Reveal & Conversion Tracking -->
    <script is:inline>
      (function() {
        // 0. Ultra-Smooth Preloader Splitting Curtain Animation (Snappy & Fast)
        var preloader = document.getElementById('site-preloader');
        if (preloader) {
          // Prevent scroll while curtain is animating
          document.body.classList.add('curtain-locked');

          // Sequence:
          // 1. T = 0ms: Logo visible in center on solid seamless white backdrop.
          // 2. T = 450ms: Logo and title fade out smoothly.
          // 3. T = 550ms: White doors slide left & right ultra-smoothly.
          // 4. T = 1200ms: Completely finished, remove curtain and unlock scroll.
          setTimeout(function() {
            preloader.classList.add('is-fading-logo');
          }, 450);

          setTimeout(function() {
            preloader.classList.add('is-opening');
            document.body.classList.remove('curtain-locked');
          }, 550);

          setTimeout(function() {
            preloader.classList.add('is-done');
          }, 1200);
        }

        // 1. Bilingual Language Toggle (Malay Default, Toggle to English via Navbar button)
        var currentLang = 'ms';
        var langBtn = document.getElementById('lang-toggle-btn');
        var langLabel = document.getElementById('lang-toggle-label');

        function applyLanguage(lang) {
          currentLang = lang === 'en' ? 'en' : 'ms';
          document.documentElement.lang = currentLang === 'en' ? 'en-MY' : 'ms-MY';

          if (langBtn && langLabel) {
            langBtn.setAttribute('data-current-lang', currentLang);
            // When page is in Malay, button shows "English"; when in English, button shows "Bahasa Melayu"
            langLabel.textContent = currentLang === 'ms' ? 'English' : 'Bahasa Melayu';
          }

          document.querySelectorAll('[data-ms][data-en]').forEach(function(el) {
            var targetText = el.getAttribute(currentLang === 'en' ? 'data-en' : 'data-ms');
            if (targetText !== null) {
              el.textContent = targetText;
            }
          });

          document.querySelectorAll('[data-html-ms][data-html-en]').forEach(function(el) {
            var targetHtml = el.getAttribute(currentLang === 'en' ? 'data-html-en' : 'data-html-ms');
            if (targetHtml !== null) {
              el.innerHTML = targetHtml;
            }
          });
        }

        // Default to Malay ('ms') on load
        applyLanguage('ms');

        if (langBtn) {
          langBtn.addEventListener('click', function() {
            var nextLang = currentLang === 'ms' ? 'en' : 'ms';
            applyLanguage(nextLang);
          });
        }

        // 2. IntersectionObserver for progressive scroll reveal
        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.08,
            rootMargin: '0px 0px -30px 0px'
          });

          document.querySelectorAll('.reveal-on-scroll').forEach(function(el) {
            observer.observe(el);
          });
        } else {
          document.querySelectorAll('.reveal-on-scroll').forEach(function(el) {
            el.classList.add('is-visible');
          });
        }

        // 3. Privacy-safe conversion event tracking listener with 400ms dedup guard
        var lastTrackKey = '';
        var lastTrackTs = 0;
        var isTestMode = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';

        function emitTrack(eventName, extra) {
          var now = Date.now();
          var dedupId = (extra && (extra.event_label || extra.cta_id)) ? String(extra.event_label || extra.cta_id) : '';
          var key = eventName + '::' + dedupId;
          if (now - lastTrackTs < 400 && lastTrackKey === key) return;
          lastTrackKey = key;
          lastTrackTs = now;

          var payload = Object.assign({
            event: eventName,
            event_category: 'engagement',
            page_location: window.location.pathname,
            timestamp: new Date().toISOString()
          }, extra || {});

          if (isTestMode) {
            payload.test_mode = true;
          }

          if (window.dataLayer && Array.isArray(window.dataLayer)) {
            window.dataLayer.push(payload);
          }
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, payload);
          }
          try {
            window.dispatchEvent(new CustomEvent('skl:conversion', { detail: payload }));
          } catch (err) {}
        }

        document.addEventListener('click', function(e) {
          var target = e.target;
          if (!target || !(target instanceof Element)) return;

          var telLink = target.closest('a[href^="tel:"]');
          if (telLink) {
            emitTrack('phone_click', { event_label: telLink.getAttribute('href') || '' });
            return;
          }

          var mailtoLink = target.closest('a[href^="mailto:"]');
          if (mailtoLink) {
            emitTrack('email_click', { event_label: 'email_dispatch' });
            return;
          }

          var waLink = target.closest('a[href*="wa.me"]');
          if (waLink) {
            emitTrack('whatsapp_click', { event_label: 'whatsapp_dispatch' });
            return;
          }

          var ctaEl = target.closest('a[data-track-cta], button[data-track-cta], a.btn-primary');
          if (ctaEl) {
            if (ctaEl.matches('a[href^="tel:"], a[href^="mailto:"], a[href*="wa.me"], [data-select-product], button[type="submit"]')) {
              return;
            }
            var ctaAttr = ctaEl.getAttribute('data-track-cta') || '';
            var rawText = (ctaEl.textContent || '').trim().slice(0, 50);
            emitTrack('contact_cta_click', {
              cta_id: ctaAttr || rawText,
              event_label: ctaAttr || rawText
            });
          }
        }, { passive: true });
      })();
    </script>

    <style is:global>
      /* Offset inner pages so fixed floating pill navbar never overlaps top headings */
      body.is-inner-page .main-inner {
        padding-top: 5.5rem;
      }
      body.is-home-page {
        overflow-x: hidden;
      }
      body.curtain-locked {
        overflow: hidden !important;
        height: 100vh !important;
      }

      /* ==========================================================================
         Ultra-Smooth Split Curtain Entrance Animation
         ========================================================================== */
      .preloader-curtain {
        position: fixed;
        inset: 0;
        z-index: 999999;
        pointer-events: all;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .preloader-curtain.is-done {
        display: none !important;
        pointer-events: none !important;
      }

      /* Pure White Doors Sliding Left and Right - Exactly on the same Z plane, ZERO shadow/seams */
      .preloader-door {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 50%;
        background: #ffffff;
        z-index: 10;
        box-shadow: none !important;
        border: none !important;
        outline: none !important;
        transition: transform 0.65s cubic-bezier(0.77, 0, 0.175, 1);
        will-change: transform;
      }

      .door-left {
        left: 0;
      }

      .door-right {
        right: 0;
      }

      /* Slide Out Action with Ultra-Smooth Easing */
      .preloader-curtain.is-opening .door-left {
        transform: translate3d(-100%, 0, 0);
      }

      .preloader-curtain.is-opening .door-right {
        transform: translate3d(100%, 0, 0);
      }

      /* Center Logo & Brand Stage */
      .preloader-center-stage {
        position: relative;
        z-index: 20;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        pointer-events: none;
        transition: opacity 0.28s ease, transform 0.28s ease;
      }

      .preloader-curtain.is-fading-logo .preloader-center-stage {
        opacity: 0;
        transform: scale(0.96);
      }

      .preloader-logo-wrapper {
        position: relative;
        width: 140px;
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Single whole centered logo */
      .preloader-single-logo {
        width: 125px;
        height: 125px;
        object-fit: contain;
        display: block;
        transition: transform 0.3s ease;
      }

      .preloader-brand-title {
        font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        color: #0a1628;
        opacity: 0.95;
      }
    </style>
  </body>
</html>
