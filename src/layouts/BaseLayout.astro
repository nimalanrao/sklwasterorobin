---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { companyData } from '../data/company';
import { contactData } from '../data/contact';
import { getPageSEO, getCanonicalUrl, analyticsConfig, SITE_URL } from '../data/seo';
import { footerNavigation } from '../data/navigation';
import { buildPageSchemaGraph } from '../utils/schema';

export interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  noindex?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  currentPath = '/',
  noindex,
  hideFooter = false
} = Astro.props;

const seo = getPageSEO(currentPath);
const pageTitle = title || seo.title;
const pageDescription = description || seo.description;
const canonicalUrl = getCanonicalUrl(currentPath);
const isNoindex = noindex ?? seo.noindex ?? false;

const schemaGraph = buildPageSchemaGraph(
  currentPath,
  pageTitle,
  pageDescription,
  seo.breadcrumbs
);

// Append SiteNavigationElement schema so search engines & scrapers index all routes
const navSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'SKL Waste Sdn Bhd Site Navigation',
  itemListElement: footerNavigation.map((item, idx) => ({
    '@type': 'SiteNavigationElement',
    position: idx + 1,
    name: item.label,
    url: `${SITE_URL}${item.href === '/' ? '' : item.href}`
  }))
};

const normalizedPath = currentPath === '' ? '/' : currentPath.replace(/\/+$/, '') || '/';
const gscVerification = analyticsConfig.googleSiteVerification || (analyticsConfig as Record<string, string>)['gscVerification'];
const ga4Id = analyticsConfig.ga4MeasurementId;
const gtmId = analyticsConfig.gtmId;
const googleAdsId = analyticsConfig.googleAdsId;
---

<!DOCTYPE html>
<html lang="ms-MY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Technical SEO & Maximum Crawler Access Metadata -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={[seo.primaryKeyword, ...(seo.secondaryKeywords || []), 'Sewa Tong Roro Selangor', 'Tong Roro Sungai Buloh', 'SKL Waste Sdn Bhd', 'RoRo Bin Rental Malaysia'].join(', ')} />
    <meta name="author" content="SKL WASTE SDN BHD (200801038953)" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Language Alternates (Malay Default + English) -->
    <link rel="alternate" hreflang="ms-MY" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-MY" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Zero-Restriction Robot & AI Crawler Directives -->
    <meta
      name="robots"
      content={isNoindex ? 'noindex, follow' : 'index, follow, all, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta
      name="googlebot"
      content={isNoindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta
      name="bingbot"
      content={isNoindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <!-- Local SEO Geographic Metadata (Sungai Buloh, Selangor, Malaysia) -->
    <meta name="geo.region" content="MY-10" />
    <meta name="geo.placename" content="Sungai Buloh, Selangor, Malaysia" />
    <meta name="geo.position" content="3.2105;101.5608" />
    <meta name="ICBM" content="3.2105, 101.5608" />

    <!-- Open Graph Protocol -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://www.sklwaste.com.my/images/sewa-tong-roro-sungai-buloh-skl-waste.webp" />
    <meta property="og:image:alt" content={seo.ogImageAlt || "SKL Waste Sdn Bhd Tong Roro Lori dan Kontena"} />
    <meta property="og:locale" content="ms_MY" />
    <meta property="og:locale:alternate" content="en_MY" />
    <meta property="og:site_name" content="SKL WASTE SDN BHD" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://www.sklwaste.com.my/images/sewa-tong-roro-sungai-buloh-skl-waste.webp" />
    <meta name="twitter:image:alt" content={seo.ogImageAlt || "SKL Waste Sdn Bhd Tong Roro Lori dan Kontena"} />

    <!-- Homepage LCP Preload -->
    {normalizedPath === '/' && (
      <link
        rel="preload"
        as="image"
        href="/images/sewa-tong-roro-sungai-buloh-skl-waste.webp"
        type="image/webp"
        fetchpriority="high"
      />
    )}

    <!-- Google Search Console Verification -->
    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}

    <!-- Google Tag Manager (Conditional) -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
      </script>
    )}

    <!-- Google Analytics 4 & Google Ads (Conditional when GA4 or Google Ads ID present and GTM absent) -->
    {!gtmId && (ga4Id || googleAdsId) && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id || googleAdsId}`}></script>
        <script is:inline define:vars={{ ga4Id, googleAdsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          if (ga4Id) gtag('config', ga4Id);
          if (googleAdsId) gtag('config', googleAdsId);
        </script>
      </>
    )}

    <!-- Schema.org JSON-LD Graph + SiteNavigationElement -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
    <script type="application/ld+json" set:html={JSON.stringify(navSchema)} />

    <!-- Google Fonts Preconnect & Stylesheets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Authentic Corporate Favicon -->
    <link rel="icon" type="image/png" href="/images/skl-logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Instant JS Ready Flag for Zero-Flash Progressive Reveal -->
    <script is:inline>
      document.documentElement.classList.add('js-ready');
    </script>
  </head>
  <body class={normalizedPath === '/' ? 'is-home-page' : 'is-inner-page'}>
    <!-- Skip Navigation Link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Floating Pill Header -->
    <Header currentPath={currentPath} />

    <!-- Main Content Area -->
    <main id="main-content" class={normalizedPath === '/' ? 'main-home' : 'main-inner'}>
      <slot />
    </main>

    <!-- Footer (Hidden visually on Homepage per clean hero design; kept on inner pages) -->
    {!hideFooter && normalizedPath !== '/' && <Footer />}

    <!-- Client-Side Runtime Script: Language Switcher (MS Default / EN Toggle), Scroll Reveal & Conversion Tracking -->
    <script is:inline>
      (function() {
        // 1. Bilingual Language Toggle (Malay Default, Toggle to English via Navbar button)
        var currentLang = 'ms';
        var langBtn = document.getElementById('lang-toggle-btn');
        var langLabel = document.getElementById('lang-toggle-label');

        function applyLanguage(lang) {
          currentLang = lang === 'en' ? 'en' : 'ms';
          document.documentElement.lang = currentLang === 'en' ? 'en-MY' : 'ms-MY';

          if (langBtn && langLabel) {
            langBtn.setAttribute('data-current-lang', currentLang);
            // When page is in Malay, button shows "English"; when in English, button shows "Bahasa Melayu"
            langLabel.textContent = currentLang === 'ms' ? 'English' : 'Bahasa Melayu';
          }

          document.querySelectorAll('[data-ms][data-en]').forEach(function(el) {
            var targetText = el.getAttribute(currentLang === 'en' ? 'data-en' : 'data-ms');
            if (targetText !== null) {
              el.textContent = targetText;
            }
          });

          document.querySelectorAll('[data-html-ms][data-html-en]').forEach(function(el) {
            var targetHtml = el.getAttribute(currentLang === 'en' ? 'data-html-en' : 'data-html-ms');
            if (targetHtml !== null) {
              el.innerHTML = targetHtml;
            }
          });
        }

        // Default to Malay ('ms') on load
        applyLanguage('ms');

        if (langBtn) {
          langBtn.addEventListener('click', function() {
            var nextLang = currentLang === 'ms' ? 'en' : 'ms';
            applyLanguage(nextLang);
          });
        }

        // 2. IntersectionObserver for progressive scroll reveal
        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.08,
            rootMargin: '0px 0px -30px 0px'
          });

          document.querySelectorAll('.reveal-on-scroll').forEach(function(el) {
            observer.observe(el);
          });
        } else {
          document.querySelectorAll('.reveal-on-scroll').forEach(function(el) {
            el.classList.add('is-visible');
          });
        }

        // 3. Privacy-safe conversion event tracking listener with 400ms dedup guard
        var lastTrackKey = '';
        var lastTrackTs = 0;
        var isTestMode = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';

        function emitTrack(eventName, extra) {
          var now = Date.now();
          var dedupId = (extra && (extra.event_label || extra.cta_id)) ? String(extra.event_label || extra.cta_id) : '';
          var key = eventName + '::' + dedupId;
          if (now - lastTrackTs < 400 && lastTrackKey === key) return;
          lastTrackKey = key;
          lastTrackTs = now;

          var payload = Object.assign({
            event: eventName,
            event_category: 'engagement',
            page_location: window.location.pathname,
            timestamp: new Date().toISOString()
          }, extra || {});

          if (isTestMode) {
            payload.test_mode = true;
          }

          if (window.dataLayer && Array.isArray(window.dataLayer)) {
            window.dataLayer.push(payload);
          }
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, payload);
          }
          try {
            window.dispatchEvent(new CustomEvent('skl:conversion', { detail: payload }));
          } catch (err) {}
        }

        document.addEventListener('click', function(e) {
          var target = e.target;
          if (!target || !(target instanceof Element)) return;

          var telLink = target.closest('a[href^="tel:"]');
          if (telLink) {
            emitTrack('phone_click', { event_label: telLink.getAttribute('href') || '' });
            return;
          }

          var mailtoLink = target.closest('a[href^="mailto:"]');
          if (mailtoLink) {
            emitTrack('email_click', { event_label: 'email_dispatch' });
            return;
          }

          var waLink = target.closest('a[href*="wa.me"]');
          if (waLink) {
            emitTrack('whatsapp_click', { event_label: 'whatsapp_dispatch' });
            return;
          }

          var ctaEl = target.closest('a[data-track-cta], button[data-track-cta], a.btn-primary');
          if (ctaEl) {
            if (ctaEl.matches('a[href^="tel:"], a[href^="mailto:"], a[href*="wa.me"], [data-select-product], button[type="submit"]')) {
              return;
            }
            var ctaAttr = ctaEl.getAttribute('data-track-cta') || '';
            var rawText = (ctaEl.textContent || '').trim().slice(0, 50);
            emitTrack('contact_cta_click', {
              cta_id: ctaAttr || rawText,
              event_label: ctaAttr || rawText
            });
          }
        }, { passive: true });
      })();
    </script>

    <style is:global>
      /* Offset inner pages so fixed floating pill navbar never overlaps top headings */
      body.is-inner-page .main-inner {
        padding-top: 5.5rem;
      }
      body.is-home-page {
        overflow-x: hidden;
      }
    </style>
  </body>
</html>
